<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SCLogMate</AssemblyName>
    <Product>SCLogMate</Product>
    <Title>SCLogMate</Title>
    <Description>SCLogMate – Star Citizen Live Log Companion &amp; Analytics</Description>
    <Version>1.0.0-rc2</Version>
    <Authors>gOOvER</Authors>
    <RepositoryUrl>https://github.com/gOOvER/SCLogMate</RepositoryUrl>
    <ApplicationIcon>SCLogMate.ico</ApplicationIcon>
    <!-- Single-File Publishing (alles in einer einzigen kompakten .exe) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="SCLogMate.ico" />
    <EmbeddedResource Include="Data\blueprints.json" />
    <EmbeddedResource Include="Data\seed_data.json" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Transitive vulnerability override for Avalonia.Desktop -> Avalonia.FreeDesktop (GHSA-xrw6-gwf8-vvr9) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <!-- Clean any leftover wwwroot directory from publish output to maintain pure single-file exe -->
  <Target Name="CleanPublishWwwroot" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)wwwroot" />
  </Target>

</Project>
