<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SCLogMate.ViewModels"
        xmlns:m="using:SCLogMate.Models"
        xmlns:core="using:SCLogMate.Core"
        xmlns:conv="using:SCLogMate.Converters"
        xmlns:views="using:SCLogMate.Views"
        x:Class="SCLogMate.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1400" Height="780"
        MinWidth="1050" MinHeight="520"
        Background="#050811"
        FontFamily="{Binding CurrentFontFamily}"
        Icon="/SCLogMate.ico"
        Title="SCLogMate">

  <Window.Resources>
    <conv:AmountToBrushConverter x:Key="AmountBrush" />
    <conv:KindToBrushConverter x:Key="KindBrush" />
    <conv:FilterActiveConverter x:Key="FilterBg" />
    <conv:FilterActiveBorderConverter x:Key="FilterBorder" />
    <conv:FilterActiveForegroundConverter x:Key="FilterFg" />
    <conv:SegmentActiveBgConverter x:Key="SegmentBg" />
    <conv:SegmentActiveBorderConverter x:Key="SegmentBorder" />
    <conv:BoolToActiveBrushConverter x:Key="ActiveBrush" />
    <conv:BoolToGreenRedBrushConverter x:Key="GreenRedBrush" />
    <conv:BoolToGreenRedBgConverter x:Key="GreenRedBg" />
    <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    <conv:BoolToAccentBrushConverter x:Key="AccentBg" />
    <conv:BoolToAccentBorderConverter x:Key="AccentBorder" />
  </Window.Resources>

  <Grid>
  <DockPanel Margin="14">

    <!-- ══ Sci-Fi Header Bar: Branding + Status Pills ══ -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      
      <!-- Brand & Version -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="#0A1E33" BorderBrush="#1C4B78" BorderThickness="1" CornerRadius="6" Width="28" Height="28" VerticalAlignment="Center">
          <TextBlock Text="❖" Foreground="#38BDF8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
          <TextBlock Text="SC" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold" />
          <TextBlock Text="LOG" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" />
          <TextBlock Text="MATE" Foreground="#FFB23E" FontSize="16" FontWeight="Bold" />
        </StackPanel>
        <Button Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1" CornerRadius="4" Padding="6,2"
                VerticalAlignment="Center" Cursor="Hand" Margin="6,0,0,0"
                Command="{Binding OpenChangelogCommand}" ToolTip.Tip="Changelog &amp; Releases">
          <TextBlock Text="{Binding VersionText}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
        </Button>
        <!-- Debug-Modus Badge (nur sichtbar wenn DebugMode aktiv) -->
        <Border Background="#2E1B05" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="6,2"
                VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding IsDebugModeActive}"
                ToolTip.Tip="Entwickler- &amp; Debug-Modus aktiv (per Build oder settings.json)">
          <TextBlock Text="🧪 DEBUG" Foreground="#F59E0B" FontSize="10" FontWeight="Bold" />
        </Border>
      </StackPanel>

      <!-- Rechts: Globale Sprache, Star Citizen Status, Mini-HUD & Update-Button -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Globaler Sprach-Umschalter mit echten Vektor-Flaggen -->
        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguageOption}"
                  Height="30" Padding="6,2" CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1"
                  FontSize="11" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding I18n[Header_Language_Tooltip]}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <!-- 🌐 Auto Icon -->
                <TextBlock Text="🌐" FontSize="11" IsVisible="{Binding IsAuto}" VerticalAlignment="Center" />

                <!-- 🇩🇪 Echte Deutsche Flagge (Schwarz - Rot - Gold) -->
                <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" IsVisible="{Binding IsGerman}" VerticalAlignment="Center"
                        BorderBrush="#30363D" BorderThickness="0.5">
                  <Grid RowDefinitions="*,*,*">
                    <Rectangle Grid.Row="0" Fill="#151515" />
                    <Rectangle Grid.Row="1" Fill="#DD0000" />
                    <Rectangle Grid.Row="2" Fill="#FFCE00" />
                  </Grid>
                </Border>

                <!-- 🇬🇧 Echte Britische Flagge (Union Jack) -->
                <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#00247D" IsVisible="{Binding IsEnglish}" VerticalAlignment="Center"
                        BorderBrush="#30363D" BorderThickness="0.5">
                  <Canvas Width="16" Height="11">
                    <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#FFFFFF" StrokeThickness="2.2" />
                    <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#CF142B" StrokeThickness="1.0" />
                    <Rectangle Canvas.Left="6.5" Canvas.Top="0" Width="3" Height="11" Fill="#FFFFFF" />
                    <Rectangle Canvas.Left="0" Canvas.Top="4" Width="16" Height="3" Fill="#FFFFFF" />
                    <Rectangle Canvas.Left="7.2" Canvas.Top="0" Width="1.6" Height="11" Fill="#CF142B" />
                    <Rectangle Canvas.Left="0" Canvas.Top="4.7" Width="16" Height="1.6" Fill="#CF142B" />
                  </Canvas>
                </Border>

                <!-- Text -->
                <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Star Citizen Prozess-Status Badge -->
        <Border Background="#091422" BorderBrush="{Binding GameStatusColor}" BorderThickness="1"
                CornerRadius="6" Height="30" Padding="8,0" ToolTip.Tip="{Binding GameStatusTooltip}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{Binding GameStatusColor}" />
            <TextBlock Text="{Binding GameStatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding GameStatusColor}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Classes="ghost" Height="30" Padding="8,0" CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1"
                Command="{Binding ToggleOverlayCommand}" ToolTip.Tip="Frei verschiebbares In-Game Mini-HUD Overlay ein-/ausblenden">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="🖥" FontSize="11" Foreground="#38BDF8" />
            <TextBlock Text="{Binding I18n[Header_MiniHud]}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" />
          </StackPanel>
        </Button>

        <Button Classes="ghost" Height="30" Padding="8,0" CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1"
                Command="{Binding ToggleRsOverlayCommand}" ToolTip.Tip="Frei verschiebbares RS Signal Decoder HUD Overlay ein-/ausblenden">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="🛰" FontSize="11" Foreground="#F59E0B" />
            <TextBlock Text="{Binding I18n[Header_RsOverlay]}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" />
          </StackPanel>
        </Button>

        <Button Classes="accent" Height="30" VerticalAlignment="Center"
                Background="#238636" IsVisible="{Binding UpdateAvailable}"
                Command="{Binding OpenUpdateModalCommand}" Content="{Binding UpdateText}"
                ToolTip.Tip="Update-Details ansehen und installieren" />
      </StackPanel>
    </Grid>

    <!-- ══ Auto-Scan / Datenbank-Indexierung Live-Status & Fortschrittsbalken ══ -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,10"
            Background="#0B192C" BorderBrush="#0284C7" BorderThickness="1.5"
            CornerRadius="8" Padding="14,9"
            BoxShadow="0 4 16 #80000000"
            IsVisible="{Binding IsDatabaseBusy}">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="⚡" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DatabaseStatusMessage}" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="{Binding DatabaseProgressPercent, StringFormat='{}{0:N0}%'}"
                   FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />

        <!-- Animierter Fortschrittsbalken -->
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="6" Margin="0,7,0,0"
                     Minimum="0" Maximum="100"
                     Value="{Binding DatabaseProgressPercent}"
                     Foreground="#38BDF8" Background="#1E293B" CornerRadius="3" />
      </Grid>
    </Border>

    <!-- ══ Session-Auswahl Bar (mobiGlas Strip) ══ -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
        <TextBlock Text="⚡" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
        <TextBlock Text="{Binding I18n[Header_Session]}" Foreground="#7E97AD" FontWeight="Bold" FontSize="11" LetterSpacing="0.5" VerticalAlignment="Center" />
      </StackPanel>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Height="32"
                Background="#08101C" BorderBrush="#1A3047"
                ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" />
      <Border Grid.Column="2" Background="#08101C" BorderBrush="#1A3047" BorderThickness="1"
              CornerRadius="6" Padding="10,4" Margin="10,0,0,0">
        <TextBlock Text="{Binding SessionSpanText}" Foreground="#38BDF8"
                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <!-- ══ Dashboard: 2 übersichtliche Star Citizen HUD Zeilen (Collapsible für Starmap-Vollbild) ══ -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding ShowDashboardCards}">
      
      <!-- Zeile 1: Server, Standort & Schiff (3 Karten, jede hat viel Platz) -->
      <Grid ColumnDefinitions="*,*,*">
        <!-- Karte 1: PILOT & SERVER (mit echter Flagge, Shard-Nummer & SC-Version) -->
        <Border Grid.Column="0" Classes="card" Margin="0,0,4,0" Padding="12,10"
                ToolTip.Tip="{Binding ServerTooltipText}">
          <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header: Label + Region-Badge mit echter Flagge -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding I18n[Dash_Pilot_Server]}" VerticalAlignment="Center" />
              
              <!-- Badge mit Flagge & Kanal -->
              <Border Grid.Column="1" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" CornerRadius="4" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  
                  <!-- EU Flagge -->
                  <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#003399" IsVisible="{Binding IsRegionEu}" VerticalAlignment="Center">
                    <Canvas Width="16" Height="11">
                      <Ellipse Canvas.Left="7.1" Canvas.Top="1" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="10.5" Canvas.Top="2.2" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="12" Canvas.Top="4.6" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="10.5" Canvas.Top="7" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="7.1" Canvas.Top="8.2" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="3.7" Canvas.Top="7" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="2.2" Canvas.Top="4.6" Width="1.8" Height="1.8" Fill="#FFCC00" />
                      <Ellipse Canvas.Left="3.7" Canvas.Top="2.2" Width="1.8" Height="1.8" Fill="#FFCC00" />
                    </Canvas>
                  </Border>

                  <!-- US Flagge -->
                  <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#B22234" IsVisible="{Binding IsRegionUs}" VerticalAlignment="Center">
                    <Canvas Width="16" Height="11">
                      <Rectangle Canvas.Left="0" Canvas.Top="1.8" Width="16" Height="1.8" Fill="#FFFFFF" />
                      <Rectangle Canvas.Left="0" Canvas.Top="5.4" Width="16" Height="1.8" Fill="#FFFFFF" />
                      <Rectangle Canvas.Left="0" Canvas.Top="9" Width="16" Height="1.8" Fill="#FFFFFF" />
                      <Rectangle Canvas.Left="0" Canvas.Top="0" Width="7" Height="6" Fill="#3C3B6E" />
                    </Canvas>
                  </Border>

                  <!-- AUS Flagge -->
                  <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#00008B" IsVisible="{Binding IsRegionAus}" VerticalAlignment="Center">
                    <Canvas Width="16" Height="11">
                      <Rectangle Canvas.Left="0" Canvas.Top="0" Width="7" Height="5.5" Fill="#00247D" />
                      <Path Data="M 0,0 L 7,5.5 M 7,0 L 0,5.5" Stroke="#FFFFFF" StrokeThickness="0.8" />
                      <Rectangle Canvas.Left="2.5" Canvas.Top="0" Width="1.8" Height="5.5" Fill="#FFFFFF" />
                      <Rectangle Canvas.Left="0" Canvas.Top="2" Width="7" Height="1.8" Fill="#FFFFFF" />
                    </Canvas>
                  </Border>

                  <!-- Global / Sonstige -->
                  <TextBlock Text="🌐" FontSize="10" IsVisible="{Binding IsRegionOther}" VerticalAlignment="Center" />

                  <!-- Text: EU · LIVE -->
                  <TextBlock Text="{Binding ServerBadgeText}" FontSize="10" Foreground="#FFB23E" FontWeight="Bold" VerticalAlignment="Center" />

                  <!-- Trenner -->
                  <TextBlock Text="·" Foreground="#3A536B" FontSize="10" VerticalAlignment="Center" />

                  <!-- Ping Latenz -->
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="📶" FontSize="9" VerticalAlignment="Center" Foreground="{Binding ServerPingColor}" />
                    <TextBlock Text="{Binding ServerPingText}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding ServerPingColor}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Hauptwert: Spieler / Account Name -->
            <TextBlock Grid.Row="1" Classes="value" Text="{Binding ServerMainText}" FontSize="15" FontWeight="Bold"
                       Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding ServerTooltipText}" />

            <!-- Subline: SC Version · Shard Nummer -->
            <TextBlock Grid.Row="2" Text="{Binding ServerSublineText}" Foreground="#7E97AD" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding ServerTooltipText}" />
          </Grid>
        </Border>

        <!-- Karte 2: STANDORT & JURISDIKTION -->
        <Border Grid.Column="1" Classes="card" Margin="2,0,2,0" Padding="12,10"
                ToolTip.Tip="{Binding ResolvedLocation.FullBreadcrumb}">
          <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header: Label + System Badge + Armistice Status + Starmap Button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{Binding I18n[Dash_Location]}" VerticalAlignment="Center" />
                
                <!-- System Pill (STANTON / PYRO / NYX) -->
                <Border Background="#060C16" BorderBrush="{Binding LocationBadgeColor}" BorderThickness="1"
                        CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LocationSystemBadge}" Foreground="{Binding LocationBadgeColor}" FontSize="9.5" FontWeight="Bold" />
                </Border>
              </StackPanel>

              <!-- Dynamic Armistice Pill (Schutzzone / Waffen aktiv) -->
              <Border Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Background="{Binding LocationArmisticePillBg}" BorderBrush="{Binding LocationArmisticePillBorder}"
                      BorderThickness="1" CornerRadius="4" Padding="5,1"
                      IsVisible="{Binding LocationIsKnown}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Ellipse Width="5" Height="5" Fill="{Binding LocationArmisticePillColor}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding LocationArmisticePillText}" Foreground="{Binding LocationArmisticePillColor}" FontSize="9.5" FontWeight="SemiBold" />
                </StackPanel>
              </Border>

              <!-- Schnell-Link zur Sternenkarte -->
              <Button Grid.Column="3" Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                      Command="{Binding OpenStarmapForCurrentLocationCommand}" ToolTip.Tip="🗺 Auf der Sternenkarte anzeigen">
                <TextBlock Text="🗺 Karte" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
              </Button>
            </Grid>

            <!-- Großer Standort-Name + Typ Badge -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Classes="value" Text="{Binding LocationMainText}" FontSize="14" FontWeight="Bold"
                         Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LocationMainText}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#0D1624" BorderBrush="#1C324A" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding LocationIsKnown}">
                <TextBlock Text="{Binding LocationTypeBadge}" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" />
              </Border>
            </Grid>

            <!-- Status-Subline: Breadcrumb & Rechtsgebiet -->
            <TextBlock Grid.Row="2" Text="{Binding LocationStatusSubline}" Foreground="#7E97AD" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding ResolvedLocation.FullBreadcrumb}" />
          </Grid>
        </Border>

        <!-- Karte 3: SCHIFF & FLOTTE -->
        <Border Grid.Column="2" Classes="card" Margin="4,0,0,0" Padding="12,10">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding I18n[Dash_Ship_Fleet]}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" Margin="0,0,4,0"
                      Command="{Binding SwitchToFleetTabCommand}" ToolTip.Tip="🛸 Flottenübersicht &amp; Hangar öffnen">
                <TextBlock Text="🛸 Flotte" FontSize="10" Foreground="#58A6FF" FontWeight="Bold" />
              </Button>
              <Button Grid.Column="2" Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                      Command="{Binding ShowShipWikiCommand}" ToolTip.Tip="📖 Star Citizen Wiki Datenblatt öffnen">
                <TextBlock Text="📖 Wiki" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
              </Button>
            </Grid>
            <TextBlock Grid.Row="1" Classes="value" Text="{Binding CurrentShip}" FontSize="14" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding CurrentShip}" />
            <TextBlock Grid.Row="2" Text="{Binding CurrentShipFlightInfo}" Foreground="#7E97AD" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding ShipsSeenText}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Zeile 2: Kontostand & Auftragsmanager (2 breite Karten, jede hat ~600px Platz) -->
      <Grid ColumnDefinitions="*,*">
        <!-- Karte 4: KONTOSTAND -->
        <Border Grid.Column="0" Classes="card" Margin="0,0,4,0" Padding="14,10">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding I18n[Dash_Account]}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <!-- Auto-Sync Toggle -->
                <Button Classes="ghost" Padding="6,2" CornerRadius="4"
                        Background="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBg}}"
                        BorderBrush="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBrush}}"
                        BorderThickness="1"
                        Command="{Binding ToggleAutoOcrCommand}"
                        ToolTip.Tip="⚡ Auto-Sync mobiGlas Kontostand">
                  <TextBlock Text="{Binding I18n[Dash_Auto_Sync]}" FontSize="10" FontWeight="Bold" Foreground="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBrush}}" />
                </Button>
                <!-- Bereich -->
                <Button Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                        Command="{Binding SelectWalletRegionCommand}" ToolTip.Tip="⊕ Kontostand-Bereich kalibrieren">
                  <TextBlock Text="{Binding I18n[Dash_Calibrate_Region]}" FontSize="10" Foreground="#7E97AD" />
                </Button>
                <!-- Scan -->
                <Button Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1C4B78" BorderThickness="1"
                        Command="{Binding TriggerOcrCommand}" ToolTip.Tip="▶ Test-Scan starten">
                  <TextBlock Text="{Binding I18n[Dash_Scan]}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- Haupt-Betrag & Status -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="{Binding LiveBalanceText}" Foreground="#F0F6FC" FontSize="18" FontWeight="Bold"
                         FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding OcrStatusText}" Foreground="#7E97AD" FontSize="11"
                         VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Subline: Einnahmen · Ausgaben · Netto -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <!-- Einnahmen Pill -->
              <Border Background="#092212" BorderBrush="#1C5E35" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip.Tip="Sitzungs-Einnahmen">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Foreground="#4ADE80" FontSize="10.5" Text="{Binding I18n[Dash_Income]}" VerticalAlignment="Center" />
                  <TextBlock Foreground="#4ADE80" FontSize="10.5" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas, monospace" Text="{Binding SessionIncomeText}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Ausgaben Pill -->
              <Border Background="#260F11" BorderBrush="#5E1C1C" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip.Tip="Sitzungs-Ausgaben">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Foreground="#F87171" FontSize="10.5" Text="{Binding I18n[Dash_Spend]}" VerticalAlignment="Center" />
                  <TextBlock Foreground="#F87171" FontSize="10.5" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas, monospace" Text="{Binding SessionSpendText}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Saldo / Netto Pill -->
              <Border Background="#0C1929" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip.Tip="Sitzungs-Bilanz (Netto)">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Foreground="#94A3B8" FontSize="10.5" Text="{Binding I18n[Dash_Net]}" VerticalAlignment="Center" />
                  <TextBlock Foreground="{Binding SessionNetSign, Converter={StaticResource AmountBrush}}" FontSize="10.5" FontWeight="Bold"
                             FontFamily="Cascadia Code, Consolas, monospace" Text="{Binding SessionNetText}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Karte 5: AUFTRAGSMANAGER -->
        <Border Grid.Column="1" Classes="card" Margin="4,0,0,0" Padding="14,10">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="{Binding I18n[Dash_Contracts]}" VerticalAlignment="Center" />
                <Border Background="#060C16" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveContractsCountText}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Padding="6,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                      Command="{Binding ClearContractsCommand}" ToolTip.Tip="✕ Auftragsliste leeren">
                <TextBlock Text="✕ Leeren" FontSize="10" Foreground="#7E97AD" />
              </Button>
            </Grid>

            <!-- Aktiver Auftrag Name -->
            <TextBlock Grid.Row="1" Classes="value" Text="{Binding ActiveContractTitle}" FontSize="14" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding ActiveContractTitle}" />

            <!-- Belohnung / Status -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="{Binding ActiveContractRewardText}" Foreground="#38BDF8" FontSize="11"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveContractOrg}" />
              <TextBlock Grid.Column="1" Text="{Binding ContractStatusText}" Foreground="#7E97AD" FontSize="10"
                         VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

    </StackPanel>

    <!-- Haupt-Tabs -->
    <TabControl Padding="0" SelectedIndex="{Binding SelectedTabIndex}">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="Padding" Value="8,5,8,5" />
          <Setter Property="MinHeight" Value="32" />
        </Style>
      </TabControl.Styles>
      <TabItem Header="{Binding I18n[Tab_Events]}">
    <DockPanel Margin="0,8,0,0">

    <!-- Filter-Chips & Volltext-Suche -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="chip" Content="{Binding I18n[Filter_All]}" Command="{Binding SetFilterCommand}" CommandParameter="Alle"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Money]}" Command="{Binding SetFilterCommand}" CommandParameter="Geld"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Geld}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Contracts]}" Command="{Binding SetFilterCommand}" CommandParameter="Aufträge"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Aufträge}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Blueprints]}" Command="{Binding SetFilterCommand}" CommandParameter="Baupläne"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Baupläne}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Ships]}" Command="{Binding SetFilterCommand}" CommandParameter="Schiffe"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Schiffe}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Locations]}" Command="{Binding SetFilterCommand}" CommandParameter="Orte"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Orte}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Crew]}" Command="{Binding SetFilterCommand}" CommandParameter="Crew"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Crew}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Loot]}" Command="{Binding SetFilterCommand}" CommandParameter="Loot"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Loot}" />
          <Button Classes="chip" Content="{Binding I18n[Filter_Misc]}" Command="{Binding SetFilterCommand}" CommandParameter="Sonst"
                  Background="{Binding ActiveFilter, Converter={StaticResource FilterBg}, ConverterParameter=Sonst}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Schnellsuche mit Live-Tail Indicator & Inspector Toggle -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="#061810" BorderBrush="#1C5E35" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center"
                ToolTip.Tip="Echtzeit-Log-Überwachung ist aktiv (Tailer)">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="#4ADE80" VerticalAlignment="Center" />
            <TextBlock Text="LIVE TAIL" FontSize="9.5" FontWeight="Bold" Foreground="#4ADE80" LetterSpacing="0.5" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Panel Width="200" Height="28" VerticalAlignment="Center">
          <TextBox Classes="search" Text="{Binding EventSearchText}" Watermark="{Binding I18n[Filter_Search_Watermark]}" VerticalAlignment="Center" Height="28" />
          <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
          <Button Classes="ghost" Padding="4,1" Margin="0,0,4,0" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Command="{Binding ClearEventSearchCommand}" IsVisible="{Binding EventSearchText.Length}"
                  Content="✕" FontSize="10" Foreground="#7E97AD" />
        </Panel>
      </StackPanel>
    </Grid>

    <!-- Ereignisse Tabelle (Volle Breite) -->
    <Border Classes="card" Padding="0">
      <DataGrid ItemsSource="{Binding EventsView}" IsReadOnly="True"
                SelectedItem="{Binding SelectedEntry}" DoubleTapped="OnGridDoubleTapped"
                CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="📖  Star Citizen Wiki Info" Command="{Binding LookupWikiForEntryCommand}" CommandParameter="{Binding SelectedEntry}" />
            <MenuItem Header="🔎  Web-Suche / UEX" Command="{Binding LookupCommand}" />
            <Separator />
            <MenuItem Header="📋  Text / Detail kopieren" Command="{Binding CopyEntryDetailCommand}" CommandParameter="{Binding SelectedEntry}" />
            <MenuItem Header="💰  Betrag kopieren" Command="{Binding CopyEntryAmountCommand}" CommandParameter="{Binding SelectedEntry}" />
            <MenuItem Header="📄  Gesamte Zeile kopieren" Command="{Binding CopyEntryLineCommand}" CommandParameter="{Binding SelectedEntry}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="ZEIT" Width="165" SortMemberPath="Time">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:LogEntry">
                <TextBlock Text="{Binding TimeText}" Margin="8,0,4,0" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#7E97AD" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="TYP" Width="120" SortMemberPath="KindText">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:LogEntry">
                <Border Background="{Binding KindBadgeBg}" CornerRadius="4" Padding="6,2" Margin="4,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Icon}" FontSize="10" Foreground="{Binding KindBadgeFg}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KindText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding KindBadgeFg}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="BETRAG" Width="110" SortMemberPath="Amount">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:LogEntry">
                <TextBlock Text="{Binding AmountText}" Margin="4,0,8,0" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace" FontWeight="Bold"
                           Foreground="{Binding Amount, Converter={StaticResource AmountBrush}}" HorizontalAlignment="Right" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="SCHIFF" Width="130" SortMemberPath="Ship">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:LogEntry">
                <TextBlock Text="{Binding Ship}" Margin="4,0,4,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="#38BDF8" FontWeight="SemiBold" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="DETAIL" Width="*" SortMemberPath="Detail">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:LogEntry">
                <TextBlock Text="{Binding Detail}" Margin="2,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{Binding StatusBrush}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    </DockPanel>
    </TabItem>

    <TabItem Header="{Binding I18n[Tab_Finances]}">
      <TabControl Padding="0" SelectedIndex="{Binding FinanceSubTabIndex}">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="Padding" Value="9,4,9,4" />
            <Setter Property="FontSize" Value="11.5" />
          </Style>
        </TabControl.Styles>

        <!-- SubTab 0: Übersicht -->
        <TabItem Header="{Binding I18n[SubTab_Overview]}">
          <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

          <!-- Hinweis: nicht geloggte Auftragsbelohnungen -->
          <Border Background="#1F3A2A14" BorderBrush="#FBBF24" BorderThickness="1"
                  CornerRadius="8" Padding="12,9" IsVisible="{Binding HasMissions}">
            <TextBlock Text="{Binding MissionsText}" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" />
          </Border>

          <!-- ══ 1. Top KPI Summary HUD Cards ══ -->
          <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,4">
            <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding I18n[Finance_Kpi_Income]}" />
                <TextBlock Classes="value" Text="{Binding FinanceIncomeTotalText}" Foreground="#4ADE80" />
                <TextBlock Text="↗ Einnahmen" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="5,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding I18n[Finance_Kpi_Spend]}" />
                <TextBlock Classes="value" Text="{Binding FinanceSpendTotalText}" Foreground="#F87171" />
                <TextBlock Text="↘ Ausgaben" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="5,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding I18n[Finance_Kpi_Net]}" />
                <TextBlock Classes="value" Text="{Binding FinanceNetBalanceText}"
                           Foreground="{Binding FinanceNetSign, Converter={StaticResource AmountBrush}}" />
                <TextBlock Text="{Binding ProfitMarginText, StringFormat='Marge: {0}'}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Margin="5,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding I18n[Finance_Kpi_Wallet]}" />
                <TextBlock Classes="value" Text="{Binding LiveBalanceText}" Foreground="#38BDF8" />
                <TextBlock Text="Live Saldo (mobiGlas)" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Margin="5,0,0,0">
              <StackPanel>
                <TextBlock Classes="label" Text="{Binding I18n[Finance_Kpi_TradeVolume]}" />
                <TextBlock Classes="value" Text="{Binding TotalCargoAuecText}" Foreground="#FBBF24" />
                <TextBlock Text="{Binding TotalCargoScuText}" Foreground="#F59E0B" FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- ══ 2. Interaktives Sci-Fi Vektor-Diagramm (QuantumWake-Stil) ══ -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <!-- Chart Header & Controls -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#0C233C" BorderBrush="#1C4B78" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                      <TextBlock Text="❖ QUANTUM TIMELINE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>
                    <TextBlock Classes="label" Text="{Binding I18n[Finance_Chart_Title]}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding I18n[Finance_Chart_Subtitle]}" Foreground="#8B949E" FontSize="11" />
                </StackPanel>

                <!-- Chart Controls: Scope + Mode + Filter Toggles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <!-- Scope Buttons (Alle Sessions vs Aktuelle Session) -->
                  <Button Classes="chip" Height="28" Padding="10,3"
                          Command="{Binding SetFinanceScopeCommand}" CommandParameter="0"
                          Background="{Binding IsFinanceScopeAll, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsFinanceScopeAll, Converter={StaticResource AccentBorder}}"
                          ToolTip.Tip="Gesamter Finanzverlauf über alle Sessions">
                    <TextBlock Text="{Binding I18n[Finance_Scope_All]}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding IsFinanceScopeAll, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                  <Button Classes="chip" Height="28" Padding="10,3"
                          Command="{Binding SetFinanceScopeCommand}" CommandParameter="1"
                          Background="{Binding IsFinanceScopeCurrent, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsFinanceScopeCurrent, Converter={StaticResource AccentBorder}}"
                          ToolTip.Tip="Nur Buchungen der aktuellen Einzelsession">
                    <TextBlock Text="{Binding I18n[Finance_Scope_Current]}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding IsFinanceScopeCurrent, Converter={StaticResource ActiveBrush}}" />
                  </Button>

                  <Button Classes="ghost" Height="28" Padding="8,3" CornerRadius="5"
                          Command="{Binding CopyFinanceDiscordSummaryCommand}"
                          ToolTip.Tip="Finanzbericht für Discord in die Zwischenablage kopieren">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="📸" FontSize="11" />
                      <TextBlock Text="Discord Copy" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>

                  <Rectangle Width="1" Height="16" Fill="#1E324A" Margin="4,0" VerticalAlignment="Center" />

                  <!-- Mode Buttons -->
                  <Button Classes="chip" Height="28" Padding="10,3"
                          Command="{Binding SetFinanceChartModeCommand}" CommandParameter="0"
                          Background="{Binding IsChartModeCumulative, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartModeCumulative, Converter={StaticResource AccentBorder}}">
                    <TextBlock Text="{Binding I18n[Finance_Mode_Cumulative]}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding IsChartModeCumulative, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                  <Button Classes="chip" Height="28" Padding="10,3"
                          Command="{Binding SetFinanceChartModeCommand}" CommandParameter="1"
                          Background="{Binding IsChartModeNetTrend, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartModeNetTrend, Converter={StaticResource AccentBorder}}">
                    <TextBlock Text="{Binding I18n[Finance_Mode_NetTrend]}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding IsChartModeNetTrend, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                  <Button Classes="chip" Height="28" Padding="10,3"
                          Command="{Binding SetFinanceChartModeCommand}" CommandParameter="2"
                          Background="{Binding IsChartModeCashflow, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartModeCashflow, Converter={StaticResource AccentBorder}}">
                    <TextBlock Text="{Binding I18n[Finance_Mode_Cashflow]}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding IsChartModeCashflow, Converter={StaticResource ActiveBrush}}" />
                  </Button>

                  <Rectangle Width="1" Height="16" Fill="#1E324A" Margin="4,0" VerticalAlignment="Center" />

                  <!-- Filter Buttons -->
                  <Button Classes="chip" Height="28" Padding="8,3"
                          Command="{Binding SetFinanceChartFilterCommand}" CommandParameter="0"
                          Background="{Binding IsChartFilterAll, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartFilterAll, Converter={StaticResource AccentBorder}}"
                          ToolTip.Tip="{Binding I18n[Finance_Filter_All]}">
                    <TextBlock Text="{Binding I18n[Finance_Filter_All]}" FontSize="11"
                               Foreground="{Binding IsChartFilterAll, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                  <Button Classes="chip" Height="28" Padding="8,3"
                          Command="{Binding SetFinanceChartFilterCommand}" CommandParameter="1"
                          Background="{Binding IsChartFilterTrade, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartFilterTrade, Converter={StaticResource AccentBorder}}"
                          ToolTip.Tip="{Binding I18n[Finance_Filter_Trade]}">
                    <TextBlock Text="{Binding I18n[Finance_Filter_Trade]}" FontSize="11"
                               Foreground="{Binding IsChartFilterTrade, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                  <Button Classes="chip" Height="28" Padding="8,3"
                          Command="{Binding SetFinanceChartFilterCommand}" CommandParameter="2"
                          Background="{Binding IsChartFilterMissions, Converter={StaticResource AccentBg}}"
                          BorderBrush="{Binding IsChartFilterMissions, Converter={StaticResource AccentBorder}}"
                          ToolTip.Tip="{Binding I18n[Finance_Filter_Missions]}">
                    <TextBlock Text="{Binding I18n[Finance_Filter_Missions]}" FontSize="11"
                               Foreground="{Binding IsChartFilterMissions, Converter={StaticResource ActiveBrush}}" />
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Sci-Fi Chart Control -->
              <views:FinanceTimelineChart Height="230"
                                          ItemsSource="{Binding FinanceChartPoints}"
                                          ChartMode="{Binding SelectedFinanceChartMode}"
                                          EmptyText="{Binding I18n[Finance_Empty_Chart]}" />

              <!-- Chart Legende -->
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsChartModeNetTrend}">
                    <Ellipse Width="8" Height="8" Fill="#38BDF8" />
                    <TextBlock Text="{Binding I18n[Finance_Legend_Earned]}" Foreground="#94A3B8" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsChartModeNetTrend}">
                    <Ellipse Width="8" Height="8" Fill="#F87171" />
                    <TextBlock Text="{Binding I18n[Finance_Legend_Spent]}" Foreground="#94A3B8" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsChartModeCumulative}">
                    <Ellipse Width="8" Height="8" Fill="#60A5FA" />
                    <TextBlock Text="{Binding I18n[Finance_Legend_Net]}" Foreground="#94A3B8" FontSize="11" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="💡 Tipp: Bewege den Mauszeiger über das Diagramm für exakte Buchungsdetails" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- ══ 3. Zwei-Spalten Finanz- & Handels-Analyse ══ -->
          <Grid ColumnDefinitions="*,*">
            <!-- Linke Spalte: Einnahmen- & Ausgaben-Aufschlüsselung -->
            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="12">
              <!-- Einnahmen-Aufschlüsselung -->
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="label" Text="{Binding I18n[Finance_Section_Sources]}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding IncomeStats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:StatItem">
                        <Grid ColumnDefinitions="140,*,Auto" Margin="0,3">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C9D1D9" VerticalAlignment="Center" FontSize="11.5" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Height="14" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding BarWidth}" Background="{Binding Color}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Sub}" Foreground="#8B949E" FontSize="10.5" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#F0F6FC"
                                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Ausgaben-Aufschlüsselung -->
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="label" Text="{Binding I18n[Finance_Section_Expenses]}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding SpendStats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:StatItem">
                        <Grid ColumnDefinitions="140,*,Auto" Margin="0,3">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C9D1D9" VerticalAlignment="Center" FontSize="11.5" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Height="14" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding BarWidth}" Background="{Binding Color}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Sub}" Foreground="#8B949E" FontSize="10.5" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#F0F6FC"
                                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Rechte Spalte: Warenhandel & Marktpreise -->
            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="12">
              <!-- Handel je Ware -->
              <Border Classes="card" IsVisible="{Binding HasTrades}">
                <StackPanel>
                  <TextBlock Classes="label" Text="{Binding I18n[Finance_Section_Commodities]}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding CommodityTrades}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:StatItem">
                        <Grid ColumnDefinitions="140,*,Auto" Margin="0,4">
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Label}" Foreground="#F0F6FC" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding Sub}" Foreground="#8B949E" FontSize="10.5" />
                          </StackPanel>
                          <Border Grid.Column="1" Height="14" CornerRadius="3" HorizontalAlignment="Left"
                                  Width="{Binding BarWidth}" Background="{Binding Color}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#F0F6FC"
                                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Marktpreise (aus eigenen Runs) -->
              <Border Classes="card" IsVisible="{Binding HasMarket}">
                <StackPanel>
                  <TextBlock Classes="label" Text="MARKTPREISE — GESEHEN IN DEINEN RUNS (Ø Preis/SCU · Terminal)" Margin="0,0,0,8" />
                  <Grid ColumnDefinitions="130,*,*,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="WARE" Foreground="#8B949E" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="↥ BESTER VERKAUF" Foreground="#3FB950" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="↧ GÜNSTIGSTER KAUF" Foreground="#F0883E" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="MARGE" Foreground="#8B949E" FontSize="10" Margin="10,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding MarketPrices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:MarketPrice">
                        <Grid ColumnDefinitions="130,*,*,Auto" Margin="0,3">
                          <TextBlock Grid.Column="0" Text="{Binding Commodity}" Foreground="#F0F6FC" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding SellText}" Foreground="#3FB950" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding BuyText}" Foreground="#F0883E" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding MarginText}" Foreground="#58A6FF" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 📈 Empfohlene Handelsrouten & Profit-Kalkulator (Roadmap Feature) -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Classes="label" Text="📈  PROFITABLE HANDELSROUTEN &amp; PROFIT-KALKULATOR" />
                  <TextBlock Text="Vergleicht beliebte Fracht- und Handelsrouten in Stanton &amp; Pyro inklusive Gewinnberechnung nach Schiffskapazität." Foreground="#8B949E" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Schiffskapazität:" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding SelectedTradeShipCapacity}" Minimum="10" Maximum="10000" Width="110" Height="28" FormatString="{}{0} SCU" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <DataGrid ItemsSource="{Binding TradeRoutes}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserSortColumns="True" HeadersVisibility="Column" MinHeight="180">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="WARE" Binding="{Binding Commodity}" Width="180" />
                  <DataGridTextColumn Header="EINKAUFSORT (BUY)" Binding="{Binding BuyLocation}" Width="240" />
                  <DataGridTextColumn Header="VERKAUFSORT (SELL)" Binding="{Binding SellLocation}" Width="220" />
                  <DataGridTemplateColumn Header="MARGE / SCU" Width="120" SortMemberPath="ProfitPerScu">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:TradeRouteItem">
                        <TextBlock Text="{Binding ProfitPerScuText}" Foreground="#3FB950" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="PROFIT JE RUN" Width="160" SortMemberPath="EstimatedRunProfit">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:TradeRouteItem">
                        <TextBlock Text="{Binding EstimatedRunProfitText}" Foreground="#F59E0B" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="RISIKO" Binding="{Binding RiskLevel}" Width="140" />
                  <DataGridTextColumn Header="EMPFOHLENES SCHIFF" Binding="{Binding RecommendedShip}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Größte Einzel-Posten -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="label" Text="GRÖSSTE EINZEL-POSTEN" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding TopTransactions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:StatItem">
                    <Grid ColumnDefinitions="100,*,Auto" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding WhenText}" Foreground="#8B949E"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#C9D1D9"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                 Foreground="{Binding Color}" FontWeight="SemiBold"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Letzte Geld-Bewegungen (neueste zuerst) -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="label" Text="LETZTE GELD-BEWEGUNGEN" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding RecentMoney}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:StatItem">
                    <Grid ColumnDefinitions="100,*,Auto" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding WhenText}" Foreground="#8B949E"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#C9D1D9"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                 Foreground="{Binding Color}" FontWeight="SemiBold"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- SubTab 1: Ledger (Buchungsjournal) -->
    <TabItem Header="{Binding I18n[SubTab_Ledger]}">
      <DockPanel Margin="0,8,0,0">
        <!-- Filter-Leiste & Salden-HUD -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Button Classes="chip" Content="Alle" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Alle"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
            <Button Classes="chip" Content="Frachtverkauf" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Frachtverkauf"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Frachtverkauf}" />
            <Button Classes="chip" Content="Frachtkauf" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Frachtkauf"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Frachtkauf}" />
            <Button Classes="chip" Content="Item gekauft" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Item gekauft"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Item gekauft}" />
            <Button Classes="chip" Content="Überweisung" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Überweisung"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Überweisung}" />
            <Button Classes="chip" Content="Sonstige" Command="{Binding SetLedgerFilterCommand}" CommandParameter="Sonstige"
                    Background="{Binding LedgerFilter, Converter={StaticResource FilterBg}, ConverterParameter=Sonstige}" />
          </StackPanel>

          <Panel Grid.Column="1" Width="200" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBox Classes="search" Text="{Binding LedgerSearchText}" Watermark="Journal durchsuchen…" VerticalAlignment="Center" Height="28" />
            <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
          </Panel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#061810" BorderBrush="#1C5E35" BorderThickness="1" Padding="8,4" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="↗" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding LedgerTotalIncomeText}" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
            <Border Background="#240B0B" BorderBrush="#771D1D" BorderThickness="1" Padding="8,4" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="↘" Foreground="#F87171" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding LedgerTotalSpendText}" Foreground="#F87171" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
            <Border Background="#081827" BorderBrush="#1D4ED8" BorderThickness="1" Padding="8,4" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Saldo:" Foreground="#94A3B8" FontSize="11" />
                <TextBlock Text="{Binding LedgerNetBalanceText}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Ledger Table -->
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding LedgerView}" IsReadOnly="True"
                    CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="130" />
              <DataGridTemplateColumn Header="Typ" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:LedgerRecord">
                    <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                      <TextBlock Text="{Binding KindBadge}" Foreground="#050811" FontSize="10" FontWeight="Bold" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Vorgang / Detail" Binding="{Binding Detail}" Width="*" />
              <DataGridTemplateColumn Header="Betrag" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:LedgerRecord">
                    <TextBlock Text="{Binding AmountFormatted}" Foreground="{Binding AmountColor}"
                               FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0" HorizontalAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Saldo" Binding="{Binding RunningBalanceFormatted}" Width="130"
                                  Foreground="#38BDF8" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Standort / System" Binding="{Binding Location}" Width="160" Foreground="#CBD5E1" />
              <DataGridTextColumn Header="Geschäft / Terminal" Binding="{Binding Shop}" Width="160" Foreground="#94A3B8" />
              <DataGridTextColumn Header="Schiff" Binding="{Binding Ship}" Width="130" Foreground="#A78BFA" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </TabItem>

    <!-- SubTab 2: Ausgaben (Spending) -->
    <TabItem Header="{Binding I18n[SubTab_Spending]}">
      <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <!-- KPI Cards -->
          <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
            <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="GESAMTAUSGABEN" />
                <TextBlock Classes="value" Text="{Binding SpendingTotalAuecText}" Foreground="#F87171" />
                <TextBlock Text="Bestätigte Einkäufe &amp; Ausgaben" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="5,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="EINKÄUFE" />
                <TextBlock Classes="value" Text="{Binding SpendingCountText}" Foreground="#38BDF8" />
                <TextBlock Text="Erfasste Transaktionen" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="5,0,0,0">
              <StackPanel>
                <TextBlock Classes="label" Text="DURCHSCHNITT" />
                <TextBlock Classes="value" Text="{Binding SpendingAverageText}" Foreground="#FBBF24" />
                <TextBlock Text="Ø Ausgaben pro Einkauf" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- 3 Breakdown Spalten: Shop, Item, Kategorie -->
          <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
            <!-- Shops -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="NACH GESCHÄFT" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SpendByShop}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:StatItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="#F87171" FontWeight="SemiBold"
                                   FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Items -->
            <Border Grid.Column="1" Classes="card" Margin="5,0,5,0">
              <StackPanel>
                <TextBlock Classes="label" Text="NACH ARTIKEL" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SpendByItem}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:StatItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="#F87171" FontWeight="SemiBold"
                                   FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Kategorien -->
            <Border Grid.Column="2" Classes="card" Margin="5,0,0,0">
              <StackPanel>
                <TextBlock Classes="label" Text="NACH KATEGORIE" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SpendByCategory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:StatItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="#F87171" FontWeight="SemiBold"
                                   FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Confirmed Purchases Table -->
          <Border Classes="card" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,8">
                <TextBlock Classes="label" Text="BESTÄTIGTE EINKÄUFE (RM-SHOP-RESPONSES)" VerticalAlignment="Center" />
                <Panel Grid.Column="1" Width="200" Height="28">
                  <TextBox Classes="search" Text="{Binding SpendingSearchText}" Watermark="Einkäufe durchsuchen…" VerticalAlignment="Center" Height="28" />
                  <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                </Panel>
              </Grid>
              <DataGrid ItemsSource="{Binding ConfirmedPurchasesView}" IsReadOnly="True"
                        CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" Height="320">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="130" />
                  <DataGridTextColumn Header="Geschäft" Binding="{Binding ShopName}" Width="180" Foreground="#38BDF8" />
                  <DataGridTextColumn Header="Artikel" Binding="{Binding ItemName}" Width="*" Foreground="#F0F6FC" />
                  <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="140" Foreground="#A78BFA" />
                  <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="80" />
                  <DataGridTextColumn Header="Gesamtpreis" Binding="{Binding TotalPriceFormatted}" Width="130"
                                      Foreground="#F87171" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                  <DataGridTextColumn Header="Standort" Binding="{Binding Location}" Width="160" Foreground="#94A3B8" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- SubTab 3: Fracht (Cargo Trades) -->
    <TabItem Header="{Binding I18n[SubTab_Cargo]}">
      <DockPanel Margin="0,8,0,0">
        <!-- Filter & KPI Bar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Button Classes="chip" Content="Alle Trades" Command="{Binding SetCargoActionFilterCommand}" CommandParameter="Alle"
                    Background="{Binding CargoActionFilter, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
            <Button Classes="chip" Content="Nur Verkäufe" Command="{Binding SetCargoActionFilterCommand}" CommandParameter="Verkauf"
                    Background="{Binding CargoActionFilter, Converter={StaticResource FilterBg}, ConverterParameter=Verkauf}" />
            <Button Classes="chip" Content="Nur Einkäufe" Command="{Binding SetCargoActionFilterCommand}" CommandParameter="Einkauf"
                    Background="{Binding CargoActionFilter, Converter={StaticResource FilterBg}, ConverterParameter=Einkauf}" />
          </StackPanel>

          <Panel Grid.Column="1" Width="200" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBox Classes="search" Text="{Binding CargoSearchText}" Watermark="Fracht durchsuchen…" VerticalAlignment="Center" Height="28" />
            <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
          </Panel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#081827" BorderBrush="#1D4ED8" BorderThickness="1" Padding="8,4" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Volumen:" Foreground="#94A3B8" FontSize="11" />
                <TextBlock Text="{Binding CargoTotalScuText}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
            <Border Background="#061810" BorderBrush="#1C5E35" BorderThickness="1" Padding="8,4" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Gewinn:" Foreground="#94A3B8" FontSize="11" />
                <TextBlock Text="{Binding CargoNetProfitText}" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Cargo Trades Table -->
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding CargoTradesView}" IsReadOnly="True"
                    CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="130" />
              <DataGridTemplateColumn Header="Aktion" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:CargoTradeRecord">
                    <Border Background="{Binding ActionColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                      <TextBlock Text="{Binding ActionText}" Foreground="#050811" FontSize="10" FontWeight="Bold" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Ware" Binding="{Binding Commodity}" Width="160" Foreground="#F0F6FC" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Volumen" Binding="{Binding ScuFormatted}" Width="100" Foreground="#F59E0B"
                                  FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Gesamtpreis" Binding="{Binding TotalPriceFormatted}" Width="130"
                                  FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Preis / SCU" Binding="{Binding PricePerScuFormatted}" Width="120"
                                  Foreground="#94A3B8" FontFamily="Cascadia Code, Consolas, monospace" />
              <DataGridTextColumn Header="Handelsterminal / Ort" Binding="{Binding Where}" Width="*" Foreground="#CBD5E1" />
              <DataGridTextColumn Header="Schiff" Binding="{Binding Ship}" Width="130" Foreground="#A78BFA" />
              <DataGridTemplateColumn Header="Markt" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:CargoTradeRecord">
                    <Button Classes="ghost" Content="📊 Markt" Padding="6,2" FontSize="10" VerticalAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenCommodityDetailCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </TabItem>
      </TabControl>
    </TabItem>

    <TabItem Header="{Binding I18n[Tab_Missions]}">
      <TabControl Padding="0" SelectedIndex="{Binding MissionSubTabIndex}">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="Padding" Value="9,4,9,4" />
            <Setter Property="FontSize" Value="11.5" />
          </Style>
        </TabControl.Styles>

        <!-- SubTab 0: Aufträge (Contracts & Verlauf) -->
        <TabItem Header="{Binding I18n[SubTab_ContractsHistory]}">
          <DockPanel Margin="0,8,0,0">
            <!-- 1. Top KPI Summary HUD Cards -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
              <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="ANGENOMMEN" />
                  <TextBlock Classes="value" Text="{Binding ContractsTotalCount}" Foreground="#F0F6FC" />
                  <TextBlock Text="Erfasste Verträge" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Margin="5,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="ERFOLGREICH" />
                  <TextBlock Classes="value" Text="{Binding ContractsCompletedCount}" Foreground="#4ADE80" />
                  <TextBlock Text="Abgeschlossene Aufträge" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card" Margin="5,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="FEHLGESCHLAGEN" />
                  <TextBlock Classes="value" Text="{Binding ContractsAbandonedCount}" Foreground="#F87171" />
                  <TextBlock Text="Abgebrochen / Abandoned" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="card" Margin="5,0,0,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="ERFOLGSQUOTE" />
                  <TextBlock Classes="value" Text="{Binding ContractsCompletionRateText}" Foreground="#38BDF8" />
                  <TextBlock Text="Abschlussrate" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 2. Facetten & Such-Leiste -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,10">
              <!-- Auftraggeber Facette -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Auftraggeber:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ContractIssuers}"
                          SelectedValue="{Binding SelectedContractIssuer, Mode=TwoWay}" SelectedValueBinding="{Binding Name}"
                          Width="160" Height="28" Padding="6,2" CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1" FontSize="11">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:FacetItem">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Typ Facette -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Typ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ContractTypes}"
                          SelectedValue="{Binding SelectedContractType, Mode=TwoWay}" SelectedValueBinding="{Binding Name}"
                          Width="150" Height="28" Padding="6,2" CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1" FontSize="11">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:FacetItem">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Status Dropdown -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Status:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ContractOutcomes}" SelectedItem="{Binding SelectedContractOutcome}"
                          Width="130" Height="28" Padding="6,2"
                          CornerRadius="5" Background="#0A1422" BorderBrush="#1C324A" BorderThickness="1" FontSize="11" />
              </StackPanel>

              <!-- Suchfeld -->
              <Panel Grid.Column="4" Width="220" Height="28" VerticalAlignment="Center">
                <TextBox Classes="search" Text="{Binding ContractSearchText}" Watermark="Auftrag suchen…" VerticalAlignment="Center" Height="28" />
                <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
              </Panel>
            </Grid>

            <!-- 3. Contracts Table -->
            <Border Classes="card" Padding="0">
              <DataGrid ItemsSource="{Binding ContractRecords}" IsReadOnly="True"
                        CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Angenommen" Binding="{Binding AcceptedAtText}" Width="130" />
                  <DataGridTextColumn Header="Auftraggeber" Binding="{Binding Issuer}" Width="160" Foreground="#38BDF8" FontWeight="SemiBold" />
                  <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="120" Foreground="#FBBF24" />
                  <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*" Foreground="#F0F6FC" FontWeight="SemiBold" />
                  <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="m:ContractRecord">
                        <Border Background="#0A1422" BorderBrush="{Binding OutcomeBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                          <TextBlock Text="{Binding OutcomeText}" Foreground="{Binding OutcomeBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Schritte" Binding="{Binding ProgressText}" Width="90" Foreground="#CBD5E1" />
                  <DataGridTextColumn Header="Belohnung" Binding="{Binding RewardFormatted}" Width="110"
                                      Foreground="#4ADE80" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                  <DataGridTextColumn Header="System" Binding="{Binding System}" Width="90" Foreground="#A78BFA" />
                  <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" Width="90" Foreground="#94A3B8" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>

        <!-- SubTab 1: Katalog (Missionsdatenbank) -->
        <TabItem Header="{Binding I18n[SubTab_Catalog]}">
          <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

          <!-- 1. Prominenter Aktiver Auftrag // mobiGlas Contract HUD -->
          <Border Classes="card" BorderBrush="#38BDF8" BorderThickness="1" Padding="14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="🎯  AKTIVER AUFTRAG // MOBIGLAS CONTRACT" Classes="label" Foreground="#38BDF8" VerticalAlignment="Center" />
                  <Border Background="#061828" BorderBrush="#1C4872" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                          IsVisible="{Binding HasActiveContracts}">
                    <TextBlock Text="{Binding ActiveContractsCountText}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Padding="6,2" CornerRadius="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                        Command="{Binding ClearContractsCommand}" IsVisible="{Binding HasActiveContracts}"
                        ToolTip.Tip="Aktive Auftragsliste manuell leeren">
                  <TextBlock Text="✕ Liste leeren" FontSize="10" Foreground="#F87171" />
                </Button>
              </Grid>

              <!-- Wenn Aufträge aktiv sind -->
              <StackPanel Spacing="8" IsVisible="{Binding HasActiveContracts}">
                <ItemsControl ItemsSource="{Binding ActiveContracts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ContractDetails">
                      <Border Background="#070E18" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <TextBlock Grid.Column="0" Text="★" Foreground="#FFB23E" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#F0F6FC" FontWeight="Bold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                              <TextBlock Text="{Binding ContractedBy}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="·" Foreground="#7E97AD" />
                              <TextBlock Text="{Binding TimeText}" Foreground="#7E97AD" FontSize="11" />
                            </StackPanel>
                          </StackPanel>
                          <Border Grid.Column="2" Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RewardText}" Foreground="#4ADE80" FontWeight="Bold"
                                       FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" />
                          </Border>
                          <Button Grid.Column="3" Classes="ghost" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveContractCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Auftrag als erledigt markieren / entfernen">
                            <TextBlock Text="✓ Erledigt" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Wenn KEIN Auftrag aktiv ist -->
              <Border Background="#060C14" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="14,12"
                      IsVisible="{Binding !HasActiveContracts}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="ℹ" FontSize="20" Foreground="#7E97AD" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Aktuell kein aktiver Auftrag erfasst" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Sobald du im Star Citizen mobiGlas einen Auftrag annimmst, erscheint er hier live. Du kannst auch unten aus der Datenbank eine Mission auswählen." Foreground="#7E97AD" FontSize="11" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- Master Missions-Datenbank & In-Game Wiki (scunpacked-data) -->
          <StackPanel Spacing="8">
            <Border Classes="card" Padding="14,10">
              <Grid ColumnDefinitions="Auto,*,Auto,280">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="❖  MISSIONS-DATENBANK (SCUNPACKED)" Classes="label" VerticalAlignment="Center" />
                  <Border Background="#21262D" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalMissionsCount, StringFormat='{}{0:N0} Missionen'}" Foreground="#A371F7" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>

                <TextBox Grid.Column="3" Classes="path" Height="30" Text="{Binding MissionSearchText}"
                         Watermark="🔍 Mission, Auftraggeber, Typ, Bauplan..." VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Filter-Chips -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Content="Alle" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Alle"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
                <Button Classes="chip" Content="🎯 Kopfgeldjagd" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Kopfgeldjagd"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Kopfgeldjagd}" />
                <Button Classes="chip" Content="⚔ Söldner" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Söldner"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Söldner}" />
                <Button Classes="chip" Content="📦 Fracht &amp; Transport" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Fracht &amp; Transport"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Fracht &amp; Transport}" />
                <Button Classes="chip" Content="🔍 Ermittlung" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Ermittlung"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Ermittlung}" />
                <Button Classes="chip" Content="🧲 Bergung &amp; Salvage" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Bergung &amp; Salvage"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Bergung &amp; Salvage}" />
                <Button Classes="chip" Content="🔧 Wartung" Command="{Binding SelectMissionTypeCommand}" CommandParameter="Wartung"
                        Background="{Binding SelectedMissionType, Converter={StaticResource FilterBg}, ConverterParameter=Wartung}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Missions DataGrid -->
            <Border Classes="card" Padding="0" MinHeight="350">
              <DataGrid ItemsSource="{Binding MissionsView}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="SYSTEM" Width="90" SortMemberPath="StarSystems">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                          <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="4,2">
                            <TextBlock Text="{Binding StarSystems}" FontSize="10" Foreground="#58A6FF" FontWeight="Bold" />
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="MISSION" Width="200" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="AUFTRAGGEBER" Width="150" SortMemberPath="Contractor">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding Contractor}" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="FRAKTION" Width="140" SortMemberPath="Faction">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding Faction}" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="KATEGORIE" Width="130" SortMemberPath="MissionType">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding MissionType}" Foreground="#A371F7" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="BELOHNUNG" Width="120" SortMemberPath="BaseReward">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding RewardText}" Foreground="#4ADE80" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="RUF" Width="80" SortMemberPath="ReputationGain">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding ReputationText}" Foreground="#C9B3F7" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" Margin="8,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="BAUPLAN-DROPS" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding BlueprintsText}" Foreground="#FBBF24" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BlueprintsText}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="AKTION" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <Button Classes="ghost" Padding="6,2" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).SetMissionAsActiveContractCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Als aktiven Auftrag übernehmen">
                          <TextBlock Text="★ Annehmen" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="BESCHREIBUNG" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="core:MissionInfo">
                        <TextBlock Text="{Binding Description}" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabItem>
      </TabControl>
    </TabItem>

    <!-- Tab 3: Fraktionsruf & Reputation -->
    <TabItem Header="{Binding I18n[Tab_Reputation]}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel Spacing="10">

          <!-- 🛡 Fraktionsruf & Reputations-System 🛡 -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="🎖  FRAKTIONSRUF &amp; REPUTATIONS-SYSTEM" Classes="label" VerticalAlignment="Center" />
                  <Border Background="#060C16" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                    <TextBlock Text="Rang 1 bis 6" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Ruf-XP wird automatisch bei Abschluss von Missionen gutgeschrieben." Foreground="#7E97AD" FontSize="11" VerticalAlignment="Center" />
              </Grid>

              <!-- Kategorie-Chips -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="chip" Content="Alle Fraktionen" Command="{Binding SelectFactionCategoryCommand}" CommandParameter="Alle"
                          Background="{Binding SelectedFactionCategory, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
                  <Button Classes="chip" Content="🛡 Sicherheit" Command="{Binding SelectFactionCategoryCommand}" CommandParameter="Sicherheit"
                          Background="{Binding SelectedFactionCategory, Converter={StaticResource FilterBg}, ConverterParameter=Sicherheit}" />
                  <Button Classes="chip" Content="📦 Fracht" Command="{Binding SelectFactionCategoryCommand}" CommandParameter="Fracht"
                          Background="{Binding SelectedFactionCategory, Converter={StaticResource FilterBg}, ConverterParameter=Fracht}" />
                  <Button Classes="chip" Content="⛏ Industrie" Command="{Binding SelectFactionCategoryCommand}" CommandParameter="Industrie"
                          Background="{Binding SelectedFactionCategory, Converter={StaticResource FilterBg}, ConverterParameter=Industrie}" />
                  <Button Classes="chip" Content="🕶 Unterwelt" Command="{Binding SelectFactionCategoryCommand}" CommandParameter="Unterwelt"
                          Background="{Binding SelectedFactionCategory, Converter={StaticResource FilterBg}, ConverterParameter=Unterwelt}" />
                </StackPanel>
              </ScrollViewer>

              <!-- Fraktions-Karten Grid -->
              <ItemsControl ItemsSource="{Binding FactionsView}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:FactionReputation">
                    <Border Background="#070E18" BorderBrush="#172B40" BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Width="285" Margin="0,0,10,10">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <!-- Top Row: Icon + Name + Category Pill -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding ShortName}" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="2" Background="{Binding CategoryBgBrush}" BorderBrush="{Binding CategoryBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{Binding CategoryBrush}" FontWeight="Bold" />
                          </Border>
                        </Grid>

                        <!-- System / Description -->
                        <TextBlock Grid.Row="1" Text="{Binding System}" Foreground="#7E97AD" FontSize="10" Margin="0,4,0,2" />

                        <!-- Level Title & Completed Missions -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                          <TextBlock Grid.Column="0" Text="{Binding LevelTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CategoryBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding MissionsCountText}" Foreground="#7E97AD" FontSize="10" Margin="4,0,0,0" />
                        </Grid>

                        <!-- XP Progress Bar -->
                        <StackPanel Grid.Row="3" Spacing="3">
                          <ProgressBar Height="5" CornerRadius="2.5" Value="{Binding LevelProgressPercent}" Maximum="100"
                                       Foreground="{Binding CategoryBrush}" Background="#060C14" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Foreground="#6E8498" FontSize="9.5" FontFamily="Cascadia Code, Consolas, monospace" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelProgressPercent, StringFormat='{}{0:F0}%'}" Foreground="#6E8498" FontSize="9.5" FontWeight="Bold" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Missions-Statistik je Auftraggeber -->
          <Border Classes="card" IsVisible="{Binding HasMissionFactions}">
            <StackPanel>
              <TextBlock Classes="label" Text="ABGESCHLOSSENE MISSIONEN JE AUFTRAGGEBER" Margin="0,0,0,2" />
              <TextBlock Text="{Binding MissionsTotalText}" Foreground="#8B949E" FontSize="11" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding MissionFactions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:MissionStat">
                    <Grid ColumnDefinitions="150,*,Auto" Margin="0,4">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Faction}" Foreground="#F0F6FC" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubText}" Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Border Grid.Column="1" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                              Width="{Binding BarWidth}" Background="#A371F7" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="#F0F6FC"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                 Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Tab 4: Sternenkarte (Starmap & Standorte) -->
    <TabItem Header="{Binding I18n[Tab_Starmap]}">
      <Grid ColumnDefinitions="*,330" Margin="0,10,0,0">
        
        <!-- Linker Bereich: System-Toolbar + Starmap Canvas -->
        <Border Grid.Column="0" Classes="card" Padding="0" Margin="0,0,8,0">
          <DockPanel>
            
            <!-- Toolbar über der Karte: System-Buttons & Layer Toggles -->
            <Border DockPanel.Dock="Top" Background="#060C14" BorderBrush="#172B40" BorderThickness="0,0,0,1" Padding="10,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- System-Umschalter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="chip" Command="{Binding SelectStarmapSystemCommand}" CommandParameter="Stanton"
                          Background="{Binding SelectedStarmapSystem, Converter={StaticResource FilterBg}, ConverterParameter=Stanton}">
                    <TextBlock Text="☀️ Stanton" FontWeight="Bold" Foreground="#F0F6FC" />
                  </Button>
                  <Button Classes="chip" Command="{Binding SelectStarmapSystemCommand}" CommandParameter="Pyro"
                          Background="{Binding SelectedStarmapSystem, Converter={StaticResource FilterBg}, ConverterParameter=Pyro}">
                    <TextBlock Text="🔥 Pyro" FontWeight="Bold" Foreground="#F0F6FC" />
                  </Button>
                  <Button Classes="chip" Command="{Binding SelectStarmapSystemCommand}" CommandParameter="Nyx"
                          Background="{Binding SelectedStarmapSystem, Converter={StaticResource FilterBg}, ConverterParameter=Nyx}">
                    <TextBlock Text="🌌 Nyx" FontWeight="Bold" Foreground="#F0F6FC" />
                  </Button>
                </StackPanel>

                <!-- Filter / Toggles & Mein Standort & QD Drive -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="QD:" Foreground="#7E97AD" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" />
                  <ComboBox ItemsSource="{Binding AvailableQuantumDrives}"
                            SelectedItem="{Binding SelectedQuantumDrive}"
                            Width="175" Height="26" FontSize="10.5" Background="#0A1422" BorderBrush="#1C3857">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:QuantumDriveProfile">
                        <TextBlock Text="{Binding DisplayText}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <ToggleButton Classes="ghost" Padding="5,2" IsChecked="{Binding ShowStarmapStations}" Content="🛰" FontSize="11" ToolTip.Tip="Stationen &amp; Lagrange anzeigen" />
                  <ToggleButton Classes="ghost" Padding="5,2" IsChecked="{Binding ShowStarmapMoons}" Content="🌙" FontSize="11" ToolTip.Tip="Monde anzeigen" />
                  <ToggleButton Classes="ghost" Padding="5,2" IsChecked="{Binding ShowStarmapLandingZones}" Content="🏙" FontSize="11" ToolTip.Tip="Landezonen &amp; Städte anzeigen" />
                  <ToggleButton Classes="ghost" Padding="5,2" IsChecked="{Binding ShowStarmapJumpPoints}" Content="🌀" FontSize="11" ToolTip.Tip="Sprungtore anzeigen" />
                  
                  <Button Classes="ghost" Padding="6,3" Command="{Binding ToggleStarmapFullscreenCommand}" ToolTip.Tip="Vollbild: Obere Karten ein-/ausklappen">
                    <TextBlock Text="⛶ Vollbild" FontSize="11" />
                  </Button>
                  <Button Classes="ghost" Padding="6,3" Command="{Binding OpenStarmapPopoutWindowCommand}" ToolTip.Tip="Karten in eigenem Pop-out Großfenster öffnen (für 2. Monitor)">
                    <TextBlock Text="🗔 Pop-out" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                  </Button>
                  <Button Classes="accent" Padding="8,3" Command="{Binding OpenStarmapForCurrentLocationCommand}" ToolTip.Tip="Kamera auf deinen aktuellen Standort zentrieren">
                    <TextBlock Text="📍 Standort" FontSize="11" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Vector Canvas -->
            <views:StarmapCanvas SystemName="{Binding SelectedStarmapSystem}"
                                 PlayerLocationName="{Binding ResolvedLocation.DisplayName}"
                                 SelectedObject="{Binding SelectedStarmapObject, Mode=TwoWay}"
                                 SelectedDrive="{Binding SelectedQuantumDrive}"
                                 FocusRequest="{Binding StarmapFocusRequest}"
                                 ShowStations="{Binding ShowStarmapStations}"
                                 ShowMoons="{Binding ShowStarmapMoons}"
                                 ShowLandingZones="{Binding ShowStarmapLandingZones}"
                                 ShowJumpPoints="{Binding ShowStarmapJumpPoints}"
                                 UserPois="{Binding UserPois}" />
          </DockPanel>
        </Border>

        <!-- Rechter Bereich: Info-Panel & Ortssuche -->
        <Border Grid.Column="1" Classes="card" Padding="12">
          <DockPanel>
            
            <!-- Suchfeld -->
            <TextBox DockPanel.Dock="Top" Classes="path" Text="{Binding StarmapSearchText}" Watermark="🔎 Ort / Station suchen..." Margin="0,0,0,10" />

            <!-- Selektiertes Objekt oder Suchliste -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">

                <!-- 1. Dein Standort Zusammenfassung -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="📍 DEIN AKTUELLER STANDORT" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="{Binding LocationMainText}" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" />
                    <TextBlock Text="{Binding ResolvedLocation.FullBreadcrumb}" FontSize="11" Foreground="#8B949E" />
                    <Border Background="#0D1117" CornerRadius="4" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding ResolvedLocation.ArmisticeStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 2. Detailkarte des angeklickten Objekts -->
                <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10"
                        IsVisible="{Binding SelectedStarmapObject, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding SelectedStarmapObject.Name}" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Background="#21262D" CornerRadius="4" Padding="5,1">
                        <TextBlock Text="{Binding SelectedStarmapObject.Type}" FontSize="10" Foreground="#58A6FF" FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <TextBlock Text="{Binding SelectedStarmapObject.Description}" Foreground="#C9D1D9" FontSize="11" TextWrapping="Wrap" />

                    <!-- Badges: Sicherheit & Schutzzone -->
                    <WrapPanel Orientation="Horizontal">
                      <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4"
                              IsVisible="{Binding SelectedStarmapObject.HasArmistice}">
                        <TextBlock Text="🟢 Schutzzone" Foreground="#3FB950" FontSize="10" FontWeight="Bold" />
                      </Border>
                      <Border Background="#1A1806" BorderBrush="#8A6A1D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4"
                              IsVisible="{Binding !SelectedStarmapObject.HasArmistice}">
                        <TextBlock Text="🔴 Keine Schutzzone" Foreground="#F87171" FontSize="10" FontWeight="Bold" />
                      </Border>
                    </WrapPanel>

                    <!-- Spezialisierung / Funktion -->
                    <Border Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="8,5"
                            IsVisible="{Binding SelectedStarmapObject.Specialization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Spacing="1">
                        <TextBlock Text="FUNKTION / DIENSTE" Foreground="#7E97AD" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedStarmapObject.Specialization}" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>

                    <!-- Rohstoff-Vorkommen -->
                    <Border Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="8,5"
                            IsVisible="{Binding SelectedStarmapObject.Resources, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Spacing="1">
                        <TextBlock Text="MINING-VORKOMMEN" Foreground="#7E97AD" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedStarmapObject.Resources}" Foreground="#FFB23E" FontSize="11" FontWeight="Bold" />
                      </StackPanel>
                    </Border>

                    <!-- Sprungtor-Aktion (falls Sprungtor) -->
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                            IsVisible="{Binding SelectedStarmapObject.TargetSystem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding JumpToTargetSystemCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🌀" />
                        <TextBlock Text="{Binding SelectedStarmapObject.TargetSystem, StringFormat='Direkt nach {0} springen'}" FontWeight="Bold" />
                      </StackPanel>
                    </Button>

                    <!-- UEX Live Services & Ausstattung -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0"
                            IsVisible="{Binding SelectedStarmapUexInfo.HasAnyServices}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="DIENSTE &amp; AUSSTATTUNG (UEX)" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                        <WrapPanel Orientation="Horizontal">
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasRefuel}">
                            <TextBlock Text="⛽ Betankung" FontSize="10" Foreground="#4ADE80" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasRepair}">
                            <TextBlock Text="🔧 Reparatur" FontSize="10" Foreground="#4ADE80" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasClinic}">
                            <TextBlock Text="🏥 Klinik / ICU" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasCargoCenter}">
                            <TextBlock Text="📦 Frachtzentrum" FontSize="10" Foreground="#FBBF24" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasRefinery}">
                            <TextBlock Text="⬡ Raffinerie" FontSize="10" Foreground="#F97316" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasFreightElevator}">
                            <TextBlock Text="🛗 Frachtaufzug" FontSize="10" Foreground="#A78BFA" FontWeight="SemiBold" />
                          </Border>
                          <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,4"
                                  IsVisible="{Binding SelectedStarmapUexInfo.HasTradeTerminal}">
                            <TextBlock Text="🛒 Handelsterminal" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold" />
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
                            Command="{Binding LookupStarmapOnUexCommand}" Content="🌐  UEX / Handelsdaten öffnen" />
                  </StackPanel>
                </Border>

                <!-- 2b. Eigene Wegpunkte & Notizen (Custom User POIs) -->
                <Border Background="#161B22" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="📌  PERSÖNLICHE NOTIZEN &amp; POIS" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                      <Border Grid.Column="1" Background="#21262D" CornerRadius="4" Padding="5,1">
                        <TextBlock Text="{Binding UserPois.Count, StringFormat='{}{0} POIs'}" FontSize="10" Foreground="#FBBF24" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    
                    <!-- Eingabeformular für neuen POI -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <TextBox Grid.Column="0" Classes="path" Text="{Binding NewPoiName}" Watermark="POI-Name (z.B. Quantanium Spot)" FontSize="11" />
                      <Button Grid.Column="1" Classes="accent" Background="#D97706" Padding="8,4" Margin="6,0,0,0"
                              Command="{Binding AddUserPoiCommand}" Content="＋ Speichern" FontSize="11" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                      <TextBox Grid.Column="0" Classes="path" Text="{Binding NewPoiBody}" Watermark="Körper (Standard: gewählt)" FontSize="10" Margin="0,0,3,0" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Height="26" SelectedItem="{Binding NewPoiCategory}" Margin="3,0,0,0" FontSize="10">
                        <x:String>Mining</x:String>
                        <x:String>Salvage</x:String>
                        <x:String>Trade</x:String>
                        <x:String>Bunker</x:String>
                        <x:String>Secret</x:String>
                      </ComboBox>
                    </Grid>
                    <TextBox Classes="path" Text="{Binding NewPoiNotes}" Watermark="Optionale Notizen / Koordinaten..." FontSize="10" />

                    <!-- Liste der bestehenden POIs -->
                    <ItemsControl ItemsSource="{Binding UserPois}" Margin="0,4,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:UserPoi">
                          <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <TextBlock Grid.Column="0" Text="◆" Foreground="{Binding Color}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" />
                                  <TextBlock Text="{Binding Body, StringFormat='@ {0}'}" FontSize="10" Foreground="#F59E0B" />
                                </StackPanel>
                                <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="#8B949E" IsVisible="{Binding Notes.Length}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Button Grid.Column="2" Classes="ghost" Padding="4,2"
                                      Command="{Binding ((vm:MainViewModel)DataContext).DeleteUserPoiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="✕" FontSize="10" Foreground="#F87171" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- 3. Liste der Orte im System -->
                <TextBlock Text="ORTE IM SYSTEM" Classes="label" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding SearchStarmapResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,4"
                              Command="{Binding ((vm:MainViewModel)DataContext).SelectStarmapObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Column="0" Text="◉" Foreground="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8B949E" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" Foreground="#58A6FF" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>

          </DockPanel>
        </Border>

      </Grid>
    </TabItem>

    <!-- Tab 5: 📍 Orte (Places & Quantum-Ziele) -->
    <TabItem Header="{Binding I18n[Tab_Places]}">
      <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <!-- Filter Bar & Summary Badges -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Content="Alle Zeiten" Command="{Binding SetPlacesPeriodCommand}" CommandParameter="Alle"
                      Background="{Binding PlacesPeriod, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
              <Button Classes="chip" Content="30 Tage" Command="{Binding SetPlacesPeriodCommand}" CommandParameter="30 Tage"
                      Background="{Binding PlacesPeriod, Converter={StaticResource FilterBg}, ConverterParameter=30 Tage}" />
              <Button Classes="chip" Content="7 Tage" Command="{Binding SetPlacesPeriodCommand}" CommandParameter="7 Tage"
                      Background="{Binding PlacesPeriod, Converter={StaticResource FilterBg}, ConverterParameter=7 Tage}" />
              <Button Classes="chip" Content="24 Stunden" Command="{Binding SetPlacesPeriodCommand}" CommandParameter="24 Stunden"
                      Background="{Binding PlacesPeriod, Converter={StaticResource FilterBg}, ConverterParameter=24 Stunden}" />
              <Button Classes="chip" Content="Session" Command="{Binding SetPlacesPeriodCommand}" CommandParameter="Session"
                      Background="{Binding PlacesPeriod, Converter={StaticResource FilterBg}, ConverterParameter=Session}" />
            </StackPanel>

            <Panel Grid.Column="1" Width="200" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBox Classes="search" Text="{Binding PlacesSearchText}" Watermark="Ort / Sprungziel suchen…" VerticalAlignment="Center" Height="28" />
              <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
            </Panel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="#0A1E33" BorderBrush="#1C4B78" BorderThickness="1" Padding="10,5" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="📍" FontSize="12" />
                  <TextBlock Text="{Binding TotalLocationsVisitedCount, StringFormat='{}{0} Standorte'}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                </StackPanel>
              </Border>
              <Border Background="#1A1033" BorderBrush="#5B21B6" BorderThickness="1" Padding="10,5" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⚡" FontSize="12" Foreground="#A78BFA" />
                  <TextBlock Text="{Binding TotalQuantumJumpsCount, StringFormat='{}{0} Quantum-Sprünge'}" Foreground="#C084FC" FontSize="11" FontWeight="Bold" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 2-Spalten-Layout: Orte links, Quantum-Ziele rechts -->
          <Grid ColumnDefinitions="*,*">
            <!-- Linke Spalte: Top Standorte -->
            <Border Grid.Column="0" Classes="card" Padding="0" Margin="0,0,6,0">
              <StackPanel>
                <Border Padding="14,10" BorderBrush="#1C324A" BorderThickness="0,0,0,1" Background="#0A1422">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📍" FontSize="14" />
                    <TextBlock Classes="label" Text="MEISTBESUCHTE STANDORTE" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding TopLocations}" IsReadOnly="True"
                          CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" Height="520">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Standort / Station" Binding="{Binding Name}" Width="*" Foreground="#F0F6FC" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="System" Binding="{Binding System}" Width="90" Foreground="#38BDF8" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="100" Foreground="#94A3B8" />
                    <DataGridTemplateColumn Header="Besuche" Width="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:LocationVisitTotal">
                          <Border Background="#0A1E33" BorderBrush="#1C4B78" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{Binding VisitCountFormatted}" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Zuletzt" Binding="{Binding LastVisitedText}" Width="120" Foreground="#64748B" FontSize="11" />
                    <DataGridTemplateColumn Header="Karte" Width="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:LocationVisitTotal">
                          <Button Classes="ghost" Content="🗺" Padding="6,2" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Auf Sternenkarte anzeigen"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenStarmapForPlaceCommand}"
                                  CommandParameter="{Binding Name}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <!-- Rechte Spalte: Top Quantum Destinations -->
            <Border Grid.Column="1" Classes="card" Padding="0" Margin="6,0,0,0">
              <StackPanel>
                <Border Padding="14,10" BorderBrush="#1C324A" BorderThickness="0,0,0,1" Background="#0A1422">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚡" FontSize="14" Foreground="#A78BFA" />
                    <TextBlock Classes="label" Text="TOP QUANTUM-SPRUNGZIELE" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding TopQuantumDestinations}" IsReadOnly="True"
                          CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" Height="520">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Sprungziel" Binding="{Binding Destination}" Width="*" Foreground="#F0F6FC" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="Sprünge" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:QuantumDestinationTotal">
                          <Border Background="#1A1033" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{Binding JumpCountFormatted}" Foreground="#C084FC" FontSize="10.5" FontWeight="Bold" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Letzter Sprung" Binding="{Binding LastJumpText}" Width="130" Foreground="#64748B" FontSize="11" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Tab 6: Flugschreiber & Session-Timeline (Black Box) -->
    <TabItem Header="{Binding I18n[Tab_BlackBox]}">
      <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
        
        <!-- 1. Obere Missions- & Black-Box-Header Leiste -->
        <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,*,*,*,Auto">
            
            <!-- KPI 1: Flugdistanz -->
            <Border Grid.Column="0" Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="🚀" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FLUGDISTANZ (QUANTUM)" FontSize="9.5" FontWeight="Bold" Foreground="#7E97AD" LetterSpacing="0.5" />
                  <TextBlock Text="{Binding FlightSummary.TotalDistanceText}" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" />
                  <TextBlock Text="{Binding FlightSummary.QuantumJumps, StringFormat='{}{0} Quantum-Sprünge'}" FontSize="10.5" Foreground="#8B949E" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- KPI 2: Flugzeit / Cockpit -->
            <Border Grid.Column="1" Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⏱" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FLUGZEIT / COCKPIT" FontSize="9.5" FontWeight="Bold" Foreground="#7E97AD" LetterSpacing="0.5" />
                  <TextBlock Text="{Binding FlightSummary.TotalFlightDuration, StringFormat='{}{0:hh\\:mm} Std. aktiv'}" FontSize="13.5" FontWeight="Bold" Foreground="#60A5FA" />
                  <TextBlock Text="{Binding FlightSummary.TotalSessionDuration, StringFormat='{}von {0:hh\\:mm} Std. Gesamt'}" FontSize="10.5" Foreground="#8B949E" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- KPI 3: Schiffseinsätze & Flotte -->
            <Border Grid.Column="2" Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="🛸" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="SCHIFFSEINSÄTZE" FontSize="9.5" FontWeight="Bold" Foreground="#7E97AD" LetterSpacing="0.5" />
                  <TextBlock Text="{Binding FlightSummary.SortieCount, StringFormat='{}{0} Starts'}" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" />
                  <TextBlock Text="{Binding FlightSummary.ShipsUsedText}" FontSize="10.5" Foreground="#8B949E" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- KPI 4: Navigation & Himmelskörper -->
            <Border Grid.Column="3" Background="#060C16" BorderBrush="#172B40" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="🪐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="NAVIGATION &amp; ZONEN" FontSize="9.5" FontWeight="Bold" Foreground="#7E97AD" LetterSpacing="0.5" />
                  <TextBlock Text="{Binding FlightSummary.VisitedBodies.Count, StringFormat='{}{0} Himmelskörper'}" FontSize="13.5" FontWeight="Bold" Foreground="#34D399" />
                  <TextBlock Text="{Binding FlightSummary.VisitedBodiesText}" FontSize="10.5" Foreground="#8B949E" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Aktionen: Export & Aktualisieren -->
            <StackPanel Grid.Column="4" Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
              <Button Classes="accent" Command="{Binding RebuildTimelineCommand}" Padding="10,5" ToolTip.Tip="Flugschreiber für die aktuelle Session neu berechnen">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="🔄" />
                  <TextBlock Text="Neu analysieren" FontSize="11" FontWeight="Bold" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Command="{Binding ExportFlightLogCommand}" Padding="10,4" ToolTip.Tip="Flugbericht als Markdown-Datei exportieren">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="📄" />
                  <TextBlock Text="Markdown" FontSize="11" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Command="{Binding ExportHtmlFlightReportCommand}" Padding="10,4" ToolTip.Tip="Interaktiven Flugbericht als HTML-Datei exportieren und im Browser öffnen">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="🌐" />
                  <TextBlock Text="HTML-Report" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>

          </Grid>
        </Border>

        <!-- 2. Hauptbereich: Links Timeline / Rechts Insights -->
        <Grid Grid.Row="1" ColumnDefinitions="*,360">
          
          <!-- Linke Spalte: Filter-Toolbar + Chronologischer Zeitstrahl -->
          <Border Grid.Column="0" Classes="card" Padding="12" Margin="0,0,8,0">
            <DockPanel>
              
              <!-- Filter-Leiste & Volltextsuche (OHNE störende Scrollbars!) -->
              <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                <!-- Zeile 1: Flug-Explorer & Volltextsuche -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="FLUG-EXPLORER:" Classes="label" FontSize="10.5" FontWeight="Bold" Foreground="#7E97AD" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding FlightSessions}"
                              SelectedItem="{Binding SelectedFlightSession}"
                              Width="260" Height="28" FontSize="11" />
                  </StackPanel>

                  <TextBox Grid.Column="2" Classes="search" Text="{Binding TimelineSearchText}" Watermark="Timeline durchsuchen…" Width="200" Height="28" VerticalAlignment="Center" />
                </Grid>

                <!-- Zeile 2: Schnelle Flug-Ereignis Filter Chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="chip" Content="Alle Ereignisse" Command="{Binding SelectTimelineFilterCommand}" CommandParameter="Alle"
                          Background="{Binding SelectedTimelineFilter, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
                  <Button Classes="chip" Content="🌀 Quantum" Command="{Binding SelectTimelineFilterCommand}" CommandParameter="Quantum"
                          Background="{Binding SelectedTimelineFilter, Converter={StaticResource FilterBg}, ConverterParameter=Quantum}" />
                  <Button Classes="chip" Content="🛸 Schiffe" Command="{Binding SelectTimelineFilterCommand}" CommandParameter="Schiffe"
                          Background="{Binding SelectedTimelineFilter, Converter={StaticResource FilterBg}, ConverterParameter=Schiffe}" />
                  <Button Classes="chip" Content="📍 Orte &amp; Landung" Command="{Binding SelectTimelineFilterCommand}" CommandParameter="Orte"
                          Background="{Binding SelectedTimelineFilter, Converter={StaticResource FilterBg}, ConverterParameter=Orte}" />
                  <Button Classes="chip" Content="💥 Vorfälle &amp; Verluste" Command="{Binding SelectTimelineFilterCommand}" CommandParameter="Verluste"
                          Background="{Binding SelectedTimelineFilter, Converter={StaticResource FilterBg}, ConverterParameter=Verluste}" />
                </StackPanel>
              </Grid>

              <!-- Timeline Items Liste -->
              <ListBox ItemsSource="{Binding TimelineView}"
                       SelectedItem="{Binding SelectedTimelineItem}"
                       Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="CornerRadius" Value="6" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#0F253E" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="m:FlightTimelineItem">
                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                      <Grid ColumnDefinitions="65,Auto,*,Auto">
                        
                        <!-- Spalte 0: Zeit & Relativzeit -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding FormattedTime}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" />
                          <TextBlock Text="{Binding RelativeTimeText}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="9.5" Foreground="#7E97AD" />
                        </StackPanel>

                        <!-- Spalte 1: Icon Badge mit Vektor-Wegpunkt-Faden -->
                        <Panel Grid.Column="1" Width="38" Margin="8,0,12,0">
                          <Rectangle Width="2" HorizontalAlignment="Center" Fill="#1E3855" Margin="0,-12,0,-12" />
                          <Border Background="#0D1B2A" BorderBrush="{Binding BadgeBorder}" BorderThickness="1.5" CornerRadius="17" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Panel>

                        <!-- Spalte 2: Titel, Subtitel & Details -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="#F0F6FC" />
                            <Border Background="#0D1B2A" BorderBrush="#1B3855" BorderThickness="1" CornerRadius="3" Padding="4,1" IsVisible="{Binding ShipName.Length}">
                              <TextBlock Text="{Binding ShipName}" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" IsVisible="{Binding Detail.Length}" />
                        </StackPanel>

                        <!-- Spalte 3: Distanz / Map Button -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                          <TextBlock Text="{Binding DistanceText}" Foreground="#818CF8" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" IsVisible="{Binding DistanceText.Length}" />
                          <Button Classes="ghost" Padding="6,2" CornerRadius="4" HorizontalAlignment="Right"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).JumpToTimelineLocationCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Diesen Wegpunkt auf der Starmap fokussieren"
                                  IsVisible="{Binding LocationName.Length}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="🗺" FontSize="10" />
                              <TextBlock Text="{Binding LocationName}" FontSize="10" Foreground="#38BDF8" />
                            </StackPanel>
                          </Button>
                        </StackPanel>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </DockPanel>
          </Border>

          <!-- Rechte Spalte: Detail-Inspektor & Session-Analysen (wie QuantumWake) -->
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              
              <!-- 1. Header -->
              <TextBlock Text="🛰  BLACK BOX DETAIL-INSPEKTOR" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="0.5" />

              <!-- 2. Selektiertes Ereignis Detail -->
              <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="AUSGEWÄHLTER FLUGWEGPUNKT" FontSize="9.5" FontWeight="Bold" Foreground="#8B949E" />
                  
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ereignis:" Foreground="#7E97AD" FontSize="11" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTimelineItem.TypeLabel, FallbackValue='Keine Auswahl'}" Foreground="#F0F6FC" FontWeight="Bold" FontSize="11" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Zeitstempel:" Foreground="#7E97AD" FontSize="11" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTimelineItem.FormattedTime, FallbackValue='—'}" Foreground="#F0F6FC" FontSize="11" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Standort:" Foreground="#7E97AD" FontSize="11" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTimelineItem.LocationName, FallbackValue='—'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Schiff:" Foreground="#7E97AD" FontSize="11" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTimelineItem.ShipName, FallbackValue='—'}" Foreground="#F0F6FC" FontSize="11" />
                  </Grid>

                  <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
                          Command="{Binding JumpToTimelineLocationCommand}"
                          CommandParameter="{Binding SelectedTimelineItem}"
                          IsEnabled="{Binding SelectedTimelineItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🗺" />
                      <TextBlock Text="Ort im großen Karten-Tab fokussieren" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>

              <!-- 3. Besuchte Himmelskörper -->
              <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="🪐  BESUCHTE HIMMELSKÖRPER" FontSize="10.5" FontWeight="Bold" Foreground="#F0F6FC" />
                    <Border Grid.Column="1" Background="#21262D" CornerRadius="4" Padding="5,1">
                      <TextBlock Text="{Binding FlightSummary.VisitedBodies.Count, StringFormat='{}{0} Zonen'}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
                    </Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding FlightSummary.VisitedBodies}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🪐" Foreground="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#F0F6FC" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 4. Eingesetzte Schiffe -->
              <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="🛸  EINGESETZTE SCHIFFE" FontSize="10.5" FontWeight="Bold" Foreground="#F0F6FC" />
                    <Border Grid.Column="1" Background="#21262D" CornerRadius="4" Padding="5,1">
                      <TextBlock Text="{Binding FlightSummary.UsedShips.Count, StringFormat='{}{0} Schiffe'}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
                    </Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding FlightSummary.UsedShips}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✈" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#F0F6FC" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Grid>
    </TabItem>

    <!-- Tab 6: RS Signal Decoder & Mining/Salvage Scanner -->
    <TabItem Header="{Binding I18n[Tab_OreScanner]}">
      <ScrollViewer Margin="0,10,0,0" Padding="0,0,14,100" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

          <!-- 1. Top HUD Control Strip: Große Signalanzeige + OCR & Overlay Actions -->
          <Border Classes="card" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              
              <!-- Links: Große Signal-Anzeige & Zifferneingabe -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Background="#0C1829" BorderBrush="#1E3A8A" BorderThickness="1.5" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="AKTIVES RADAR-SIGNAL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                    <TextBlock Text="{Binding CurrentRsDisplayValue}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" />
                  </StackPanel>
                </Border>

                <!-- Eingabefeld -->
                <StackPanel VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="RS-Ziffer manuell eingeben:" Foreground="#8B949E" FontSize="11" />
                  <Grid ColumnDefinitions="180,Auto">
                    <TextBox Grid.Column="0" Classes="path" Text="{Binding RsInputText}" Watermark="z.B. 7200, 14400, 3170" Height="32" FontSize="12" />
                    <Button Grid.Column="1" Classes="accent" Content="Entschlüsseln" Command="{Binding DecodeRsCommand}" CommandParameter="{Binding RsInputText}" Margin="8,0,0,0" Height="32" Padding="12,4" />
                  </Grid>
                </StackPanel>
              </StackPanel>

              <!-- Mitte: Schnellauswahl Presets -->
              <Border Grid.Column="1" Background="#0A101D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="14,0" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                  <TextBlock Text="Schnellauswahl gängiger Star Citizen 4.x Signaturen:" FontSize="10" Foreground="#64748B" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="chip" Content="3.170 (1x Quant)" Command="{Binding SetRsPresetCommand}" CommandParameter="3170" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="6.340 (2x Quant)" Command="{Binding SetRsPresetCommand}" CommandParameter="6340" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="7.200 (2x Bex/Lar)" Command="{Binding SetRsPresetCommand}" CommandParameter="7200" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="10.800 (3x Bex/Lar)" Command="{Binding SetRsPresetCommand}" CommandParameter="10800" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="14.400 (4x Bex/Lar)" Command="{Binding SetRsPresetCommand}" CommandParameter="14400" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="6.000 (3x Salvage)" Command="{Binding SetRsPresetCommand}" CommandParameter="6000" Margin="0,0,4,4" />
                    <Button Classes="chip" Content="8.000 (4x Salvage)" Command="{Binding SetRsPresetCommand}" CommandParameter="8000" Margin="0,0,4,4" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Rechts: OCR & In-Game Overlay Actions -->
              <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Padding="10,6" Command="{Binding TriggerRsOcrScanCommand}" ToolTip.Tip="Jetzt Ziffern auf dem Bildschirm via OCR scannen">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="⚡" FontSize="12" />
                      <TextBlock Text="OCR Scan" FontSize="11.5" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                  <ToggleButton Classes="ghost" Padding="10,6" IsChecked="{Binding IsRsAutoScanEnabled}" ToolTip.Tip="Automatischer kontinuierlicher Scan der RS-Signatur">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="👁" FontSize="12" />
                      <TextBlock Text="Auto-Scan" FontSize="11.5" />
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Classes="ghost" Padding="10,6" IsChecked="{Binding IsRsOverlayActive}" Command="{Binding ToggleRsOverlayCommand}" ToolTip.Tip="Verschiebbares In-Game HUD Overlay ein-/ausblenden">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🗔" FontSize="12" Foreground="#38BDF8" />
                      <TextBlock Text="Overlay" FontSize="11.5" Foreground="#38BDF8" FontWeight="Bold" />
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding RsOcrStatusText}" FontSize="10.5" Foreground="#7E97AD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1" Classes="ghost" Padding="6,2" Margin="0,0,6,0" Command="{Binding ToggleRsScanBoxCommand}" ToolTip.Tip="Scan-Rahmen (rosa Box) auf dem Bildschirm ein-/ausblenden">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="👁" FontSize="10" Foreground="{Binding RsScanBoxButtonFg}" />
                      <TextBlock Text="Box" FontSize="10" Foreground="{Binding RsScanBoxButtonFg}" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Classes="ghost" Padding="6,2" Command="{Binding CalibrateRsScanRegionCommand}" ToolTip.Tip="Bildschirmbereich für Ziffern auswählen">
                    <TextBlock Text="⛶ Bereich kalibrieren" FontSize="10" Foreground="#38BDF8" />
                  </Button>
                </Grid>
              </StackPanel>

            </Grid>
          </Border>

          <!-- 2. Scan-Ergebnis Details (2 Spalten: Bester Treffer Hero Card vs. Alle Alternativen) -->
          <Grid ColumnDefinitions="*,*">
            
            <!-- Linke Spalte: Bester Treffer Hero Card -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="label" Text="🛰  HAUPT-ERKENNUNGSERGEBNIS" />
                    <TextBlock Text="Das wahrscheinlichste Erz bzw. Vorkommen basierend auf Signalstärke &amp; Clusterlimits." Foreground="#8B949E" FontSize="11" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{Binding BestRsMatch.BadgeColor, FallbackValue='#334155'}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding BestRsMatch.Resource.Tier, StringFormat='Tier {0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                  </Border>
                </Grid>

                <!-- Wenn noch nichts gescannt wurde -->
                <Border Background="#0D1422" BorderBrush="#1C2F47" BorderThickness="1" CornerRadius="8" Padding="24" IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNull}}">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🛰" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="Warte auf Radar-Resonanzsignal…" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" HorizontalAlignment="Center" />
                    <TextBlock Text="Scanne im Schiff mit TAB (Ping) oder V (Scanner), tippe eine Zahl ein oder klicke auf ein Preset." Foreground="#8B949E" FontSize="11.5" HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Bester Treffer Details -->
                <Border Background="#0C1B30" BorderBrush="#1E40AF" BorderThickness="1.5" CornerRadius="8" Padding="14" IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding BestRsMatch.DisplayTitle}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="{Binding BestRsMatch.Subtitle}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding CurrentRsDisplayValue}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                      <!-- Beste Raffinerie -->
                      <Border Grid.Column="0" Background="#08101E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel Spacing="2">
                          <TextBlock Text="BESTE RAFFINERIE" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                          <TextBlock Text="{Binding BestRsMatch.BestRefineryText}" FontSize="12" FontWeight="Bold" Foreground="#4ADE80" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>

                      <!-- Ertrag / Wert -->
                      <Border Grid.Column="1" Background="#08101E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel Spacing="2">
                          <TextBlock Text="GESCHÄTZTER WERT" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                          <TextBlock Text="{Binding BestRsMatch.EstimatedValueText}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Base-RS & Nodes Information -->
                    <Border Background="#08101E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                      <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Basis-RS:" FontSize="10" Foreground="#64748B" />
                          <TextBlock Text="{Binding BestRsMatch.Resource.BaseRs, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Node-Anzahl:" FontSize="10" Foreground="#64748B" />
                          <TextBlock Text="{Binding BestRsMatch.Nodes, StringFormat='{}{0} Stück'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Genauigkeit:" FontSize="10" Foreground="#64748B" />
                          <TextBlock Text="{Binding BestRsMatch.IsExact, Converter={StaticResource ActiveBrush}}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>

            <!-- Rechte Spalte: Alle Treffer & Alternativen -->
            <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
              <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="📋  ALLE PASSENDEN RESSOURCEN / ALTERNATIVEN" />
                <TextBlock Text="Liste aller Erze oder Materialien, deren Signatur-Multiplikator zum aktuellen Signal passt." Foreground="#8B949E" FontSize="11" />

                <!-- Treffer-Liste -->
                <ItemsControl ItemsSource="{Binding CurrentRsMatches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:RsMatch">
                      <Border Background="#0A1220" BorderBrush="#1C2D44" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Resource.Tier}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                          </Border>
                          
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7E97AD" TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding BestRefineryText}" FontSize="10.5" Foreground="#4ADE80" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EstimatedValueText}" FontSize="10" Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" HorizontalAlignment="Right" />
                          </StackPanel>

                          <Border Grid.Column="3" Background="#162338" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="{Binding Resource.BaseRs, StringFormat='Base {0}'}" FontSize="9.5" Foreground="#38BDF8" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Keine alternativen Signaturen gefunden." Foreground="#64748B" FontSize="11" FontStyle="Italic"
                           IsVisible="{Binding CurrentRsMatches.Count, Converter={x:Static ObjectConverters.IsNull}}" />

              </StackPanel>
            </Border>

          </Grid>

          <!-- 3. 🏭 Raffinerie-Aufträge & Live-Timer -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Classes="label" Text="🏭  RAFFINERIE-AUFTRÄGE &amp; LIVE-TIMER" />
                  <TextBlock Text="Verwalte aktive Veredelungsaufträge. SCLogMate benachrichtigt dich per Toast, sobald dein Erz fertig veredelt ist." Foreground="#8B949E" FontSize="11" />
                </StackPanel>

                <!-- Neuen Veredelungsauftrag erfassen -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding AvailableRefineryStations}" SelectedItem="{Binding NewRefineryStation}" Width="190" Height="28" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding AvailableRefineryMaterials}" SelectedItem="{Binding NewRefineryMaterial}" Width="130" Height="28" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding AvailableRefineryMethods}" SelectedItem="{Binding NewRefineryMethod}" Width="210" Height="28" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding NewRefineryScu}" Minimum="1" Maximum="1000" Width="90" Height="28" VerticalAlignment="Center" FormatString="{}{0} SCU" />
                  <Button Classes="accent" Command="{Binding AddRefineryJobCommand}" Content="➕ Starten" Height="28" Padding="10,2" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <!-- Liste der aktiven Aufträge -->
              <ItemsControl ItemsSource="{Binding RefineryJobs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:RefineryJob">
                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                      <Grid ColumnDefinitions="220,140,*,Auto,Auto">
                        <!-- Station & Material -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Material, StringFormat='{}{0}'}" Foreground="#F0F6FC" FontWeight="Bold" FontSize="12" />
                          <TextBlock Text="{Binding Station}" Foreground="#8B949E" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Menge & Methode -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding OutputScu, StringFormat='{}{0} SCU Ertrag'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" />
                          <TextBlock Text="{Binding Method}" Foreground="#6E7681" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Fortschritt & Timer -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" Foreground="#8B949E" FontSize="10" />
                          </Grid>
                          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" CornerRadius="2"
                                       Foreground="#3FB950" Background="#161B22" />
                        </StackPanel>

                        <!-- Schätzwert -->
                        <Border Grid.Column="3" Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding EstimatedValueAuec, StringFormat='{}{0:N0} aUEC'}" Foreground="#3FB950" FontWeight="Bold" FontSize="11" />
                        </Border>

                        <!-- Aktionen -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Classes="ghost" Padding="6,2" CornerRadius="4"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CollectRefineryJobCommand}"
                                  CommandParameter="{Binding}" IsVisible="{Binding !IsCollected}" ToolTip.Tip="Als abgeholt markieren">
                            <TextBlock Text="✓ Abholen" FontSize="10.5" Foreground="#38BDF8" FontWeight="Bold" />
                          </Button>
                          <Button Classes="ghost" Padding="4,2" CornerRadius="4"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteRefineryJobCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Auftrag löschen">
                            <TextBlock Text="✕" FontSize="10" Foreground="#8B949E" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 4. Vollständige Star Citizen 4.x Signatur-Referenztabelle -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="📖  VOLLSTÄNDIGER STAR CITIZEN 4.x ERZ- &amp; SIGNATUR-KATALOG" />
              <TextBlock Text="Referenztabelle aller bekannten Schiffserze, Edelsteine und Salvage-Materialien mit ihren exakten Radar-Basissignaturen und Veredelungsempfehlungen." Foreground="#8B949E" FontSize="11" />

              <DataGrid ItemsSource="{Binding AllCatalogResources}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserSortColumns="True" HeadersVisibility="Column" MinHeight="260">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="MATERIAL / ERZ" Binding="{Binding Name}" Width="180" />
                  <DataGridTextColumn Header="TIER" Binding="{Binding Tier}" Width="80" />
                  <DataGridTextColumn Header="SELTENHEIT" Binding="{Binding Rarity}" Width="120" />
                  <DataGridTemplateColumn Header="BASIS-RS" Width="130" SortMemberPath="BaseRs">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="m:RsResource">
                        <TextBlock Text="{Binding BaseRs, StringFormat='{}{0:N0} RS'}" Foreground="#F59E0B" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, monospace" Margin="8,0" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="METHODE" Binding="{Binding Method}" Width="100" />
                  <DataGridTemplateColumn Header="Ø MARKTWERT / SCU" Width="160" SortMemberPath="EstimatedPricePerScu">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="m:RsResource">
                        <TextBlock Text="{Binding EstimatedPricePerScu, StringFormat='ca. {0:N0} aUEC'}" Foreground="#34D399" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas, monospace" Margin="8,0" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Tab 8: 📊 Markt (Commodity-Katalog & Detailansicht) -->
    <TabItem Header="{Binding I18n[Tab_Market]}">
      <DockPanel Margin="0,8,0,0">

        <!-- Modus 1: Markt-Katalog (Wenn Detailansicht geschlossen ist) -->
        <DockPanel IsVisible="{Binding !IsCommodityDetailOpen}">
          <!-- Filter-Leiste & Suche -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Content="Alle Waren" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Alle"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
              <Button Classes="chip" Content="Metalle" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Metalle"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Metalle}" />
              <Button Classes="chip" Content="Mineralien" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Mineralien"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Mineralien}" />
              <Button Classes="chip" Content="Bergung" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Bergung"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Bergung}" />
              <Button Classes="chip" Content="Gase" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Gase"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Gase}" />
              <Button Classes="chip" Content="Medizin" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Medizin"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Medizin}" />
              <Button Classes="chip" Content="Suchtmittel" Command="{Binding SetMarketCategoryFilterCommand}" CommandParameter="Suchtmittel"
                      Background="{Binding MarketCategoryFilter, Converter={StaticResource FilterBg}, ConverterParameter=Suchtmittel}" />
            </StackPanel>

            <Panel Grid.Column="1" Width="180" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
              <TextBox Classes="search" Text="{Binding MarketSearchText}" Watermark="Ware oder Kategorie suchen…" VerticalAlignment="Center" Height="28" />
              <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
            </Panel>

            <!-- UEX Status & Aktualisieren Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="8,4"
                      ToolTip.Tip="Stand der UEX CORP Marktpreise (Cache: 1 Stunde)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" />
                  <TextBlock Text="UEX Stand:" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding UexMarketLastUpdatedText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button Classes="chip" Command="{Binding RefreshUexMarketDataCommand}" IsEnabled="{Binding !IsFetchingUexMarket}"
                      ToolTip.Tip="Marktpreise von UEX CORP jetzt neu abrufen"
                      Padding="8,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="Aktualisieren" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Waren-Katalog Tabelle -->
          <Border Classes="card" Padding="0">
            <DataGrid ItemsSource="{Binding MarketEntriesView}" IsReadOnly="True"
                      CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Handelsware" Binding="{Binding Name}" Width="180" Foreground="#F0F6FC" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="130" Foreground="#A78BFA" />
                <DataGridTextColumn Header="Bester Verkauf (UEX)" Binding="{Binding BestSellPriceFormatted}" Width="150"
                                    Foreground="#4ADE80" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Bester Einkauf (UEX)" Binding="{Binding BestBuyPriceFormatted}" Width="150"
                                    Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Max. Marge" Binding="{Binding MarginFormatted}" Width="130"
                                    Foreground="#38BDF8" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Eigene Trades" Binding="{Binding UserTradesCountText}" Width="110" Foreground="#CBD5E1" />
                <DataGridTextColumn Header="Eigener Umsatz" Binding="{Binding UserRevenueFormatted}" Width="140"
                                    Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" />
                <DataGridTemplateColumn Header="Aktion" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="m:MarketCommodityEntry">
                      <Button Classes="ghost" Content="🔍 Detail" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenCommodityDetailCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>

        <!-- Modus 2: Deep-Linkable Einzel-Warenansicht (Commodity Detail) -->
        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsCommodityDetailOpen}">
          <StackPanel Spacing="14">
            <!-- Header-Leiste mit Zurück-Button -->
            <Border Classes="card" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Classes="ghost" Content="← Zurück zum Markt" Padding="8,4" FontSize="11"
                          Command="{Binding CloseCommodityDetailCommand}" />
                  <Separator Margin="4,0" Width="1" Height="20" Background="#1C324A" />
                  <TextBlock Text="{Binding SelectedMarketCommodity.Name}" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                  <Border Background="#1A1033" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedMarketCommodity.Category}" Foreground="#C084FC" FontSize="10.5" FontWeight="Bold" />
                  </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Background="#061810" BorderBrush="#1C5E35" BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="UEX LIVE PREISE" Foreground="#4ADE80" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                      <TextBlock Text="·" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding UexMarketLastUpdatedText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- 5 KPI HUD Cards -->
            <Grid ColumnDefinitions="*,*,*,*,*">
              <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="BESTER VERKAUF" />
                  <TextBlock Classes="value" Text="{Binding SelectedCommodityBestSellText}" Foreground="#4ADE80" />
                  <TextBlock Text="Höchster Abnahmepreis" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Margin="5,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="BESTER EINKAUF" />
                  <TextBlock Classes="value" Text="{Binding SelectedCommodityBestBuyText}" Foreground="#F59E0B" />
                  <TextBlock Text="Günstigste Bezugsquelle" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card" Margin="5,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="MAX. MARGE" />
                  <TextBlock Classes="value" Text="{Binding SelectedCommodityMarginText}" Foreground="#38BDF8" />
                  <TextBlock Text="Gewinnspanne / SCU" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="card" Margin="5,0,5,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="EIGENE MENGE" />
                  <TextBlock Classes="value" Text="{Binding SelectedCommoditySoldText}" Foreground="#C084FC" />
                  <TextBlock Text="Gehandeltes Frachtvolumen" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="card" Margin="5,0,0,0">
                <StackPanel>
                  <TextBlock Classes="label" Text="EIGENER UMSATZ" />
                  <TextBlock Classes="value" Text="{Binding SelectedCommodityRevenueText}" Foreground="#FBBF24" />
                  <TextBlock Text="Gesamterlös aus Verkäufen" Foreground="#6E8498" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 1. Handels-Terminals & Schalter (Wer kauft / Wer führt) -->
            <Border Classes="card" Padding="0">
              <StackPanel>
                <Border Padding="14,10" BorderBrush="#1C324A" BorderThickness="0,0,0,1" Background="#0A1422">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🏪" FontSize="14" />
                      <TextBlock Classes="label" Text="HANDELS-TERMINALS &amp; PREISE (POLIZEI- &amp; GESETZLOSER RAUM)" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Live Datenabgleich" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <DataGrid ItemsSource="{Binding SelectedCommodityTerminals}" IsReadOnly="True"
                          CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" Height="280">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Terminal / Station" Binding="{Binding Terminal}" Width="*" Foreground="#F0F6FC" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="System" Binding="{Binding System}" Width="90" Foreground="#38BDF8" />
                    <DataGridTextColumn Header="Standort" Binding="{Binding Location}" Width="160" Foreground="#94A3B8" />
                    <DataGridTextColumn Header="Aktion" Binding="{Binding Type}" Width="110" Foreground="#CBD5E1" />
                    <DataGridTextColumn Header="Preis" Binding="{Binding PriceFormatted}" Width="130"
                                        Foreground="#4ADE80" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Differenz" Binding="{Binding DiffFormatted}" Width="110"
                                        Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" />
                    <DataGridTextColumn Header="Vorrat / Nachfrage" Binding="{Binding StockText}" Width="140" Foreground="#CBD5E1" />
                    <DataGridTemplateColumn Header="Sicherheit" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:CommodityTerminalRow">
                          <Border Background="#0A1422" BorderBrush="{Binding SecurityBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{Binding SecurityStatus}" Foreground="{Binding SecurityBrush}" FontSize="10" FontWeight="Bold" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <!-- 2. Eigene Belege / Historie für diese Ware -->
            <Border Classes="card" Padding="0">
              <StackPanel>
                <Border Padding="14,10" BorderBrush="#1C324A" BorderThickness="0,0,0,1" Background="#0A1422">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🧾" FontSize="14" />
                    <TextBlock Classes="label" Text="EIGENE TRANSAKTIONS-BELEGE FÜR DIESE WARE" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding SelectedCommodityReceipts}" IsReadOnly="True"
                          CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" Height="220">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="130" />
                    <DataGridTemplateColumn Header="Aktion" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:CargoTradeRecord">
                          <Border Background="{Binding ActionColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{Binding ActionText}" Foreground="#050811" FontSize="10" FontWeight="Bold" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Menge" Binding="{Binding ScuFormatted}" Width="100" Foreground="#F59E0B"
                                        FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Gesamtpreis" Binding="{Binding TotalPriceFormatted}" Width="130"
                                        FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Preis / SCU" Binding="{Binding PricePerScuFormatted}" Width="120"
                                        Foreground="#94A3B8" FontFamily="Cascadia Code, Consolas, monospace" />
                    <DataGridTextColumn Header="Standort / Terminal" Binding="{Binding Where}" Width="*" Foreground="#CBD5E1" />
                    <DataGridTextColumn Header="Schiff" Binding="{Binding Ship}" Width="130" Foreground="#A78BFA" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

    <!-- Tab 9: Flotten- & Hangar-Verzeichnis -->
    <TabItem Header="{Binding I18n[Tab_Fleet]}">
      <DockPanel Margin="0,8,0,0">

        <!-- Header: Statistik, Filter-Chips & Suche -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          
          <!-- Banner mit Hangar / Historie Switcher, Schiff-Zuweisung & Statistiken -->
          <Border Classes="card" Padding="12,10">
            <StackPanel Spacing="10">
              
              <!-- Zeile 1: Navigation + Schiff hinzufügen (Links) & Statistiken (Rechts) -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Links: Mein Hangar vs Flug-Historie & Schiff-Hinzufügen -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <!-- Segmented Control: Hangar vs. Historie -->
                  <Border Background="#050C16" BorderBrush="#14263B" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Button Classes="ghost" Padding="12,5" CornerRadius="6"
                              Command="{Binding SelectFleetViewModeCommand}" CommandParameter="Hangar"
                              Background="{Binding SelectedFleetViewMode, Converter={StaticResource SegmentBg}, ConverterParameter=Hangar}"
                              BorderBrush="{Binding SelectedFleetViewMode, Converter={StaticResource SegmentBorder}, ConverterParameter=Hangar}"
                              BorderThickness="1"
                              ToolTip.Tip="Zeigt nur Schiffe in deinem persönlichen Hangar-Besitz">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <TextBlock Text="🏠" FontSize="12" VerticalAlignment="Center" />
                          <TextBlock Text="Mein Hangar" FontWeight="SemiBold" FontSize="11.5"
                                     Foreground="{Binding SelectedFleetViewMode, Converter={StaticResource FilterFg}, ConverterParameter=Hangar}"
                                     VerticalAlignment="Center" />
                          <Border Background="#06121E" BorderBrush="#1B3855" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HangarShipCount}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                          </Border>
                        </StackPanel>
                      </Button>

                      <Button Classes="ghost" Padding="12,5" CornerRadius="6"
                              Command="{Binding SelectFleetViewModeCommand}" CommandParameter="Alle"
                              Background="{Binding SelectedFleetViewMode, Converter={StaticResource SegmentBg}, ConverterParameter=Alle}"
                              BorderBrush="{Binding SelectedFleetViewMode, Converter={StaticResource SegmentBorder}, ConverterParameter=Alle}"
                              BorderThickness="1"
                              ToolTip.Tip="Zeigt alle jemals in den Logs geflogenen Schiffe (inkl. Free Fly, Miete, geliehen)">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <TextBlock Text="✈" FontSize="12" VerticalAlignment="Center" />
                          <TextBlock Text="Flug-Historie" FontWeight="SemiBold" FontSize="11.5"
                                     Foreground="{Binding SelectedFleetViewMode, Converter={StaticResource FilterFg}, ConverterParameter=Alle}"
                                     VerticalAlignment="Center" />
                          <Border Background="#06121E" BorderBrush="#1B3855" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AllFlownShipCount}" Foreground="#8B949E" FontSize="10" FontWeight="Bold" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>

                  <Rectangle Width="1" Height="22" Fill="#16283C" Margin="2,0" VerticalAlignment="Center" />

                  <!-- Schiff manuell zum Hangar hinzufügen (Flyout) -->
                  <Button Classes="ghost" Padding="10,5" CornerRadius="6" VerticalAlignment="Center"
                          ToolTip.Tip="Schiff aus dem Gesamtkatalog zu deinem Hangar hinzufügen">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Background="#091422" BorderBrush="#1C3D5E" BorderThickness="1" CornerRadius="8" Padding="14" Width="320">
                          <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Border Background="#0C253D" BorderBrush="#1A4A73" BorderThickness="1" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center">
                                <TextBlock Text="+" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                              </Border>
                              <TextBlock Text="Schiff zu Hangar hinzufügen" FontSize="12.5" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Wähle ein Schiff aus dem Katalog, um es als Hangar-Besitz zu erfassen:"
                                       FontSize="11" Foreground="#7E97AD" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding AllCatalogShips}" SelectedItem="{Binding SelectedCatalogShipToAdd}"
                                      HorizontalAlignment="Stretch" Height="32" PlaceholderText="Schiff wählen...">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:ShipCatalogEntry">
                                  <TextBlock Text="{Binding NormalizedName}" FontSize="11.5" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="accent" HorizontalAlignment="Stretch" Height="30" CornerRadius="6"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding AddSelectedCatalogShipToHangarCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="In Hangar aufnehmen" FontSize="11.5" FontWeight="SemiBold" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Border>
                      </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Background="#0C253D" BorderBrush="#1A4A73" BorderThickness="1" CornerRadius="4" Width="18" Height="18" VerticalAlignment="Center">
                        <TextBlock Text="+" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                      <TextBlock Text="Schiff hinzufügen" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- Rechts: Flottenwert & Flug-Statistiken Telemetrie-Cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <!-- Gesamtwert Pill -->
                  <Border Background="#051C12" BorderBrush="#144C2E" BorderThickness="1" CornerRadius="8" Padding="10,4"
                          ToolTip.Tip="Geschätzter aUEC In-Game Marktwert">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="#3FB950" VerticalAlignment="Center" />
                      <TextBlock Text="WERT" FontSize="9.5" FontWeight="Bold" Foreground="#3FB950" LetterSpacing="0.5" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TotalFleetValueText}" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- Pledge Wert Pill -->
                  <Border Background="#1C1402" BorderBrush="#684507" BorderThickness="1" CornerRadius="8" Padding="10,4"
                          ToolTip.Tip="Echtgeld-Pledgewert aller Pledge-Store Schiffe">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                      <TextBlock Text="PLEDGE" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" LetterSpacing="0.5" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TotalFleetPledgeUsdText}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- Flüge Pill -->
                  <Border Background="#051524" BorderBrush="#123B60" BorderThickness="1" CornerRadius="8" Padding="10,4"
                          ToolTip.Tip="Gesamtzahl dokumentierter Flug-Starts">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="#38BDF8" VerticalAlignment="Center" />
                      <TextBlock Text="FLÜGE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="0.5" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TotalFleetFlights, StringFormat='{}{0:N0}'}" Foreground="#7DD3FC" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- QT Sprünge Pill -->
                  <Border Background="#140A28" BorderBrush="#3B1C70" BorderThickness="1" CornerRadius="8" Padding="10,4"
                          ToolTip.Tip="Erfolgreich durchgeführte Quantum Travel Sprünge">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="#A78BFA" VerticalAlignment="Center" />
                      <TextBlock Text="QUANTUM" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" LetterSpacing="0.5" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TotalFleetQuantumJumps, StringFormat='{}{0:N0}'}" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- Zeile 2: Filter-Chips (Links) und Suche (Rechts) -->
              <Grid ColumnDefinitions="*,Auto">
                
                <!-- Filter-Chips für Herkunft & Hersteller -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <!-- Herkunft -->
                    <Button Classes="chip" Content="Alle Typen" Command="{Binding SelectFleetAcquisitionCommand}" CommandParameter="Alle"
                            Background="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBg}, ConverterParameter=Alle}"
                            BorderBrush="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBorder}, ConverterParameter=Alle}"
                            Foreground="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterFg}, ConverterParameter=Alle}" />
                    <Button Classes="chip" Content="💵 Pledge" Command="{Binding SelectFleetAcquisitionCommand}" CommandParameter="Pledge Store"
                            Background="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBg}, ConverterParameter=Pledge Store}"
                            BorderBrush="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBorder}, ConverterParameter=Pledge Store}"
                            Foreground="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterFg}, ConverterParameter=Pledge Store}" />
                    <Button Classes="chip" Content="🪙 In-Game" Command="{Binding SelectFleetAcquisitionCommand}" CommandParameter="In-Game (aUEC)"
                            Background="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBg}, ConverterParameter=In-Game (aUEC)}"
                            BorderBrush="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBorder}, ConverterParameter=In-Game (aUEC)}"
                            Foreground="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterFg}, ConverterParameter=In-Game (aUEC)}" />
                    <Button Classes="chip" Content="🎟 Miete" Command="{Binding SelectFleetAcquisitionCommand}" CommandParameter="Miete (Rental)"
                            Background="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBg}, ConverterParameter=Miete (Rental)}"
                            BorderBrush="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterBorder}, ConverterParameter=Miete (Rental)}"
                            Foreground="{Binding SelectedFleetAcquisition, Converter={StaticResource FilterFg}, ConverterParameter=Miete (Rental)}" />

                    <Rectangle Width="1" Height="18" Fill="#182E47" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Hersteller -->
                    <Button Classes="chip" Content="Alle Marken" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="Alle"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=Alle}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=Alle}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=Alle}" />
                    <Button Classes="chip" Content="Drake" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="DRAKE"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=DRAKE}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=DRAKE}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=DRAKE}" />
                    <Button Classes="chip" Content="Aegis" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="AEGIS"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=AEGIS}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=AEGIS}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=AEGIS}" />
                    <Button Classes="chip" Content="Crusader" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="CRUSADER"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=CRUSADER}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=CRUSADER}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=CRUSADER}" />
                    <Button Classes="chip" Content="Anvil" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="ANVIL"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=ANVIL}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=ANVIL}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=ANVIL}" />
                    <Button Classes="chip" Content="RSI" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="RSI"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=RSI}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=RSI}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=RSI}" />
                    <Button Classes="chip" Content="MISC" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="MISC"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=MISC}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=MISC}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=MISC}" />
                    <Button Classes="chip" Content="Origin" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="ORIGIN"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=ORIGIN}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=ORIGIN}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=ORIGIN}" />
                    <Button Classes="chip" Content="Argo" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="ARGO"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=ARGO}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=ARGO}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=ARGO}" />
                    <Button Classes="chip" Content="Mirai" Command="{Binding SelectFleetManufacturerCommand}" CommandParameter="MIRAI"
                            Background="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBg}, ConverterParameter=MIRAI}"
                            BorderBrush="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterBorder}, ConverterParameter=MIRAI}"
                            Foreground="{Binding SelectedFleetManufacturer, Converter={StaticResource FilterFg}, ConverterParameter=MIRAI}" />
                  </StackPanel>
                </ScrollViewer>

                <!-- Schnellsuche mit 🔎 Icon und Clear Button -->
                <Panel Grid.Column="1" Width="230" Height="28" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBox Classes="search" Text="{Binding FleetSearchText}" Watermark="Schiff, Rolle, Marke..." VerticalAlignment="Center" Height="28" />
                  <TextBlock Text="🔎" FontSize="11" Foreground="#7E97AD" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                  <Button Classes="ghost" Padding="4,1" Margin="0,0,4,0" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Command="{Binding ClearFleetSearchCommand}" IsVisible="{Binding FleetSearchText.Length}"
                          Content="✕" FontSize="10" Foreground="#7E97AD" ToolTip.Tip="Suche zurücksetzen" />
                </Panel>
              </Grid>

            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Aufgeräumte Tabelle / Flottenübersicht -->
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding FleetView}" IsReadOnly="True"
                    CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              
              <!-- 1. Hangar & Status Pill -->
              <DataGridTemplateColumn Header="STATUS &amp; HANGAR" Width="125" SortMemberPath="IsInHangar">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4,0,4" VerticalAlignment="Center">
                      <!-- Status Pill -->
                      <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="10" Padding="6,2"
                              IsVisible="{Binding IsCurrent}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <Ellipse Width="5" Height="5" Fill="#3FB950" VerticalAlignment="Center" />
                          <TextBlock Text="AKTIV" Foreground="#3FB950" FontWeight="Bold" FontSize="10" />
                        </StackPanel>
                      </Border>
                      <Border Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" CornerRadius="10" Padding="6,2"
                              IsVisible="{Binding !IsCurrent}">
                        <TextBlock Text="{Binding HangarStatusText}" Foreground="#7E97AD" FontWeight="SemiBold" FontSize="10" />
                      </Border>

                      <!-- Toggle Hangar Button -->
                      <Button Classes="ghost" Padding="4,1" CornerRadius="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                              Command="{Binding ((vm:MainViewModel)DataContext).ToggleShipHangarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding HangarTooltip}">
                        <TextBlock Text="{Binding HangarStarText}" Foreground="{Binding HangarStarColor}" FontSize="11" FontWeight="Bold" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 2. Schiff & Hersteller -->
              <DataGridTemplateColumn Header="SCHIFF &amp; HERSTELLER" Width="225" SortMemberPath="Name">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <StackPanel Spacing="1" Margin="8,4,0,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F0F6FC" FontSize="12" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#161B22" BorderBrush="{Binding ManufacturerColor}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                          <TextBlock Text="{Binding ManufacturerBadge}" Foreground="{Binding ManufacturerColor}" FontSize="9" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Manufacturer}" Foreground="#8B949E" FontSize="10.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 3. Herkunft & Pledge-Wert (Klickbar zum Wechseln & Editieren) -->
              <DataGridTemplateColumn Header="HERKUNFT / PLEDGE" Width="200" SortMemberPath="AcquisitionType">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                      <!-- Standard-Ansicht -->
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsEditingPledge}">
                        <Button Classes="ghost" Padding="6,2" CornerRadius="6"
                                Command="{Binding ((vm:MainViewModel)DataContext).CycleShipAcquisitionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="#060C16" BorderBrush="#1C3857" BorderThickness="1"
                                ToolTip.Tip="Klicken zum Durchschalten: 💵 Pledge Store ➔ 🪙 In-Game Kauf ➔ 🎟 Miete ➔ 👥 Geliehen">
                          <TextBlock Text="{Binding PledgeValueText}" Foreground="{Binding PledgeBadgeColor}" FontSize="10.5" FontWeight="SemiBold" />
                        </Button>
                        <Button Classes="ghost" Padding="4,2" CornerRadius="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                Command="{Binding ((vm:MainViewModel)DataContext).StartEditShipPledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsPledgeBought}"
                                ToolTip.Tip="💵 Pledge-Preis ($) manuell anpassen (z. B. CCU oder Upgrade-Wert)">
                          <TextBlock Text="✎" FontSize="10" Foreground="#F59E0B" />
                        </Button>
                      </StackPanel>

                      <!-- Inline-Editor für Pledge-Dollar-Wert -->
                      <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsEditingPledge}">
                        <TextBlock Text="$" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                        <TextBox Classes="path" Text="{Binding PledgeInputText}" Width="65" Height="24" FontSize="10.5" Padding="4,1" VerticalAlignment="Center" />
                        <Button Classes="accent" Padding="5,2" Height="24" CornerRadius="3"
                                Command="{Binding ((vm:MainViewModel)DataContext).SaveShipPledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Speichern">
                          <TextBlock Text="✓" FontSize="10" FontWeight="Bold" />
                        </Button>
                        <Button Classes="ghost" Padding="5,2" Height="24" CornerRadius="3" Background="#21262D"
                                Command="{Binding ((vm:MainViewModel)DataContext).CancelEditShipPledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Abbrechen">
                          <TextBlock Text="✕" FontSize="9" Foreground="#8B949E" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 3. Rolle & Einsatzbereich -->
              <DataGridTemplateColumn Header="ROLLE / TYP" Width="180" SortMemberPath="Role">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <TextBlock Text="{Binding Role}" Foreground="#38BDF8" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 4. Erwerb & Pledge-Wert -->
              <DataGridTemplateColumn Header="HERKUNFT &amp; PLEDGE" Width="150" SortMemberPath="PledgeValueUsd">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <Border Background="#0D1B2A" BorderBrush="{Binding PledgeBadgeColor}" BorderThickness="1"
                            CornerRadius="4" Padding="6,2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PledgeValueText}" Foreground="{Binding PledgeBadgeColor}" FontWeight="SemiBold" FontSize="10.5" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 5. Versicherung -->
              <DataGridTemplateColumn Header="VERSICHERUNG" Width="135" SortMemberPath="InsuranceType">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <TextBlock Text="{Binding InsuranceType}" Foreground="#8B949E" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="11" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 6. Flug-Statistiken -->
              <DataGridTemplateColumn Header="EINSÄTZE" Width="140" SortMemberPath="FlightCount">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <StackPanel Spacing="1" Margin="8,4,0,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding FlightCountText}" FontWeight="SemiBold" FontSize="11" Foreground="#F0F6FC" />
                      <TextBlock Text="{Binding QuantumJumpsText}" FontSize="10" Foreground="#8B949E" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 7. Aktionen -->
              <DataGridTemplateColumn Header="AKTIONEN" Width="*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="m:ShipFleetItem">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,4,0" VerticalAlignment="Center">
                      <Button Classes="ghost" Padding="4,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                              Command="{Binding ((vm:MainViewModel)DataContext).OpenShipWikiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" ToolTip.Tip="Star Citizen Wiki öffnen">
                        <TextBlock Text="📖" FontSize="10" Foreground="#38BDF8" />
                      </Button>
                      <Button Classes="ghost" Padding="4,2" CornerRadius="4" Background="#060C16" BorderBrush="#1A3047" BorderThickness="1"
                              Command="{Binding ((vm:MainViewModel)DataContext).OpenShipUexCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" ToolTip.Tip="UEX Händlerpreise prüfen">
                        <TextBlock Text="🌐" FontSize="10" Foreground="#FBBF24" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </DataGrid.Columns>
          </DataGrid>
        </Border>

      </DockPanel>
    </TabItem>

    <!-- Tab 6: Bauplan-Datenbank -->
    <TabItem Header="{Binding I18n[Tab_Blueprints]}">
      <DockPanel Margin="0,8,0,0">

        <!-- Header: Statistik, Filter-Chips & Suche -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          
          <!-- Banner mit Fortschritt & Suche -->
          <Border Classes="card" Padding="14,10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto,240">
                
                <!-- Titel & Gesamt -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="🛠  CRAFTING-BAUPLÄNE" Classes="label" VerticalAlignment="Center" />
                  <Border Background="#21262D" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalBlueprintsCount, StringFormat='{}{0:N0} Gesamt'}" Foreground="#58A6FF" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>

                <!-- Fortschritts-Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                  <!-- Erlernt Pill -->
                  <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="10" Padding="8,2.5">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="6" Height="6" Fill="#3FB950" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding LearnedBlueprintsCount, StringFormat='{}{0:N0} Erlernt'}" Foreground="#3FB950" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                  </Border>

                  <!-- Fehlt Pill -->
                  <Border Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" CornerRadius="10" Padding="8,2.5">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="6" Height="6" Fill="#7E97AD" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding MissingBlueprintsCount, StringFormat='{}{0:N0} Fehlen'}" Foreground="#7E97AD" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>

                  <!-- Prozent Badge -->
                  <Border Background="#1D6FA5" CornerRadius="4" Padding="6,2.5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BlueprintProgressPercent, StringFormat='{}{0:F1}%'}" Foreground="White" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>

                <!-- Schnellsuche -->
                <TextBox Grid.Column="3" Classes="path" Height="30" Text="{Binding BlueprintSearchText}"
                         Watermark="🔍 Bauplan, Ressource, Typ..." VerticalAlignment="Center" />
              </Grid>

              <!-- Visuelle Fortschrittsleiste -->
              <ProgressBar Value="{Binding BlueprintProgressPercent}" Maximum="100" Height="6" CornerRadius="3"
                           Foreground="#34D399" Background="#060C16" />
            </StackPanel>
          </Border>

          <!-- Filter-Chips -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Content="Alle" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Alle"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Alle}" />
              <Button Classes="chip" Content="✓ Erlernt" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Erlernt"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Erlernt}" />
              <Button Classes="chip" Content="✕ Fehlt" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Fehlend"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Fehlend}" />
              <Button Classes="chip" Content="⚔ Waffen" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Waffen"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Waffen}" />
              <Button Classes="chip" Content="🛡 Rüstung" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Rüstung"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Rüstung}" />
              <Button Classes="chip" Content="⚙ Komponenten" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Komponenten"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Komponenten}" />
              <Button Classes="chip" Content="🔋 Munition" Command="{Binding SelectBlueprintCategoryCommand}" CommandParameter="Munition"
                      Background="{Binding SelectedBlueprintCategory, Converter={StaticResource FilterBg}, ConverterParameter=Munition}" />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>

        <!-- Aufgeräumte Tabelle der Baupläne -->
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding BlueprintsView}" IsReadOnly="True"
                    CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              
              <!-- 1. Status Pill & Datum -->
              <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="IsLearned">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:BlueprintItem">
                    <StackPanel Margin="8,4,0,4" VerticalAlignment="Center" Spacing="2">
                      <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="1"
                              CornerRadius="10" Padding="7,2" HorizontalAlignment="Left" ToolTip.Tip="{Binding LearnedDateText}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Ellipse Width="5.5" Height="5.5" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding StatusTextShort}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="10.5" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding LearnedDateShort}" Foreground="#8B949E" FontSize="9" IsVisible="{Binding IsLearned}" Margin="2,0,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 2. Bauplan & Kategorie -->
              <DataGridTemplateColumn Header="BAUPLAN &amp; KATEGORIE" Width="280" SortMemberPath="Name">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:BlueprintItem">
                    <StackPanel Spacing="1" Margin="8,4,0,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F0F6FC" FontSize="12" />
                      <TextBlock Text="{Binding CategoryBadge}" Foreground="#8B949E" FontSize="10.5" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 3. Benötigte Ressourcen -->
              <DataGridTemplateColumn Header="BENÖTIGTE RESSOURCEN" Width="*" SortMemberPath="RequiredMaterials">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:BlueprintItem">
                    <TextBlock Text="{Binding RequiredMaterials}" Foreground="#22D3EE" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 4. Herkunft / Freischaltung -->
              <DataGridTemplateColumn Header="HERKUNFT / FREISCHALTUNG" Width="230" SortMemberPath="UnlockInfo">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:BlueprintItem">
                    <TextBlock Text="{Binding UnlockInfo}" Foreground="#C9D1D9" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 5. Wiki Info Button -->
              <DataGridTemplateColumn Header="WIKI" Width="85">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:BlueprintItem">
                    <Button Classes="ghost" Padding="6,2" CornerRadius="4" VerticalAlignment="Center" Margin="4,0,4,0"
                            Command="{Binding ((vm:MainViewModel)DataContext).OpenWikiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Name}">
                      <TextBlock Text="📖 Info" FontSize="10.5" Foreground="#58A6FF" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </DataGrid.Columns>
          </DataGrid>
        </Border>

      </DockPanel>
    </TabItem>

    <!-- Tab 5: Piloten-Ausrüstung & Loadout -->
    <TabItem Header="{Binding I18n[Tab_Loadout]}">
      <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          
          <!-- Banner mit Rüstungs- & Umgebungs-Stats + Export-Buttons -->
          <Border Classes="card" Padding="14,12">
            <StackPanel Spacing="10">
              
              <!-- Zeile 1: Header + Export-Aktionen -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="🥋  PILOTEN-AUSRÜSTUNG &amp; LOADOUT" Classes="label" VerticalAlignment="Center" />
                  <Border Background="#21262D" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="11 Slots" Foreground="#58A6FF" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>

                <!-- Export & Share Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="ghost" Padding="8,4" CornerRadius="5"
                          Command="{Binding CopyLoadoutToClipboardCommand}"
                          ToolTip.Tip="Ausrüstung als Text für Discord / Flotten-Briefing kopieren">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="📋" FontSize="11" />
                      <TextBlock Text="In Zwischenablage" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>

                  <Button Classes="ghost" Padding="8,4" CornerRadius="5"
                          Command="{Binding ExportLoadoutMarkdownCommand}"
                          ToolTip.Tip="Detaillierten Ausrüstungs-Report als Markdown (.md) speichern">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="📄" FontSize="11" Foreground="#38BDF8" />
                      <TextBlock Text="Export Markdown" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Zeile 2: Kombinierte Rüstungs-, Temperatur- & Waffen-Pills -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <!-- Rüstungsschutz Pill -->
                  <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="10" Padding="9,3"
                          ToolTip.Tip="Durchschnittliche Schadensreduktion aller angelegten Rüstungsteile">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="🛡️" FontSize="11" />
                      <TextBlock Text="{Binding AverageArmorReductionText, StringFormat='Schutz: {0}'}" Foreground="#3FB950" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                  </Border>

                  <!-- Umgebungsschutz Pill -->
                  <Border Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" CornerRadius="10" Padding="9,3"
                          ToolTip.Tip="Temperaturbereich, in dem die aktuelle Rüstung / der Anzug überlebt">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="❄️🌡️" FontSize="11" />
                      <TextBlock Text="{Binding CombinedTempResistText, StringFormat='Temperatur: {0}'}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                  </Border>

                  <!-- Rucksack-Kapazität Pill -->
                  <Border Background="#1A1500" BorderBrush="#855B00" BorderThickness="1" CornerRadius="10" Padding="9,3"
                          ToolTip.Tip="Gesamtes Rucksack- und Taschen-Inventarvolumen">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="🎒" FontSize="11" />
                      <TextBlock Text="{Binding TotalBackpackCapacityText, StringFormat='Kapazität: {0}'}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                  </Border>

                  <!-- Waffen Pill -->
                  <Border Background="#16080E" BorderBrush="#5E1C2E" BorderThickness="1" CornerRadius="10" Padding="9,3"
                          ToolTip.Tip="Ausgerüstete Primär- &amp; Sekundärwaffen">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="⚔️" FontSize="11" />
                      <TextBlock Text="{Binding EquippedWeaponsSummaryText}" Foreground="#F87171" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

            </StackPanel>
          </Border>

          <!-- 11 Slots Grid (Armor, Weapons, Utility) -->
          <ItemsControl ItemsSource="{Binding PilotLoadoutSlots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:LoadoutItem">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Width="360" Margin="0,0,12,12">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <!-- Kopfzeile: Icon, Slot-Name & Letzte Sichtung -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SlotName}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding LastObservedText}" Foreground="#8B949E" FontSize="9.5" VerticalAlignment="Center" />
                    </Grid>
                    
                    <!-- Gegenstands-Name -->
                    <TextBlock Grid.Row="1" Text="{Binding ItemName}" FontSize="13" FontWeight="Bold"
                               Foreground="#F0F6FC"
                               TextTrimming="CharacterEllipsis" Margin="0,6,0,4" />

                    <!-- Rüstungsklasse, Schadensschutz & Temperatur -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,2,0,4" IsVisible="{Binding IsEquipped}">
                      <!-- Rüstungsklasse Badge -->
                      <Border Background="#0D1117" BorderBrush="{Binding BadgeColor}" BorderThickness="1" CornerRadius="4" Padding="5,1.5"
                              IsVisible="{Binding ArmorClass, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ArmorClass}" Foreground="{Binding BadgeColor}" FontSize="9.5" FontWeight="Bold" />
                      </Border>

                      <!-- Schadensreduktion Badge -->
                      <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="4" Padding="5,1.5"
                              IsVisible="{Binding DamageReductionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding DamageReductionText}" Foreground="#3FB950" FontSize="9.5" FontWeight="Bold" />
                      </Border>

                      <!-- Temperatur Pill -->
                      <Border Background="#060C16" BorderBrush="#1A3047" BorderThickness="1" CornerRadius="4" Padding="5,1.5"
                              IsVisible="{Binding TemperatureMinMaxText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding TemperatureMinMaxText}" Foreground="#7E97AD" FontSize="9" />
                      </Border>
                    </StackPanel>

                    <!-- Aufsätze, Modifikationen oder Kapazität -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <!-- Aufsätze -->
                        <TextBlock Text="{Binding AttachmentsText}" Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding AttachmentsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- Rucksack Kapazität -->
                        <TextBlock Text="{Binding BackpackCapacityText}" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold"
                                   IsVisible="{Binding BackpackCapacityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- Raw Class -->
                        <TextBlock Text="{Binding RawClass}" Foreground="#6E7681" FontSize="9"
                                   TextTrimming="CharacterEllipsis" FontFamily="Cascadia Code, Consolas, monospace" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    <!-- ══ TAB: TOOLS & WARTUNG ══ -->
    <TabItem Header="{Binding I18n[Tab_Tools]}">
      <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="0,0,8,16">

          <!-- Header Hero Banner mit Sci-Fi Akzent -->
          <Border Classes="card" Background="#061220" BorderBrush="#1C4872" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Grid RowDefinitions="Auto,Auto">
              
              <!-- Zeile 1: Titel & Refresh Button -->
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#0E2744" BorderBrush="#1E4E7A" BorderThickness="1" CornerRadius="6" Width="28" Height="28" VerticalAlignment="Center">
                      <TextBlock Text="🛠" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="STAR CITIZEN WARTUNGS-SUITE &amp; SYSTEM-OPTIMIERUNG" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="0.8" />
                  </StackPanel>
                  <TextBlock Text="Cache-Reinigung, Keybind-Tresor mit Cloud-Synchronisation, Telemetrie-Check und popout-fähiger user.cfg Tuning-Editor."
                             FontSize="11.5" Foreground="#7E97AD" />
                </StackPanel>
                
                <Button Grid.Column="1" Classes="ghost" Height="30" Padding="12,0" CornerRadius="5" Background="#0A1626" BorderBrush="#1A3B60" BorderThickness="1"
                        Command="{Binding RefreshToolsDataCommand}" ToolTip.Tip="Prüft Cache-Größen, Backups und Hardware-Status jetzt neu">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="11" Foreground="#38BDF8" />
                    <TextBlock Text="Status aktualisieren" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Zeile 2: Schnelle Telemetrie-KPI-Karten -->
              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,14,0,0">
                <!-- KPI 1: Shader Cache -->
                <Border Grid.Column="0" Background="#081424" BorderBrush="#142C47" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="🧹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="SHADER-CACHE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ToolsShaderCacheMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                        <Border Background="#0A2417" BorderBrush="{Binding ToolsShaderStatusColor}" BorderThickness="0.8" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ToolsShaderStatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ToolsShaderStatusColor}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- KPI 2: Crash Dumps -->
                <Border Grid.Column="1" Background="#081424" BorderBrush="#142C47" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="💥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="CRASH-DUMPS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ToolsCrashDumpsMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                        <Border Background="#1C1014" BorderBrush="{Binding ToolsCrashDumpsStatusColor}" BorderThickness="0.8" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ToolsCrashDumpsStatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ToolsCrashDumpsStatusColor}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- KPI 3: Keybind-Tresor -->
                <Border Grid.Column="2" Background="#081424" BorderBrush="#142C47" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="🎮" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="KEYBIND-TRESOR" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ToolsKeybindBackups.Count, StringFormat='{}{0} Gesichert'}" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" />
                        <TextBlock Text="Lokal + Cloud" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- KPI 4: user.cfg Status & Popout Trigger -->
                <Border Grid.Column="3" Background="#081424" BorderBrush="#142C47" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="⚙️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="USER.CFG STATUS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
                      <TextBlock Text="{Binding UserCfgStatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding UserCfgStatusColor}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Height="26" Padding="8,0" CornerRadius="4" Background="#0C1F33" BorderBrush="#1E4E7A" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding OpenUserCfgPopoutCommand}" ToolTip.Tip="Öffnet den user.cfg Tuning-Editor in einem separaten Popout-Fenster">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="↗" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="Studio" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </Grid>

            </Grid>
          </Border>

          <!-- Status Feedback Toast Banner -->
          <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="6" Padding="12,8"
                  IsVisible="{Binding ToolsStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="ℹ" FontSize="13" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding ToolsStatusMessage}" Foreground="#F0F6FC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- ══ 2-SPALTEN HAUPTBEREICH ══ -->
          <Grid ColumnDefinitions="*,*">

            <!-- ── LINKE SPALTE: System-Wartung, Cloud & Hardware ── -->
            <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,7,0">

              <!-- Karte 1: 🧹 Cache & Crash-Dump Bereinigung -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="🧹" FontSize="13" Foreground="#F59E0B" />
                      <TextBlock Text="CACHE &amp; CRASH-DUMP BEREINIGUNG" Classes="label" Foreground="#F59E0B" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1C1808" BorderBrush="#4D3B0D" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="Sicher für Steuerung &amp; Spielstände" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" />
                    </Border>
                  </Grid>

                  <!-- Shader Cache Kachel -->
                  <Border Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="Star Citizen Shader-Cache" FontWeight="SemiBold" Foreground="#F0F6FC" FontSize="12" />
                          <TextBlock Text="(DirectX &amp; Vulkan)" FontSize="10.5" Foreground="#64748B" />
                        </StackPanel>
                        <TextBlock Text="Behebt Ruckler &amp; Texturfehler nach Star Citizen Patches (%LOCALAPPDATA%)." FontSize="10.5" Foreground="#7E97AD" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                          <TextBlock Text="Aktuell belegt:" FontSize="10.5" Foreground="#64748B" />
                          <TextBlock Text="{Binding ToolsShaderCacheMb, StringFormat='{}{0:F1} MB'}" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" />
                          <TextBlock Text="·" FontSize="10.5" Foreground="#3A536B" />
                          <TextBlock Text="{Binding ToolsShaderStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ToolsShaderStatusColor}" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Height="30" Padding="12,0" Background="#0C1B2E" BorderBrush="#1C4B78" BorderThickness="1" CornerRadius="5"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding CleanShadersCommand}" ToolTip.Tip="Löscht DirectX- und Vulkan-Shader-Caches sicher aus %LOCALAPPDATA%">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="⌧" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                          <TextBlock Text="Shader leeren" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Crash Dumps Kachel -->
                  <Border Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Absturzberichte &amp; Crash-Dumps (.dmp)" FontWeight="SemiBold" Foreground="#F0F6FC" FontSize="12" />
                        <TextBlock Text="Alte Speicherabbilder aus früheren Spielabstürzen freigeben." FontSize="10.5" Foreground="#7E97AD" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                          <TextBlock Text="Speicherplatz:" FontSize="10.5" Foreground="#64748B" />
                          <TextBlock Text="{Binding ToolsCrashDumpsMb, StringFormat='{}{0:F1} MB'}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding ToolsCrashDumpsStatusColor}" />
                          <TextBlock Text="·" FontSize="10.5" Foreground="#3A536B" />
                          <TextBlock Text="{Binding ToolsCrashDumpsStatusText}" FontSize="10.5" Foreground="#94A3B8" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Height="30" Padding="12,0" Background="#141926" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="5"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding CleanCrashDumpsCommand}" ToolTip.Tip="Bereinigt gespeicherte Crash-Dumps aus %LOCALAPPDATA%\Star Citizen\crashes">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="⌧" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                          <TextBlock Text="Dumps löschen" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Schutzhinweis -->
                  <Border Background="#071810" BorderBrush="#184D2B" BorderThickness="1" CornerRadius="5" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🛡" FontSize="12" Foreground="#4ADE80" VerticalAlignment="Center" />
                      <TextBlock Text="Tastenbelegungen (actionmaps.xml) und Joystick-Kurven bleiben unberührt." FontSize="10.5" Foreground="#86EFAC" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                </StackPanel>
              </Border>

              <!-- Karte 2: ☁️ Cloud-Speicher & Universelles Log-Archiv -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Path Data="M 13.5,6.5 C 13.1,4 10.9,2.2 8.3,2.2 C 6.2,2.2 4.4,3.4 3.5,5.1 C 1.5,5.3 0,7 0,9 C 0,11.2 1.8,13 4,13 L 13.5,13 C 15.4,13 17,11.4 17,9.5 C 17,7.8 15.4,6.5 13.5,6.5 Z"
                            Fill="#38BDF8" Width="14" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="CLOUD-SPEICHER &amp; LOG-ARCHIVIERUNG" Classes="label" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0C1B2E" BorderBrush="#1C4872" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="OneDrive / Dropbox / Nextcloud" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>
                  </Grid>

                  <TextBlock Text="Sichert Spiel-Logs, Keybind-Backups und user.cfg-Snapshots automatisch in deine persönliche Cloud."
                             FontSize="10.5" Foreground="#7E97AD" />

                  <!-- Pfadeingabe -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Cloud-Stammverzeichnis:" FontSize="10.5" Foreground="#94A3B8" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <TextBox Grid.Column="0" Text="{Binding ToolsCloudStoragePath}" Height="30" FontSize="11"
                               Watermark="z. B. C:\Users\DeinName\OneDrive\StarCitizen"
                               Background="#050B14" BorderBrush="#14263B" />
                      <Button Grid.Column="1" Classes="ghost" Height="30" Padding="10,0" Margin="6,0,0,0" CornerRadius="5" Background="#0C1B2E" BorderBrush="#1C4B78" BorderThickness="1"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding BrowseCloudStoragePathCommand}" ToolTip.Tip="Cloud-Ordner im Dateidialog auswählen">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path Data="M 1,2 L 6,2 L 8,4 L 15,4 C 15.6,4 16,4.4 16,5 L 16,13 C 16,13.6 15.6,14 15,14 L 1,14 C 0.4,14 0,13.6 0,13 L 0,3 C 0,2.4 0.4,2 1,2 Z"
                                Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="Durchsuchen..." FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2" Classes="ghost" Height="30" Padding="10,0" Margin="4,0,0,0" CornerRadius="5" Background="#091422" BorderBrush="#162E48" BorderThickness="1"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding SaveCloudStoragePathCommand}" ToolTip.Tip="Pfad speichern">
                        <TextBlock Text="Speichern" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0F6FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                      <Button Grid.Column="3" Classes="ghost" Height="30" Width="34" Margin="4,0,0,0" CornerRadius="5" Background="#091422" BorderBrush="#162E48" BorderThickness="1"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding OpenCloudFolderCommand}" ToolTip.Tip="Cloud-Ordner im Windows Explorer öffnen">
                        <TextBlock Text="↗" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Grid>
                  </StackPanel>

                  <!-- 2 Aktionen -->
                  <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Classes="ghost" Height="30" Margin="0,0,4,0" CornerRadius="5" Background="#091422" BorderBrush="#162E48" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding ExportLogsZipCommand}" ToolTip.Tip="Komprimiert alle Sessions in ein handliches ZIP-Archiv">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⤓" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock Text="Logs als ZIP packen" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Height="30" Margin="4,0,0,0" CornerRadius="5" Background="#091422" BorderBrush="#162E48" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding SyncLogsCloudCommand}" ToolTip.Tip="Kopiert neue Log-Backups direkt in den konfigurierten Cloud-Pfad">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 13.5,6.5 C 13.1,4 10.9,2.2 8.3,2.2 C 6.2,2.2 4.4,3.4 3.5,5.1 C 1.5,5.3 0,7 0,9 C 0,11.2 1.8,13 4,13 L 13.5,13 C 15.4,13 17,11.4 17,9.5 C 17,7.8 15.4,6.5 13.5,6.5 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Logs in Cloud sichern" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>

                </StackPanel>
              </Border>

              <!-- Karte 3: 🩺 System-Diagnose & Hardware-Telemetrie -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="🩺" FontSize="13" Foreground="#4ADE80" />
                      <TextBlock Text="SYSTEM-CHECK &amp; HARDWARE-TELEMETRIE" Classes="label" Foreground="#4ADE80" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0A2215" BorderBrush="#1B5E36" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding ToolsSystemDiag.StarCitizenVersion}" FontSize="9.5" FontWeight="Bold" Foreground="#4ADE80" />
                    </Border>
                  </Grid>

                  <!-- 2 Kacheln: RAM und Laufwerk -->
                  <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0" Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Arbeitsspeicher (RAM)" FontSize="10" Foreground="#64748B" />
                        <TextBlock Text="{Binding ToolsSystemDiag.RamStatus}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding RamStatusColor}" />
                        <TextBlock Text="Star Citizen profitiert massiv von 32 GB RAM." FontSize="9.5" Foreground="#64748B" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Installations-Laufwerk" FontSize="10" Foreground="#64748B" />
                        <TextBlock Text="{Binding ToolsSystemDiag.DriveType}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="{Binding ToolsSystemDiag.FreeDiskGb, StringFormat='{}{0:F0} GB freier Speicherplatz'}" FontSize="9.5" Foreground="#94A3B8" />
                      </StackPanel>
                    </Border>
                  </Grid>

                </StackPanel>
              </Border>

            </StackPanel>

            <!-- ── RECHTE SPALTE: user.cfg Tuning-Center, Keybind-Tresor & Schnellzugriff ── -->
            <StackPanel Grid.Column="1" Spacing="14" Margin="7,0,0,0">

              <!-- Karte 4: ⚙️ STAR CITIZEN ENGINE & USER.CFG OPTIMIERUNG -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  
                  <!-- Header mit Status-Pill -->
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="⚙️" FontSize="13" Foreground="#38BDF8" />
                      <TextBlock Text="ENGINE-TUNING &amp; USER.CFG" Classes="label" Foreground="#38BDF8" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#08182B" BorderBrush="#1A406B" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding UserCfgStatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding UserCfgStatusColor}" />
                    </Border>
                  </Grid>

                  <!-- Popout Highlight-Card -->
                  <Border Background="#071524" BorderBrush="#173A5E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="🗖" FontSize="12" Foreground="#38BDF8" />
                          <TextBlock Text="user.cfg Tuning-Studio (Popout-Fenster)" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" />
                        </StackPanel>
                        <TextBlock Text="Großer Vollbild-Editor mit Syntax, Schnell-Profilen (High FPS, Qualität, Minimal) und Versions-Historie."
                                   FontSize="10.5" Foreground="#7E97AD" TextWrapping="Wrap" />
                      </StackPanel>
                      
                      <Button Grid.Column="1" Classes="ghost" Height="32" Padding="14,0" Background="#0C253F" BorderBrush="#1F5A94" BorderThickness="1" CornerRadius="5"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding OpenUserCfgPopoutCommand}" ToolTip.Tip="Öffnet das vollständige Tuning-Studio als eigenes Fenster">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="↗" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                          <TextBlock Text="Tuning-Studio öffnen" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Aktive Parameter Übersicht (Live-Kacheln) -->
                  <Border Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Aktuelle Engine-Konfiguration (Vorschau):" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                      <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="VSync:" FontSize="9" Foreground="#64748B" />
                          <TextBlock Text="{Binding CfgVSyncText}" Foreground="{Binding CfgVSyncColor}"
                                     FontSize="10.5" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="MotionBlur:" FontSize="9" Foreground="#64748B" />
                          <TextBlock Text="{Binding CfgMotionBlurText}" Foreground="{Binding CfgMotionBlurColor}"
                                     FontSize="10.5" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                          <TextBlock Text="Max FPS:" FontSize="9" Foreground="#64748B" />
                          <TextBlock Text="{Binding CfgMaxFps}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1">
                          <TextBlock Text="StreamPool:" FontSize="9" Foreground="#64748B" />
                          <TextBlock Text="{Binding CfgStreamPoolSizeMb, StringFormat='{}{0} MB'}" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Schnelle Archiv- & Wiederherstellungs-Leiste -->
                  <Border Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Versions-Archiv &amp; Schnappschüsse (Lokal &amp; Cloud):" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#0C1B2E" BorderBrush="#1C4872" BorderThickness="1" CornerRadius="3" Padding="5,1">
                          <TextBlock Text="{Binding ToolsConfigBackups.Count, StringFormat='{}{0} Versionen'}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                      </Grid>

                      <!-- Dropdown & Rollback -->
                      <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ToolsConfigBackups}" SelectedItem="{Binding ToolsSelectedConfigBackup}"
                                  HorizontalAlignment="Stretch" Height="30" Background="#08101C" BorderBrush="#14263B" Margin="0,0,6,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                  <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding CreatedAt, StringFormat='{}Erstellt: {0:dd.MM.yyyy HH:mm}'}" FontSize="9" Foreground="#64748B" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0A1626" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding LocationType}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Classes="ghost" Height="30" Padding="12,0" CornerRadius="5" Background="#0C1B2E" BorderBrush="#1C4B78" BorderThickness="1"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding RestoreSelectedConfigBackupCommand}" ToolTip.Tip="Stellt die gewählte Version sofort wieder her">
                          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↺" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="Wiederherstellen" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <!-- Schnellsicherung Stand archivieren -->
                      <Button Classes="ghost" Height="28" CornerRadius="5" Background="#091422" BorderBrush="#162E48" BorderThickness="1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding BackupUserCfgCommand}"
                              ToolTip.Tip="Legt sofort ein neues Zeitstempel-Backup der aktuellen user.cfg an">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="⤓" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                          <TextBlock Text="Aktuellen Stand archivieren" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9D6E2" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </Border>

              <!-- Karte 5: 🎮 Keybind-Tresor (actionmaps.xml) -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="🎮" FontSize="13" Foreground="#A78BFA" />
                      <TextBlock Text="KEYBIND-TRESOR (ACTIONMAPS.XML)" Classes="label" Foreground="#A78BFA" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#16122C" BorderBrush="#3B2A6B" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding ToolsKeybindBackups.Count, StringFormat='{}{0} Gesichert'}" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                    </Border>
                  </Grid>

                  <TextBlock Text="Sichert alle Steuerungs-Mappings &amp; Joystick-Profile vor Spiel-Updates – lokal und in deiner Cloud."
                             FontSize="10.5" Foreground="#7E97AD" />

                  <!-- Neues Backup anlegen -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding ToolsNewKeybindBackupNote}" Height="30" FontSize="11"
                             Watermark="Optionale Notiz (z. B. HOSAS VKB Patch 4.0)"
                             Background="#050B14" BorderBrush="#14263B" />
                    <Button Grid.Column="1" Classes="ghost" Height="30" Padding="12,0" Margin="6,0,0,0" CornerRadius="5" Background="#141026" BorderBrush="#3B256B" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding BackupKeybindsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="10" Foreground="#A78BFA" VerticalAlignment="Center" />
                        <TextBlock Text="Jetzt sichern" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- Backup-Liste -->
                  <Border Background="#050B14" BorderBrush="#132338" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                    <ListBox ItemsSource="{Binding ToolsKeybindBackups}" SelectedItem="{Binding ToolsSelectedKeybindBackup}"
                             Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,2">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding CreatedAt, StringFormat='{}Erstellt: {0:dd.MM.yyyy HH:mm}'}" FontSize="9" Foreground="#64748B" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A1626" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding LocationType}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>

                  <!-- Wiederherstellen -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Ausgewähltes Profil wiederherstellen:" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Height="28" Padding="12,0" CornerRadius="5" Background="#0C1B2E" BorderBrush="#1C4B78" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding RestoreSelectedKeybindCommand}" ToolTip.Tip="Kopiert die gesicherte actionmaps.xml &amp; Mappings zurück in den Star Citizen LIVE Ordner">
                      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="↺" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="Wiederherstellen" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Karte 6: 📁 Star Citizen Ordner-Schnellzugriff -->
              <Border Classes="card" Background="#08101C" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="STAR CITIZEN VERZEICHNISSE IM WINDOWS EXPLORER:" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />
                  <Grid ColumnDefinitions="*,*,*,*,*">
                    <Button Grid.Column="0" Classes="ghost" Height="30" Margin="0,0,3,0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#081422" BorderBrush="#162E48" BorderThickness="1" CornerRadius="5"
                            Command="{Binding OpenLiveFolderCommand}" ToolTip.Tip="Star Citizen LIVE Verzeichnis">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 6,2 L 8,4 L 15,4 C 15.6,4 16,4.4 16,5 L 16,13 C 16,13.6 15.6,14 15,14 L 1,14 C 0.4,14 0,13.6 0,13 L 0,3 C 0,2.4 0.4,2 1,2 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Height="30" Margin="3,0,3,0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#081422" BorderBrush="#162E48" BorderThickness="1" CornerRadius="5"
                            Command="{Binding OpenLogbackupsFolderCommand}" ToolTip.Tip="Star Citizen logbackups Ordner">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 6,2 L 8,4 L 15,4 C 15.6,4 16,4.4 16,5 L 16,13 C 16,13.6 15.6,14 15,14 L 1,14 C 0.4,14 0,13.6 0,13 L 0,3 C 0,2.4 0.4,2 1,2 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Logs" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="ghost" Height="30" Margin="3,0,3,0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#081422" BorderBrush="#162E48" BorderThickness="1" CornerRadius="5"
                            Command="{Binding OpenStarCitizenLocalAppDataFolderCommand}" ToolTip.Tip="%LOCALAPPDATA%\Star Citizen (Shader &amp; Dumps)">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 6,2 L 8,4 L 15,4 C 15.6,4 16,4.4 16,5 L 16,13 C 16,13.6 15.6,14 15,14 L 1,14 C 0.4,14 0,13.6 0,13 L 0,3 C 0,2.4 0.4,2 1,2 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Shaders" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="ghost" Height="30" Margin="3,0,3,0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#081422" BorderBrush="#162E48" BorderThickness="1" CornerRadius="5"
                            Command="{Binding OpenSCLogMateAppDataFolderCommand}" ToolTip.Tip="%APPDATA%\SCLogMate (Archiv &amp; DB)">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 6,2 L 8,4 L 15,4 C 15.6,4 16,4.4 16,5 L 16,13 C 16,13.6 15.6,14 15,14 L 1,14 C 0.4,14 0,13.6 0,13 L 0,3 C 0,2.4 0.4,2 1,2 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="SCLogMate" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="ghost" Height="30" Margin="3,0,0,0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#081422" BorderBrush="#162E48" BorderThickness="1" CornerRadius="5"
                            Command="{Binding OpenCloudFolderCommand}" ToolTip.Tip="Konfigurierter Cloud-Speicherpfad">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 13.5,6.5 C 13.1,4 10.9,2.2 8.3,2.2 C 6.2,2.2 4.4,3.4 3.5,5.1 C 1.5,5.3 0,7 0,9 C 0,11.2 1.8,13 4,13 L 13.5,13 C 15.4,13 17,11.4 17,9.5 C 17,7.8 15.4,6.5 13.5,6.5 Z"
                              Fill="#38BDF8" Width="13" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Cloud" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>

          </Grid>

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Tab 6: Einstellungen -->
    <TabItem Header="{Binding I18n[Tab_Settings]}">
      <Grid Margin="0,8,0,0">
        <TabControl SelectedIndex="{Binding SettingsSubTabIndex}">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="Padding" Value="7,4,7,4" />
              <Setter Property="FontSize" Value="11.5" />
            </Style>
          </TabControl.Styles>

          <!-- Sub-Tab 1: 📁 Allgemein -->
          <TabItem Header="{Binding I18n[SubTab_General]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <!-- 1. Star Citizen & Logdatei -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="label" Text="📁  STAR CITIZEN &amp; LOGDATEI" />
                    <TextBlock Text="Wähle deine Game.log Datei aus dem LIVE- oder PTU-Installationsverzeichnis von Star Citizen." Foreground="#8B949E" FontSize="11" />
                    
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                      <TextBox Grid.Column="0" Classes="path" VerticalAlignment="Center" Text="{Binding LogPath}" Watermark="Pfad zur Game.log" />
                      <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" VerticalAlignment="Center"
                              Command="{Binding BrowseCommand}" Content="📁  Durchsuchen"
                              ToolTip.Tip="Game.log manuell auswählen" />
                      <Button Grid.Column="2" Classes="ghost" Margin="6,0,0,0" VerticalAlignment="Center"
                              Command="{Binding DetectCommand}" Content="⚡ Auto-Erkennung"
                              ToolTip.Tip="Game.log automatisch auf allen Laufwerken suchen" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 2. Erscheinungsbild & Schriftart -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="label" Text="🎨  ERSCHEINUNGSBILD &amp; SCHRIFTART (FONT CHOOSER)" />
                    <TextBlock Text="Passe die primäre Schriftart der Benutzeroberfläche an deine Vorlieben an (wirkt sofort appweit)." Foreground="#8B949E" FontSize="11" />
                    
                    <Grid ColumnDefinitions="280,*" Margin="0,4,0,0">
                      <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFontOption}"
                                HorizontalAlignment="Stretch" Padding="10,6" CornerRadius="6" Background="#0D1117" BorderBrush="#30363D" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Vorschau: Star Citizen Live Log Companion 0123456789 (aUEC · Saldo · ⬡ Baupläne)"
                                   Foreground="#C9D1D9" FontSize="12" FontFamily="{Binding CurrentFontFamily}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 3. Sprache & Regional-Einstellungen / Language -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="🌐  SPRACHE &amp; REGIONAL-EINSTELLUNGEN / LANGUAGE" />
                        <TextBlock Text="Wähle die Sprache der Anwendung und für sprachabhängige Zusatzmodule wie VoiceAttack &amp; Aurora." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <!-- Status Pill -->
                      <Border Grid.Column="1" Background="#0D1F2D" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <!-- Deutsche Flagge -->
                          <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" IsVisible="{Binding IsGermanLanguageActive}" VerticalAlignment="Center">
                            <Grid RowDefinitions="*,*,*">
                              <Rectangle Grid.Row="0" Fill="#151515" />
                              <Rectangle Grid.Row="1" Fill="#DD0000" />
                              <Rectangle Grid.Row="2" Fill="#FFCE00" />
                            </Grid>
                          </Border>
                          <!-- Britische Flagge -->
                          <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#00247D" IsVisible="{Binding !IsGermanLanguageActive}" VerticalAlignment="Center">
                            <Canvas Width="16" Height="11">
                              <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#FFFFFF" StrokeThickness="2.2" />
                              <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#CF142B" StrokeThickness="1.0" />
                              <Rectangle Canvas.Left="6.5" Canvas.Top="0" Width="3" Height="11" Fill="#FFFFFF" />
                              <Rectangle Canvas.Left="0" Canvas.Top="4" Width="16" Height="3" Fill="#FFFFFF" />
                              <Rectangle Canvas.Left="7.2" Canvas.Top="0" Width="1.6" Height="11" Fill="#CF142B" />
                              <Rectangle Canvas.Left="0" Canvas.Top="4.7" Width="16" Height="1.6" Fill="#CF142B" />
                            </Canvas>
                          </Border>
                          <TextBlock Text="{Binding ActiveLanguageBadgeText}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="280,*" Margin="0,4,0,0">
                      <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguageOption}"
                                HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="6" Background="#0D1117" BorderBrush="#30363D">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                              <!-- 🌐 Auto Icon -->
                              <TextBlock Text="🌐" FontSize="11" IsVisible="{Binding IsAuto}" VerticalAlignment="Center" />

                              <!-- 🇩🇪 Echte Deutsche Flagge -->
                              <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" IsVisible="{Binding IsGerman}" VerticalAlignment="Center"
                                      BorderBrush="#30363D" BorderThickness="0.5">
                                <Grid RowDefinitions="*,*,*">
                                  <Rectangle Grid.Row="0" Fill="#151515" />
                                  <Rectangle Grid.Row="1" Fill="#DD0000" />
                                  <Rectangle Grid.Row="2" Fill="#FFCE00" />
                                </Grid>
                              </Border>

                              <!-- 🇬🇧 Echte Britische Flagge -->
                              <Border Width="16" Height="11" CornerRadius="1.5" ClipToBounds="True" Background="#00247D" IsVisible="{Binding IsEnglish}" VerticalAlignment="Center"
                                      BorderBrush="#30363D" BorderThickness="0.5">
                                <Canvas Width="16" Height="11">
                                  <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#FFFFFF" StrokeThickness="2.2" />
                                  <Path Data="M 0,0 L 16,11 M 16,0 L 0,11" Stroke="#CF142B" StrokeThickness="1.0" />
                                  <Rectangle Canvas.Left="6.5" Canvas.Top="0" Width="3" Height="11" Fill="#FFFFFF" />
                                  <Rectangle Canvas.Left="0" Canvas.Top="4" Width="16" Height="3" Fill="#FFFFFF" />
                                  <Rectangle Canvas.Left="7.2" Canvas.Top="0" Width="1.6" Height="11" Fill="#CF142B" />
                                  <Rectangle Canvas.Left="0" Canvas.Top="4.7" Width="16" Height="1.6" Fill="#CF142B" />
                                </Canvas>
                              </Border>

                              <TextBlock Text="{Binding Title}" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding LanguageDescriptionText}" Foreground="#8B949E" FontSize="11.5" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>


                <!-- 3. Fenster- & System-Verhalten -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="label" Text="❖  FENSTER-, TRAY- &amp; SYSTEM-VERHALTEN" />
                    <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Beim Klick auf das Schließen-Kreuz (X) ins System-Tray minimieren" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Die App läuft im Hintergrund im Infobereich weiter (Tracking, OCR &amp; Overlays bleiben aktiv). Wenn deaktiviert, wird die App bei 'X' vollständig beendet." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding AutostartEnabled}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Mit Windows automatisch im Hintergrund starten (System-Tray)" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Startet SCLogMate bei der Windows-Anmeldung minimiert in den Infobereich. Erkennt Star Citizen bei Spielstart sofort vollautomatisch." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Sub-Tab 2: ⏳ Wipe & Filter -->
          <TabItem Header="{Binding I18n[SubTab_Wipe]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="⏳  WIPE- &amp; PERSISTENZ-FILTER" />
                        <TextBlock Text="Kappt historische Log-Daten vor einem bestimmten Patch-Stichtag (z.B. Alpha 4.8 Wipe), damit Kontosalden, Missionen und Statistiken nur für den aktuellen Zyklus berechnet werden." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <CheckBox Grid.Column="1" IsChecked="{Binding WipeFilterEnabled}" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Wipe-Filter aktiv" FontWeight="Bold" Foreground="#F59E0B" FontSize="12" />
                      </CheckBox>
                    </Grid>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Stichtag festlegen (Wipe-Datum)" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                          <TextBox Grid.Column="0" Classes="path" Text="{Binding WipeDateString}" Watermark="Wipe-Datum (JJJJ-MM-TT, z.B. 2026-05-15)" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Command="{Binding SetWipePreset48Command}" Content="★ 4.8 Wipe" ToolTip.Tip="Auf Alpha 4.8 (15.05.2026) setzen" />
                          <Button Grid.Column="2" Classes="ghost" Margin="6,0,0,0" Command="{Binding SetWipePresetTodayCommand}" Content="📅 Heute" ToolTip.Tip="Auf heutigen Tag setzen" />
                          <Button Grid.Column="3" Classes="ghost" Margin="6,0,0,0" Command="{Binding ClearWipeFilterCommand}" Content="✕ Filter aus" ToolTip.Tip="Filter deaktivieren" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Betroffene Datenbereiche (Modular filterbar)" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,*,*,*">
                          <CheckBox Grid.Column="0" IsChecked="{Binding WipeFilterMoney}">
                            <TextBlock Text="💰 Geld &amp; Saldo" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                          <CheckBox Grid.Column="1" IsChecked="{Binding WipeFilterContracts}">
                            <TextBlock Text="❖ Missionen" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                          <CheckBox Grid.Column="2" IsChecked="{Binding WipeFilterFleet}">
                            <TextBlock Text="✈ Flotte" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                          <CheckBox Grid.Column="3" IsChecked="{Binding WipeFilterBlueprints}">
                            <TextBlock Text="🛠 Baupläne" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                        </Grid>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Sub-Tab 3: 🖥 Overlays & HUD -->
          <TabItem Header="{Binding I18n[SubTab_Overlays]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <!-- 1. Mini-HUD Overlay -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="🖥  IN-GAME FLOATING MINI-HUD OVERLAY" />
                        <TextBlock Text="Zeigt deinen Kontostand, aktuellen Standort, aktiven Auftrag und Server-Ping in einem verschiebbaren Overlay direkt über dem Spiel." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="10,6" CornerRadius="5" VerticalAlignment="Center" Margin="12,0,0,0"
                              Background="{Binding IsOverlayActive, Converter={StaticResource GreenRedBg}}"
                              BorderBrush="{Binding IsOverlayActive, Converter={StaticResource GreenRedBrush}}"
                              BorderThickness="1"
                              Command="{Binding ToggleOverlayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🖥" FontSize="12" Foreground="{Binding IsOverlayActive, Converter={StaticResource GreenRedBrush}}" />
                          <TextBlock Text="Mini-HUD aktiv" FontSize="12" FontWeight="Bold" Foreground="{Binding IsOverlayActive, Converter={StaticResource GreenRedBrush}}" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Deckkraft / Transparenz" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <Slider Minimum="0.3" Maximum="1.0" Value="{Binding OverlayOpacity}" Height="28" />
                          <TextBlock Text="{Binding OverlayOpacity, StringFormat='{}Deckkraft: {0:P0}'}" Foreground="#8B949E" FontSize="11" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Steuerung &amp; Verhalten" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <CheckBox IsChecked="{Binding OverlayLocked}">
                            <TextBlock Text="🔒 Position sperren (Drag-Sperre gegen versehentliches Verschieben)" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                          <CheckBox IsChecked="{Binding OverlayClickThrough}">
                            <TextBlock Text="🖱️ Click-Through (Mausklicks direkt an das Spiel durchreichen)" FontSize="11" Foreground="#C9D1D9" />
                          </CheckBox>
                          <CheckBox IsChecked="{Binding GlobalHotkeyEnabled}">
                            <TextBlock Text="⌨️ Globaler Hotkey (Alt + H) im Spiel zum Ein-/Ausblenden" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                          </CheckBox>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 2. RS Signal Scanner Overlay -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="🛰  RS SIGNAL SCANNER &amp; MINING HUD OVERLAY" />
                        <TextBlock Text="Kompaktes, frei verschiebbares In-Game Overlay für Mining- &amp; Salvage-Signaturen mit Node-Count, Raffinerie-Bonus und aUEC-Schätzung." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="10,6" CornerRadius="5" VerticalAlignment="Center" Margin="12,0,0,0"
                              Background="{Binding IsRsOverlayActive, Converter={StaticResource GreenRedBg}}"
                              BorderBrush="{Binding IsRsOverlayActive, Converter={StaticResource GreenRedBrush}}"
                              BorderThickness="1"
                              Command="{Binding ToggleRsOverlayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🛰" FontSize="12" Foreground="{Binding IsRsOverlayActive, Converter={StaticResource GreenRedBrush}}" />
                          <TextBlock Text="RS Overlay aktiv" FontSize="12" FontWeight="Bold" Foreground="{Binding IsRsOverlayActive, Converter={StaticResource GreenRedBrush}}" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Automatischer Scan &amp; OCR" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <CheckBox IsChecked="{Binding IsRsAutoScanEnabled}" Command="{Binding ToggleRsAutoScanCommand}">
                            <TextBlock Text="⚡ Kontinuierlicher Auto-Scan (350ms Intervall)" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                          </CheckBox>
                          <TextBlock Text="Liest die RS-Ziffern automatisch bei jedem HUD-Ping vom Bildschirm ab." Foreground="#8B949E" FontSize="11" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Scan-Bereich auf dem Bildschirm" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Padding="8,4" Command="{Binding CalibrateRsScanRegionCommand}">
                              <TextBlock Text="⛶ Bereich auswählen" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </Button>
                            <Button Classes="ghost" Padding="8,4" Command="{Binding ResetRsScanRegionCommand}">
                              <TextBlock Text="↺ Zurücksetzen" FontSize="11" Foreground="#8B949E" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 3. Achievement Toast Banner & Modulare Kategorien -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="✦  ACHIEVEMENT &amp; REWARD TOAST OVERLAY" />
                        <TextBlock Text="Blendet bei spielrelevanten Ereignissen ein Gaming-Erfolgs-Banner im Spiel ein. Läuft völlig unabhängig vom Mini-HUD." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="10,6" CornerRadius="5" VerticalAlignment="Center" Margin="12,0,0,0"
                              Background="{Binding ToastOverlayEnabled, Converter={StaticResource GreenRedBg}}"
                              BorderBrush="{Binding ToastOverlayEnabled, Converter={StaticResource GreenRedBrush}}"
                              BorderThickness="1"
                              Command="{Binding ToggleToastOverlayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="✦" FontSize="12" Foreground="{Binding ToastOverlayEnabled, Converter={StaticResource GreenRedBrush}}" />
                          <TextBlock Text="Banner aktiv" FontSize="12" FontWeight="Bold" Foreground="{Binding ToastOverlayEnabled, Converter={StaticResource GreenRedBrush}}" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- Modulare Benachrichtigungs-Kategorien (Checkboxen) -->
                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Benachrichtigungs-Kategorien (Aktivieren / Deaktivieren)" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                          <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding ToastBlueprintEnabled}" Margin="0,2">
                            <TextBlock Text="⬡ Neu erlernte Baupläne (Blueprints)" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding ToastMissionEnabled}" Margin="0,2">
                            <TextBlock Text="★ Abgeschlossene Missionen &amp; Belohnungen (+aUEC)" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding ToastReputationEnabled}" Margin="0,2">
                            <TextBlock Text="⭐ Fraktions-Beförderungen &amp; Rang-Aufstiege" FontSize="11" Foreground="#C084FC" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ToastRefineryEnabled}" Margin="0,2">
                            <TextBlock Text="🏭 Raffinerie-Aufträge (Veredelung abgeschlossen)" FontSize="11" Foreground="#FB923C" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding ToastElevatorEnabled}" Margin="0,2">
                            <TextBlock Text="📦 Fracht- &amp; Schiffsaufzüge (Elevators bereit)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ToastShipDestructionEnabled}" Margin="0,2">
                            <TextBlock Text="💥 Schiffszerstörung &amp; Notfall-Claims" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding ToastSoundEnabled}" Margin="0,4,0,0">
                            <TextBlock Text="🔊 Subtiler Audio-Soundeffekt bei Toast-Meldungen" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                          </CheckBox>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Row="0" Text="Banner testen &amp; positionieren" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Grid.Row="1" Text="Löst nacheinander alle konfigurierten Test-Banner aus. Klicke und ziehe das Banner auf dem Bildschirm an deine Wunschposition." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                          <Button Grid.Row="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding TestAchievementToastCommand}" Content="⚡ Test-Banner durchschalten" />
                        </Grid>
                      </Border>

                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Funktionsweise &amp; Features" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="• Erscheint autonom beim Eintreten der aktivierten Ereignisse&#x0a;• Fadet nach ~5.5 Sekunden automatisch wieder aus&#x0a;• Mehrfache Meldungen reihen sich gestapelt untereinander ein" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Sub-Tab 4: 👁 mobiGlas & OCR -->
          <TabItem Header="{Binding I18n[SubTab_Ocr]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <!-- mobiGlas Screenreader -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="👁  MOBIGLAS SCREENREADER (aUEC KONTOSTAND)" />
                        <TextBlock Text="Liest beim Öffnen des mobiGlas (F1) deinen echten Kontostand vollautomatisch per Windows OCR ab." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="10,6" CornerRadius="5" VerticalAlignment="Center" Margin="12,0,0,0"
                              Background="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBg}}"
                              BorderBrush="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBrush}}"
                              BorderThickness="1"
                              Command="{Binding ToggleAutoOcrCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="⚡" FontSize="12" Foreground="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBrush}}" />
                          <TextBlock Text="Auto-Sync" FontSize="12" FontWeight="Bold" Foreground="{Binding AutoOcrEnabled, Converter={StaticResource GreenRedBrush}}" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                      <!-- Bereich kalibrieren -->
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Kontostand-Bereich" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding WalletRegionSummaryText}" Foreground="#8B949E" FontSize="11" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding SelectWalletRegionCommand}" Content="⊕ Bereich kalibrieren" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>

                      <!-- Ingame Scan-Box -->
                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Ingame Scan-Box" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Live-Rahmen im Spiel (blinkt grün)" Foreground="#8B949E" FontSize="11" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding ToggleScanBoxCommand}" Margin="0,4,0,0">
                            <TextBlock Text="▣ Scan-Box umschalten" Foreground="{Binding ShowScanBox, Converter={StaticResource ActiveBrush}}" />
                          </Button>
                        </StackPanel>
                      </Border>

                      <!-- Test-Scan -->
                      <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Manueller Test-Scan" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding OcrStatusText}" Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis" />
                          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding TriggerOcrCommand}" Content="▶ Test-Scan starten" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Aktive Aufträge -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="❖  AKTIVE AUFTRÄGE &amp; MISSIONS-TRACKING" />
                        <TextBlock Text="Missionsdaten, Belohnungen und Baupläne werden 100% automatisch aus dem Game.log und der SQLite-Master-Datenbank abgeglichen." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Margin="12,0,0,0"
                              Command="{Binding ClearContractsCommand}"
                              ToolTip.Tip="Aktive Auftragsliste leeren">
                        <TextBlock Text="✕ Aufträge leeren" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" />
                      </Button>
                    </Grid>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding ActiveContractsCountText}" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ActiveContractTitle, StringFormat='Aktueller Fokus: {0}'}" Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0D2D20" BorderBrush="#238636" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                          <TextBlock Text="⚡ Auto-Sync aktiv" Foreground="#3FB950" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Sub-Tab 5: 🌐 UEX Integration -->
          <TabItem Header="{Binding I18n[SubTab_Uex]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="🌐  UEX CORP API 2.0 INTEGRATION" />
                        <TextBlock Text="Verknüpfe deinen persönlichen UEX-Account &amp; API-Key für Live-Handelsdaten, Terminals und Preise." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Margin="12,0,0,0"
                              Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="https://uexcorp.space/api/documentation">
                        <TextBlock Text="📖 UEX Doku" FontSize="11" Foreground="#58A6FF" />
                      </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <TextBox Grid.Column="0" Classes="path" Text="{Binding UexApiKeyInput}" PasswordChar="●" Watermark="UEX Access Token / API Key (z.B. Bearer Token)..." />
                      <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Command="{Binding SaveAndTestUexApiKeyCommand}" Content="💾 Speichern &amp; Testen" />
                    </Grid>

                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="⚡" FontSize="14" Foreground="{Binding UexStatusColor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding UexStatusMessage}" Foreground="{Binding UexStatusColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="Dein geheimer API-Schlüssel wird lokal in settings.json gespeichert und für Preis- und Stationsabfragen genutzt." Foreground="#8B949E" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Sub-Tab 6: 🎙️ VoiceAttack & Aurora Log-Wächter -->
          <TabItem Header="{Binding I18n[SubTab_VoiceAttack]}">
            <ScrollViewer Margin="0,4,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,160">

                <!-- 1. Erkennung & Status Banner -->
                <Border Classes="card" Padding="10,6">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Classes="label" Text="🎙️  VOICEATTACK &amp; AURORA LOG-WÄCHTER INTEGRATION" />
                        <TextBlock Text="Nativer Audio-Begleiter für Star Citizen Live-Events. Greift rein lesend auf das VoiceAttack Aurora Log-Wächter Profil zu." Foreground="#8B949E" FontSize="10.5" />
                      </StackPanel>
                      
                      <!-- Rechts: Test-Schalter & Status Badge -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CheckBox IsChecked="{Binding SimulateAuroraNotInstalled}" VerticalAlignment="Center"
                                  IsVisible="{Binding IsDebugModeActive}"
                                  ToolTip.Tip="Schaltet die Ansicht testweise auf 'Nicht installiert', um das Verhalten und den Kauf-Link zu prüfen">
                          <TextBlock Text="🧪 'Nicht installiert' simulieren" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                        </CheckBox>

                        <!-- Status Badge -->
                        <Border Background="#0D2D20" BorderBrush="#238636" BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center"
                                IsVisible="{Binding IsAuroraInstalled}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="Profil Gefunden &amp; Bereit" Foreground="#3FB950" FontSize="11" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center"
                                IsVisible="{Binding !IsAuroraInstalled}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="⚪" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="Nicht Gefunden" Foreground="#8B949E" FontSize="11" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>

                    <!-- Installations-Pfad Infobox -->
                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="📁" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="Installations-Pfad (Dokumente / OneDrive)" Foreground="#8B949E" FontSize="9.5" />
                          <TextBlock Text="{Binding AuroraPath}" Foreground="#F0F6FC" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Hinweis bei Nicht-Installation -->
                        <TextBlock Grid.Column="2" Text="Ordner 'VoiceAttack\Aurora Log-Wächter' nicht gefunden (Integration deaktiviert)" Foreground="#F87171" FontSize="10" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsAuroraInstalled}" />
                      </Grid>
                    </Border>

                    <!-- Gumroad Kauf-Banner (erscheint wenn Aurora nicht installiert ist und die Sprache Deutsch ist) -->
                    <Border Background="#161208" BorderBrush="#D97706" BorderThickness="1.5" CornerRadius="7" Padding="10,6"
                            IsVisible="{Binding ShowAuroraPurchaseBanner}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="🛒" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="Aurora Log-Wächter Profil nicht installiert" Foreground="#FDE68A" FontSize="12" FontWeight="Bold" />
                          <TextBlock Text="Erhalte das vollständige VoiceAttack-Paket mit über 150 personalisierten Audio-Sprachausgaben für Schiffe, Zonen &amp; Spielereignisse." Foreground="#D1D5DB" FontSize="10.5" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="accent" Background="#D97706" BorderBrush="#F59E0B" CornerRadius="6" Padding="12,5" VerticalAlignment="Center"
                                Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="https://3415383443272.gumroad.com/l/yzpmoa"
                                ToolTip.Tip="Aurora Log-Wächter auf Gumroad öffnen">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="🛍️" FontSize="11" />
                            <TextBlock Text="Aurora auf Gumroad ansehen" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 2. Hauptschalter & Audio-Einstellungen (Kompakt) -->
                <StackPanel Spacing="8" IsEnabled="{Binding IsAuroraInstalled}" Opacity="{Binding IsAuroraInstalled, Converter={StaticResource BoolToOpacity}}">

                  <!-- Haupt-Steuerung & Lautstärke -->
                  <Border Classes="card" Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsAuroraEnabled}" Content="Audio-Begleiter Aktiv" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" Margin="0,0,16,0" />
                      
                      <!-- Lautstärke Slider -->
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Grid.Column="0" Text="Lautstärke:" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AuroraVolume}" VerticalAlignment="Center" />
                      </Grid>
                      
                      <TextBlock Grid.Column="2" Text="{Binding AuroraVolume, StringFormat='{}{0}%'}" Foreground="#58A6FF" FontSize="11" FontWeight="Bold" Width="40" VerticalAlignment="Center" Margin="0,0,10,0" />

                      <Button Grid.Column="3" Classes="accent" Command="{Binding PlayAuroraTestSoundCommand}" VerticalAlignment="Center" Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="▶" FontSize="11" />
                          <TextBlock Text="Test-Audio" FontWeight="Bold" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- 3. Kategorie-Auswahl (Kompakt) -->
                  <Border Classes="card" Padding="10,6">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="label" Text="🎛️  AKTIVE SPRACH-KATEGORIEN" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Schutzzonen auf Stationen werden automatisch stummgeschaltet" Foreground="#4ADE80" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                        <!-- Spalte 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,3">
                          <CheckBox IsChecked="{Binding IsAuroraShipGreetingsEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="🚀 Schiffsbegrüßungen" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="73 Schiffsklassen" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,3">
                          <CheckBox IsChecked="{Binding IsAuroraBlueprintsEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="📜 Baupläne" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Crafting-Baupläne" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,0">
                          <CheckBox IsChecked="{Binding IsAuroraSafetyZonesEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="🛡️ Sicherheitszonen" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Armistice Zone (im Raum)" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <!-- Spalte 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="2,0,2,3">
                          <CheckBox IsChecked="{Binding IsAuroraRestrictedZonesEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="⛔ Sperrzonen" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Sperrgebiet / Privat" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="2,0,2,3">
                          <CheckBox IsChecked="{Binding IsAuroraMonitoredSpaceEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="📡 Überwachter Raum" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Comm-Array" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="2,0,2,0">
                          <CheckBox IsChecked="{Binding IsAuroraJurisdictionsEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="🏛️ Hoheitsgebiete" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="UEE, Hurston, etc." Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <!-- Spalte 3 -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="4,0,0,3">
                          <CheckBox IsChecked="{Binding IsAuroraQuantumArrivalEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="🌌 Quantenreise" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Sprungziel-Ankunft" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="4,0,0,3">
                          <CheckBox IsChecked="{Binding IsAuroraPlayerDeathEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="💀 Notfall / Tod" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Spielertod / Med-Bett" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="4,0,0,0">
                          <CheckBox IsChecked="{Binding IsAuroraServerErrorsEnabled}">
                            <StackPanel Spacing="0">
                              <TextBlock Text="⚠️ Serverfehler (30k)" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="Verbindungsabbruch" Foreground="#8B949E" FontSize="9" />
                            </StackPanel>
                          </CheckBox>
                        </Border>
                      </Grid>

                    </StackPanel>
                  </Border>

                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </TabItem>


          <!-- Sub-Tab 7: 💾 Datenbank & Wartung -->
          <TabItem Header="{Binding I18n[SubTab_Database]}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="💾  DATENBANK-VERWALTUNG &amp; WARTUNG" />
                        <TextBlock Text="Verwalte das lokale SQLite-Archiv, starte einen vollständigen Re-Scan aller Logs oder bereinige die Datenbank." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding DatabaseSummaryText}" Foreground="#58A6FF" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <!-- Statusmeldung nach Operation (nur sichtbar wenn Operation abgeschlossen) -->
                    <Border Background="#061810" BorderBrush="#1B5E33" BorderThickness="1" CornerRadius="6" Padding="12,7"
                            IsVisible="{Binding ShowDatabaseCompletionStatus}">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#4ADE80" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DatabaseStatusMessage}" Foreground="#4ADE80" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <!-- Wartung & Re-Scan -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                      <!-- Re-Scan -->
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Kompletter Re-Scan" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Liest alle Logs frisch mit neuen Parser-Regeln ein." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
                                  Command="{Binding RescanAllLogsCommand}" IsEnabled="{Binding !IsDatabaseBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="🔄" FontSize="11" />
                              <TextBlock Text="Alle Logs neu einlesen" FontWeight="Bold" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>

                      <!-- Cleanup & Vacuum -->
                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Datenbank-Bereinigung" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Entfernt verwaiste Datensätze und führt VACUUM aus." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
                                  Command="{Binding CleanupDatabaseCommand}" IsEnabled="{Binding !IsDatabaseBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="🧹" FontSize="11" />
                              <TextBlock Text="DB bereinigen &amp; VACUUM" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>

                      <!-- Reset Database -->
                      <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Datenbank leeren" Foreground="#F87171" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Setzt alle indexierten Sessions komplett zurück." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
                                  Command="{Binding ResetDatabaseCommand}" IsEnabled="{Binding !IsDatabaseBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="✕" FontSize="11" Foreground="#F87171" />
                              <TextBlock Text="Datenbank zurücksetzen" Foreground="#F87171" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Exporte & Diagnose -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                      <!-- CSV Export -->
                      <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="CSV-Export" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Tabelle für Excel / Calc" Foreground="#8B949E" FontSize="11" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding ExportCsvCommand}" Content="⬓  CSV exportieren" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>

                      <!-- JSON Export -->
                      <Border Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="JSON-Export" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Vollständiger Datenbericht" Foreground="#8B949E" FontSize="11" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding ExportJsonCommand}" Content="⬓  JSON exportieren" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>

                      <!-- AppData & Debug-Log -->
                      <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Speicherort &amp; Diagnose" Foreground="#F0F6FC" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="AppData (%AppData%\SCLogMate)" Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis" />
                          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0"
                                    Command="{Binding OpenAppDataFolderCommand}" Content="📂 Ordner" />
                            <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0"
                                    Command="{Binding OpenDebugLogCommand}" Content="📄 Log" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Grid>

                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>
 
          <!-- Sub-Tab 8: 🧪 Entwickler & Debug Tools (Nur sichtbar, wenn DebugMode aktiv) -->
          <TabItem Header="{Binding I18n[SubTab_Developer]}" IsVisible="{Binding IsDebugModeActive}">
            <ScrollViewer Margin="0,6,0,0" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,120">

                <!-- 1. Star Citizen Live-Events simulieren (Log-Injektion & Audio-Tests) -->
                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="label" Text="🧪  STAR CITIZEN LIVE-EVENTS SIMULIEREN" />
                        <TextBlock Text="Injiziert simulierte Star Citizen Game.log-Events zur Prüfung von Audioausgaben, Muting, Cooldowns und Benachrichtigungen." Foreground="#8B949E" FontSize="11" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#2E1B05" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="DEBUG ONLY" Foreground="#F59E0B" FontSize="10" FontWeight="Bold" />
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                      <!-- Schutzzone betreten -->
                      <Button Grid.Row="0" Grid.Column="0" Classes="ghost" Margin="0,0,4,6" Height="36"
                              Command="{Binding SimulateArmisticeEnterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🛡️" FontSize="12" />
                          <TextBlock Text="Schutzzone betreten" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Schutzzone verlassen -->
                      <Button Grid.Row="0" Grid.Column="1" Classes="ghost" Margin="2,0,2,6" Height="36"
                              Command="{Binding SimulateArmisticeLeaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="⚔️" FontSize="12" />
                          <TextBlock Text="Schutzzone verlassen" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Schiffseinstieg Begrüßung -->
                      <Button Grid.Row="0" Grid.Column="2" Classes="ghost" Margin="4,0,0,6" Height="36"
                              Command="{Binding SimulateShipJoinCommand}" CommandParameter="Drake Cutlass Black">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🚀" FontSize="12" />
                          <TextBlock Text="Schiffseinstieg (Cutlass)" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Bauplan erlernt -->
                      <Button Grid.Row="1" Grid.Column="0" Classes="ghost" Margin="0,0,4,0" Height="36"
                              Command="{Binding SimulateBlueprintFoundCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="📜" FontSize="12" />
                          <TextBlock Text="Bauplan erlernt (Toast)" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Quantensprung Ankunft -->
                      <Button Grid.Row="1" Grid.Column="1" Classes="ghost" Margin="2,0,2,0" Height="36"
                              Command="{Binding SimulateQuantumArrivalCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🌌" FontSize="12" />
                          <TextBlock Text="Quantensprung Ankunft" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- 30k Serverfehler -->
                      <Button Grid.Row="1" Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Height="36"
                              Command="{Binding SimulateServerErrorCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="⚠️" FontSize="12" />
                          <TextBlock Text="30k Serverfehler" FontSize="11.5" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 2. Diagnose, Log-Dump & Overlays -->
                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="⚙  DIAGNOSE, SYSTEMSTATUS &amp; OVERLAYS" />
                    <TextBlock Text="Schreibe den vollständigen internen Zustand (Standort, IsAtStation, Schiffe, OCR, Voice) in die Logdatei oder setze Fensterpositionen zurück." Foreground="#8B949E" FontSize="11" />

                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                      <!-- State Dump -->
                      <Button Grid.Column="0" Classes="accent" Margin="0,0,4,0" Height="36"
                              Command="{Binding DumpStateToLogCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="📋" FontSize="12" />
                          <TextBlock Text="Status in Log dumpen" FontWeight="Bold" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Toast Test -->
                      <Button Grid.Column="1" Classes="ghost" Margin="2,0,2,0" Height="36"
                              Command="{Binding TestAchievementToastCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="✦" FontSize="12" Foreground="#F59E0B" />
                          <TextBlock Text="Achievement Toast Test" FontSize="11.5" />
                        </StackPanel>
                      </Button>

                      <!-- Overlay Coords Reset -->
                      <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Height="36"
                              Command="{Binding ResetOverlayPositionsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="🔄" FontSize="12" />
                          <TextBlock Text="Overlays resetten (50,50)" FontSize="11.5" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

        </TabControl>
      </Grid>
    </TabItem>

    <!-- Tab 7: ℹ Über SCLogMate -->
    <TabItem Header="{Binding I18n[Tab_About]}">
      <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Center">

          <!-- 1. Hero Brand Header (Futuristisches HUD) -->
          <Border Background="#0C1524" BorderBrush="#1C3855" BorderThickness="1" CornerRadius="12" Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- App Icon Badge -->
              <Border Grid.Column="0" Background="#0F2845" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Width="58" Height="58" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="✦" Foreground="#38BDF8" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <!-- App Info -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="SCLogMate" Foreground="#F0F6FC" FontSize="22" FontWeight="Bold" LetterSpacing="0.5" />
                  <Border Background="#0D2238" BorderBrush="#1F5080" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" />
                  </Border>
                  <Border Background="#061810" BorderBrush="#1D6A35" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="LIVE COMPANION" Foreground="#4ADE80" FontSize="10" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Star Citizen Live Log Companion &amp; Telemetrie Suite." Foreground="#8B949E" FontSize="12.5" />
                <TextBlock Text="{Binding RuntimeInfoText}" Foreground="#566270" FontSize="10.5" FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>

              <!-- Quick Links & Actions -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="ghost" Padding="12,6" CornerRadius="6"
                        Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="https://github.com/gOOvER/SCLogMate"
                        ToolTip.Tip="GitHub Repository aufrufen">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🌐" FontSize="11" />
                    <TextBlock Text="GitHub" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Padding="12,6" CornerRadius="6"
                        Command="{Binding OpenChangelogCommand}"
                        ToolTip.Tip="Offizielles Changelog öffnen">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📜" FontSize="11" />
                    <TextBlock Text="Changelog" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 2. Ko-fi Community Support Card -->
          <Border Background="#160E14" BorderBrush="#5E1D2A" BorderThickness="1" CornerRadius="10" Padding="18,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Background="#26121C" BorderBrush="#FF5E5B" BorderThickness="1" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="☕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Unterstütze die Weiterentwicklung" Foreground="#F0F6FC" FontSize="13" FontWeight="Bold" />
                  <Border Background="#3B1218" BorderBrush="#FF5E5B" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="OPEN SOURCE" Foreground="#FF5E5B" FontSize="9.5" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="SCLogMate ist ein freies Community-Projekt für Star Citizen Piloten. Wenn dir das Tool gefällt, spendiere gOOvER gerne einen Kaffee!" Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="accent" Background="#FF5E5B" Padding="14,7" CornerRadius="6" Margin="16,0,0,0" VerticalAlignment="Center"
                      Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="https://ko-fi.com/goover"
                      ToolTip.Tip="https://ko-fi.com/goover öffnen">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="☕" FontSize="12" Foreground="White" />
                  <TextBlock Text="Kaffee spendieren" FontWeight="Bold" FontSize="11.5" Foreground="White" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- 3. Zweispalten-Layout: Updates (Links) & Projekt-Info (Rechts) -->
          <Grid ColumnDefinitions="*,*">
            <!-- Linke Spalte: Version & Updates -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,7,0" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="🔄  VERSION &amp; AUTO-UPDATE" />
                
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,2">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}" Foreground="#F0F6FC" FontWeight="Bold" FontSize="11" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Release-Kanal:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="Offizielle GitHub Releases (v1.*)" Foreground="#8B949E" FontSize="11" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Update-Prüfung:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Automatisch alle 6 Stunden" Foreground="#3FB950" FontSize="11" />
                </Grid>

                <!-- Update Verfügbar Banner -->
                <Border Background="#0D2D20" BorderBrush="#238636" BorderThickness="1" CornerRadius="6" Padding="12,8"
                        IsVisible="{Binding UpdateAvailable}" Margin="0,4,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Neues Update verfügbar!" Foreground="#F0F6FC" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="{Binding UpdateText}" Foreground="#8B949E" FontSize="10.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Background="#238636" Padding="10,5" CornerRadius="4"
                            Command="{Binding UpdateCommand}" Content="{Binding UpdateText}" />
                  </Grid>
                </Border>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                        Command="{Binding CheckForUpdateManualCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔄" FontSize="11" />
                    <TextBlock Text="Jetzt nach Updates suchen" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- Rechte Spalte: Autor, Lizenz & Credits -->
            <Border Grid.Column="1" Classes="card" Margin="7,0,0,0" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="🤝  PROJEKT &amp; DANKSAGUNG" />
                
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,2">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Maintainer:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="gOOvER" Foreground="#F0F6FC" FontWeight="Bold" FontSize="11" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Lizenz:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT (Open Source)" Foreground="#4ADE80" FontSize="11" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Basis-Projekt:" Foreground="#7E97AD" FontSize="11" Margin="0,0,10,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="SCLogMate von miwidot" Foreground="#38BDF8" FontSize="11" />
                </Grid>

                <TextBlock Text="Herzlichen Dank an miwidot für die hervorragende Vorarbeit und das Fundament der Star Citizen Log-Analyse."
                           Foreground="#8B949E" FontSize="10.5" TextWrapping="Wrap" LineHeight="15" Margin="0,2,0,0" />

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                        Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="https://github.com/gOOvER/SCLogMate/issues">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🐞" FontSize="11" />
                    <TextBlock Text="Feedback &amp; Fehler melden" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- 4. Kompakte Diagnose- und Systempfade -->
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="📁  SYSTEM- &amp; DIAGNOSEPFADE" />
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="ghost" Margin="0,0,4,0" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenAppDataFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📂" FontSize="11" />
                    <TextBlock Text="AppData Ordner" FontSize="11" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="1" Classes="ghost" Margin="3,0,3,0" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenDebugLogCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📄" FontSize="11" />
                    <TextBlock Text="Debug-Log ansehen" FontSize="11" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenChangelogCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📜" FontSize="11" />
                    <TextBlock Text="CHANGELOG.md" FontSize="11" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </TabItem>
    </TabControl>

  </DockPanel>

  <!-- Star Citizen Wiki Modal Overlay mit HD-Schiff-/Fahrzeugbild -->
  <Border IsVisible="{Binding IsWikiOverlayOpen}"
          Background="#D903060C"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border Background="#0A1422" BorderBrush="#1C3857" BorderThickness="1"
            CornerRadius="10" Padding="20" Width="720" MaxHeight="660"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 8 32 #B3000000">
      <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <StackPanel Grid.Column="0" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedWikiInfo.Name}" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" />
              <Border Background="#21262D" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedWikiInfo.Category}" FontSize="10" Foreground="#58A6FF" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding SelectedWikiInfo.Manufacturer}" Foreground="#8B949E" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Padding="8,4" Command="{Binding CloseWikiOverlayCommand}">
            <TextBlock Text="✕" FontSize="14" Foreground="#8B949E" />
          </Button>
        </Grid>

        <!-- Footer Buttons -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
          <Button Grid.Column="0" Classes="accent" Command="{Binding OpenWikiWebUrlCommand}" CommandParameter="{Binding SelectedWikiInfo.WebUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="🌐" />
              <TextBlock Text="Im Star Citizen Wiki öffnen (starcitizen.tools)" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseWikiOverlayCommand}" Content="Schließen" Margin="8,0,0,0" />
        </Grid>

        <!-- Loading State or Content -->
        <Panel>
          <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsWikiLoading}" />

          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsWikiLoading}">
            <StackPanel Spacing="12">
              
              <!-- HD-Schiffsfoto / Render -->
              <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Height="220"
                      IsVisible="{Binding WikiImageBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding WikiImageBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <!-- Schnell-Attribute / Badges -->
              <WrapPanel Orientation="Horizontal">
                <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,6"
                        IsVisible="{Binding SelectedWikiInfo.Role, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Rolle:" Foreground="#8B949E" FontSize="11" />
                    <TextBlock Text="{Binding SelectedWikiInfo.Role}" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,6"
                        IsVisible="{Binding SelectedWikiInfo.Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Fokus:" Foreground="#8B949E" FontSize="11" />
                    <TextBlock Text="{Binding SelectedWikiInfo.Type}" Foreground="#F0F6FC" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,6"
                        IsVisible="{Binding SelectedWikiInfo.ProductionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Status:" Foreground="#8B949E" FontSize="11" />
                    <TextBlock Text="{Binding SelectedWikiInfo.ProductionStatus}" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <!-- Deutsche / Englische Beschreibung -->
              <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding SelectedWikiInfo.DescriptionHeader}" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                  <TextBlock Text="{Binding SelectedWikiInfo.BestDescription}" FontSize="12" LineHeight="19" Foreground="#C9D1D9" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </Border>

    <!-- ══ NEUES MODERNES DATENBANK-FORTSCHRITTS-MODAL ══ -->
    <Border Background="#D8070D14" IsVisible="{Binding IsDatabaseBusy}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="999">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
              Background="#0E1624" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12"
              BoxShadow="0 16 48 #80000000" Padding="28,24">
        <StackPanel Spacing="18">
          
          <!-- Header mit pulsierendem Radar-Icon & Titel -->
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Background="#0A2239" BorderBrush="#38BDF8" BorderThickness="1"
                    CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="⚡" FontSize="22" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Star Citizen Datenbank-Indexierung" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" />
              <TextBlock Text="Sessions &amp; Ereignisse werden verarbeitet" FontSize="11" Foreground="#8B949E" />
            </StackPanel>
          </Grid>

          <!-- Aktuelle Datei & Operation -->
          <Border Background="#070D16" BorderBrush="#1C2B3E" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock Text="{Binding DatabaseStatusMessage}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </Border>

          <!-- Große animierte Fortschrittsleiste -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="FORTSCHRITT" FontSize="10" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="0.5" />
              <TextBlock Grid.Column="1" Text="{Binding DatabaseProgressPercent, StringFormat='{}{0:F0}%'}"
                         FontSize="12" FontWeight="Bold" Foreground="#FFB23E" />
            </Grid>
            <ProgressBar Height="8" CornerRadius="4" Background="#162232" Foreground="#38BDF8"
                         Minimum="0" Maximum="100" Value="{Binding DatabaseProgressPercent}" />
          </StackPanel>

          <!-- Info-Hinweisbox -->
          <Border Background="#091422" BorderBrush="#16283D" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="ℹ" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="Logs werden im Hintergrund indexiert. Daten stehen gleich bereit."
                         FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Border>

        </StackPanel>
      </Border>
    </Border>

    <!-- ══ DEDIZIERTES UPDATE-FENSTER MODAL ══ -->
    <Border Background="#E6070D14" IsVisible="{Binding IsUpdateModalOpen}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="580" MaxHeight="640"
              Background="#0E1624" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="12"
              BoxShadow="0 20 60 #90000000" Padding="28,24">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0">
          
          <!-- Header mit Icon, Titel, Versions-Badges & Schließen-Button -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
            <Border Grid.Column="0" Background="#0A2A1A" BorderBrush="#22C55E" BorderThickness="1"
                    CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="Neues SCLogMate Update verfügbar!" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2">
                  <TextBlock Text="{Binding UpdateCurrentVersion, StringFormat='Aktuell: {0}'}" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="➔" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                <Border Background="#0C341E" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2">
                  <TextBlock Text="{Binding UpdateNewVersion, StringFormat='Neu: {0}'}" FontSize="10" Foreground="#4ADE80" FontWeight="Bold" />
                </Border>
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Width="32" Height="32" Padding="0" CornerRadius="6"
                    VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding CloseUpdateModalCommand}" ToolTip.Tip="Schließen (Später erinnern)">
              <TextBlock Text="✕" FontSize="14" Foreground="#8B949E" />
            </Button>
          </Grid>

          <!-- Changelog & Release Notes -->
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,18">
            <TextBlock Text="CHANGELOG &amp; NEUERUNGEN:" FontSize="10.5" FontWeight="Bold" Foreground="#8B949E" LetterSpacing="0.5" />
            <Border Background="#070D16" BorderBrush="#1C2B3E" BorderThickness="1" CornerRadius="8" Padding="14,12" MaxHeight="260">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding UpdateReleaseNotes}" FontSize="12" LineHeight="19" Foreground="#C9D1D9" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>

            <!-- Installations-Status & Spinner -->
            <Border Background="#0A1F14" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,8"
                    IsVisible="{Binding IsInstallingUpdate}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚡" FontSize="14" Foreground="#4ADE80" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Action Buttons -->
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Classes="ghost" Height="36" Padding="14,0" CornerRadius="6"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    Command="{Binding OpenReleaseInBrowserCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="12" />
                <TextBlock Text="Auf GitHub ansehen" FontSize="11.5" Foreground="#F0F6FC" />
              </StackPanel>
            </Button>

            <Button Grid.Column="2" Classes="ghost" Height="36" Padding="14,0" CornerRadius="6" Margin="0,0,10,0"
                    Command="{Binding CloseUpdateModalCommand}" Content="Später erinnern" FontSize="11.5" Foreground="#8B949E" />

            <Button Grid.Column="3" Classes="accent" Height="36" Padding="18,0" CornerRadius="6"
                    Background="#238636" BorderThickness="0"
                    IsEnabled="{Binding !IsInstallingUpdate}"
                    Command="{Binding UpdateCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="13" />
                <TextBlock Text="Jetzt aktualisieren &amp; neu starten" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
              </StackPanel>
            </Button>
          </Grid>

        </Grid>
      </Border>
    </Border>

  </Grid>
</Window>
