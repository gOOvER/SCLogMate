<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SCLogMate.Views.RegionSelectorWindow"
        Title="SCLogMate - Bereich auswählen"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#88000000"
        Cursor="Cross">

  <Grid>
    <!-- 1. Interaktives Canvas für das Auswahlrechteck -->
    <Canvas Name="DrawCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Rectangle Name="SelectRect" Stroke="#38BDF8" StrokeThickness="2"
                 Fill="#3338BDF8" IsVisible="False" />
    </Canvas>

    <!-- 2. Obere Steuerungs- und Hilfsleiste -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Spacing="8" IsHitTestVisible="True">
      <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
              CornerRadius="8" Padding="18,10" BoxShadow="0 4 12 0 #40000000">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="✦ mobiGlas aUEC-Bereich auswählen" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Ziehe mit gedrückter linker Maustaste ein Rechteck um deine aUEC-Anzeige im mobiGlas."
                     Foreground="#8B949E" FontSize="12" HorizontalAlignment="Center" />
          <TextBlock Text="[ESC] Abbrechen  ·  [M] oder [Tab] Monitor wechseln" Foreground="#F87171" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- Großer, prominenter Umschalt-Button zum Wechseln auf Monitor 2 / Spiel-Monitor -->
      <Button Name="NextMonitorBtn" Background="#1F6FEB" BorderBrush="#388BFD" BorderThickness="1"
              CornerRadius="6" Padding="16,8" HorizontalAlignment="Center" Cursor="Hand"
              IsVisible="False" ToolTip.Tip="Overlay auf den anderen Bildschirm verschieben">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🖥" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Name="MonitorLabel" Text="AUF MONITOR 2 WECHSELN" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</Window>
