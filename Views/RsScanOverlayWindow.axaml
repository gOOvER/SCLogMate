<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SCLogMate.ViewModels"
        xmlns:m="using:SCLogMate.Models"
        xmlns:conv="using:SCLogMate.Converters"
        mc:Ignorable="d"
        x:Class="SCLogMate.Views.RsScanOverlayWindow"
        x:DataType="vm:MainViewModel"
        Title="SCLogMate RS Signal Scanner"
        Width="450" Height="192"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual">

  <Window.Resources>
    <conv:FilterActiveConverter x:Key="FilterBg" />
    <conv:AmountToBrushConverter x:Key="AmountBrush" />
    <conv:KindToBrushConverter x:Key="KindBrush" />
    <conv:BoolToActiveBrushConverter x:Key="ActiveBrush" />
    <conv:BoolToGreenRedBrushConverter x:Key="GreenRedBrush" />
    <conv:BoolToGreenRedBgConverter x:Key="GreenRedBg" />
  </Window.Resources>

  <Border Margin="4"
          Background="#F2081120"
          BorderBrush="#0284C7"
          BorderThickness="1.2"
          CornerRadius="9"
          BoxShadow="0 6 24 #B0000000">
    <Grid Margin="10,8" RowDefinitions="Auto,*,Auto">

      <!-- Header: Drag-Griff, Titel, Steuerungsbuttons & Schließen -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Background="Transparent" Cursor="SizeAll"
                    PointerPressed="OnTitlePointerPressed">
          <TextBlock Text="⋮⋮" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" ToolTip.Tip="Klicken &amp; Ziehen zum Verschieben" />
          <TextBlock Text="🛰" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="RS DECODER" FontSize="10.5" Foreground="#38BDF8" FontWeight="Bold" LetterSpacing="0.6" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Steuerung: Box, Bereich, Reset, Auto-Scan & Schließen -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- Scan-Box Rahmen anzeigen/verstecken -->
          <Button Classes="ghost" Padding="5,2" CornerRadius="4"
                  Background="{Binding RsScanBoxButtonBg}"
                  BorderBrush="{Binding RsScanBoxButtonBorder}"
                  BorderThickness="1"
                  Command="{Binding ToggleRsScanBoxCommand}"
                  ToolTip.Tip="Scan-Rahmen (rosa Box) auf dem Bildschirm ein-/ausblenden">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <TextBlock Text="👁" FontSize="9" Foreground="{Binding RsScanBoxButtonFg}" />
              <TextBlock Text="Box" FontSize="9" FontWeight="Bold" Foreground="{Binding RsScanBoxButtonFg}" />
            </StackPanel>
          </Button>

          <!-- Bereich einrichten (Maus ziehen) -->
          <Button Classes="ghost" Padding="5,2" CornerRadius="4"
                  Background="#132337" BorderBrush="#254363" BorderThickness="1"
                  Command="{Binding CalibrateRsScanRegionCommand}"
                  ToolTip.Tip="Scan-Bereich auf dem Bildschirm per Maus aufziehen">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <TextBlock Text="🎯" FontSize="9" Foreground="#38BDF8" />
              <TextBlock Text="Bereich" FontSize="9" FontWeight="SemiBold" Foreground="#E2E8F0" />
            </StackPanel>
          </Button>

          <!-- Reset Standard -->
          <Button Classes="ghost" Padding="5,2" CornerRadius="4"
                  Background="#132337" BorderBrush="#254363" BorderThickness="1"
                  Command="{Binding ResetRsScanRegionCommand}"
                  ToolTip.Tip="Scan-Bereich auf Standard zurücksetzen">
            <TextBlock Text="↺" FontSize="9.5" Foreground="#94A3B8" />
          </Button>

          <!-- Auto-Scan Toggle Button -->
          <Button Classes="ghost" Padding="6,2" CornerRadius="4"
                  Background="{Binding RsAutoScanBadgeBg}"
                  BorderBrush="{Binding RsAutoScanBadgeBorder}"
                  BorderThickness="1"
                  Command="{Binding ToggleRsAutoScanCommand}"
                  ToolTip.Tip="Auto-Scan ein- oder ausschalten (150ms Loop)">
            <TextBlock Text="{Binding RsAutoScanStatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding RsAutoScanBadgeFg}" />
          </Button>

          <!-- Schließen -->
          <Button Classes="ghost" Padding="5,2" CornerRadius="4" Background="#132337" BorderBrush="#254363" BorderThickness="1" Click="OnCloseClicked" ToolTip.Tip="Overlay schließen">
            <TextBlock Text="✕" FontSize="9" Foreground="#94A3B8" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Mitte: Gescannter RS-Wert + Bester Treffer Hero Card -->
      <Border Grid.Row="1" Background="#D00B1728" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,6,0,6">
        <Grid>
          
          <!-- Standby-Ansicht (wenn noch kein Treffer da ist) -->
          <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Grid.Row="0" Text="{Binding CurrentRsDisplayValue}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{Binding RsStandbyText}" FontSize="10.5" Foreground="#8B949E" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </Grid>

          <!-- Aktiver Treffer: 4 saubere Zeilen mit festen Grid-Grenzen (kein Text-Überlauf!) -->
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center"
                IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNotNull}}">
            
            <!-- Zeile 1: Signal & Tier Badge -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="SIGNAL:" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" LetterSpacing="0.5" />
                <TextBlock Text="{Binding CurrentRsDisplayValue}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
              </StackPanel>
              
              <!-- Tier Badge -->
              <Border Grid.Column="1" Background="{Binding BestRsMatch.BadgeColor, FallbackValue='#334155'}" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                <TextBlock Text="{Binding BestRsMatch.Resource.Tier, StringFormat='Tier {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
              </Border>
            </Grid>

            <!-- Zeile 2: Hauptressource / Titel (Groß & Klar auf eigener Zeile) -->
            <TextBlock Grid.Row="1" Margin="0,3,0,0"
                       Text="{Binding BestRsMatch.DisplayTitle}"
                       FontSize="15" FontWeight="Bold" Foreground="#38BDF8"
                       TextTrimming="CharacterEllipsis" />

            <!-- Zeile 3: Untertitel / Seltenheit & Base-RS (Eigene Zeile mit sicherem CharacterEllipsis) -->
            <TextBlock Grid.Row="2" Margin="0,1,0,3"
                       Text="{Binding BestRsMatch.Subtitle}"
                       FontSize="10.5" Foreground="#94A3B8"
                       TextTrimming="CharacterEllipsis" />

            <!-- Zeile 4: Raffinerie & Wert (Säuberlich aufgeteilt in Pills) -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
              <Border Grid.Column="0" Background="#111E33" BorderBrush="#1C3252" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,6,0">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="🏭 " FontSize="9.5" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding BestRsMatch.BestRefineryText}" FontSize="9.5" Foreground="#4ADE80" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Grid.Column="1" Background="#1E1928" BorderBrush="#3D2B54" BorderThickness="1" CornerRadius="4" Padding="6,2.5">
                <TextBlock Text="{Binding BestRsMatch.EstimatedValueText}" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
              </Border>
            </Grid>

          </Grid>

        </Grid>
      </Border>

      <!-- Footer: Sekundäre Treffer Quick-Ticker & 1-Klick Scan -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,1,0,0">
        <Border Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SecondaryRsMatchesText}" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Border>
        <Button Grid.Column="1" Classes="ghost" Padding="6,1.5" CornerRadius="4" Background="#132337" BorderBrush="#254363" BorderThickness="1"
                Command="{Binding TriggerRsOcrScanCommand}" ToolTip.Tip="Jetzt manuellen OCR-Scan ausführen">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="⚡" FontSize="9" Foreground="#38BDF8" />
            <TextBlock Text="Scan" FontSize="9" Foreground="#38BDF8" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </Grid>

    </Grid>
  </Border>
</Window>
