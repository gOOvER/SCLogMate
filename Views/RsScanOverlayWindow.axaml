<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SCLogMate.ViewModels"
        xmlns:m="using:SCLogMate.Models"
        xmlns:conv="using:SCLogMate.Converters"
        mc:Ignorable="d"
        x:Class="SCLogMate.Views.RsScanOverlayWindow"
        x:DataType="vm:MainViewModel"
        Title="SCLogMate RS Signal Scanner"
        Width="330" Height="165"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual">

  <Window.Resources>
    <conv:FilterActiveConverter x:Key="FilterBg" />
    <conv:AmountToBrushConverter x:Key="AmountBrush" />
    <conv:KindToBrushConverter x:Key="KindBrush" />
    <conv:BoolToActiveBrushConverter x:Key="ActiveBrush" />
    <conv:BoolToGreenRedBrushConverter x:Key="GreenRedBrush" />
    <conv:BoolToGreenRedBgConverter x:Key="GreenRedBg" />
  </Window.Resources>

  <Border Margin="4"
          Background="#F0070F1E"
          BorderBrush="#2563EB"
          BorderThickness="1.2"
          CornerRadius="8"
          BoxShadow="0 4 20 #B0000000"
          PointerPressed="OnBorderPointerPressed">
    <Grid Margin="10,8" RowDefinitions="Auto,*,Auto">

      <!-- Header: Drag-Griff, Titel, Auto-Status & Schließen -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="⋮⋮" FontSize="11" Foreground="#475569" VerticalAlignment="Center" ToolTip.Tip="Klicken &amp; Ziehen zum Verschieben" />
          <TextBlock Text="🛰" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="RS DECODER" FontSize="10.5" Foreground="#38BDF8" FontWeight="Bold" LetterSpacing="0.5" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Auto-Scan Pill & Schließen -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Background="{Binding RsAutoScanBadgeBg}" BorderBrush="{Binding RsAutoScanBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding RsAutoScanStatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding RsAutoScanBadgeFg}" />
          </Border>
          <Button Classes="ghost" Padding="4,1" CornerRadius="3" Background="#1E293B" Click="OnCloseClicked" ToolTip.Tip="Overlay schließen">
            <TextBlock Text="✕" FontSize="9" Foreground="#94A3B8" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Mitte: Gescannter RS-Wert + Bester Treffer Hero Card -->
      <Border Grid.Row="1" Background="#0C1829" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,6">
        <Grid>
          
          <!-- Standby-Ansicht (wenn noch kein Treffer da ist) -->
          <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Grid.Row="0" Text="{Binding CurrentRsDisplayValue}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Warte auf Radar-Signal (TAB / V)…" FontSize="10" Foreground="#8B949E" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </Grid>

          <!-- Aktiver Treffer (sauberes 3-Zeilen-Grid ohne Verschiebung) -->
          <Grid RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center"
                IsVisible="{Binding BestRsMatch, Converter={x:Static ObjectConverters.IsNotNull}}">
            
            <!-- Zeile 1: Signal & Tier Badge -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="SIGNAL:" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentRsDisplayValue}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
              </StackPanel>
              <Border Grid.Column="1" Background="{Binding BestRsMatch.BadgeColor, FallbackValue='#334155'}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding BestRsMatch.Resource.Tier, StringFormat='Tier {0}'}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
              </Border>
            </Grid>

            <!-- Zeile 2: Titel & Seltenheit -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding BestRsMatch.DisplayTitle}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding BestRsMatch.Subtitle}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Zeile 3: Raffinerie & Wert -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,3,0,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="🏭" FontSize="9.5" />
                <TextBlock Text="{Binding BestRsMatch.BestRefineryText}" FontSize="9.5" Foreground="#4ADE80" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding BestRsMatch.EstimatedValueText}" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
            </Grid>

          </Grid>

        </Grid>
      </Border>

      <!-- Footer: Sekundäre Treffer Quick-Ticker & 1-Klick Scan -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding SecondaryRsMatchesText}" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Padding="6,1" Command="{Binding TriggerRsOcrScanCommand}" ToolTip.Tip="Jetzt manuellen OCR-Scan ausführen">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="⚡" FontSize="9" Foreground="#38BDF8" />
            <TextBlock Text="Scan" FontSize="9" Foreground="#38BDF8" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </Grid>

    </Grid>
  </Border>
</Window>
