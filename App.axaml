<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCLogMate.App"
             RequestedThemeVariant="Dark">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/SCLogMate.ico" ToolTipText="SCLogMate" Clicked="TrayOpen">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Öffnen" Click="TrayOpen" />
            <NativeMenuItem Header="Beenden" Click="TrayExit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- ══ Sci-Fi Buttons ══ -->
    <Style Selector="Button.accent">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#1D6FA5" />
      <Setter Property="Foreground" Value="#F0F6FC" />
      <Setter Property="BorderBrush" Value="#38BDF8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2589CB" />
      <Setter Property="BorderBrush" Value="#7FE4FF" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0D1624" />
      <Setter Property="Foreground" Value="#C9D6E2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1C324A" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#142338" />
      <Setter Property="BorderBrush" Value="#2F547D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ══ Eingabefelder (mobiGlas Console Style) ══ -->
    <Style Selector="TextBox.path">
      <Setter Property="Background" Value="#060C14" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="BorderBrush" Value="#1A3047" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.path:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#38BDF8" />
      <Setter Property="Background" Value="#08101C" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="#060C16" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="BorderBrush" Value="#1A3047" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="26,4,22,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#38BDF8" />
      <Setter Property="Background" Value="#08101C" />
    </Style>

    <!-- ══ Filter-Chips ══ -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#0A1422" />
      <Setter Property="Foreground" Value="#8EA8BF" />
      <Setter Property="BorderBrush" Value="#182E47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#12243C" />
      <Setter Property="BorderBrush" Value="#38BDF8" />
      <Setter Property="Foreground" Value="#F0F6FC" />
    </Style>

    <!-- ══ TabItems: mobiGlas High-Tech Navigation ══ -->
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="8,5,8,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#7E97AD" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#E2EDF7" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#38BDF8" />
    </Style>
    <Style Selector="TabItem TextBlock">
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <!-- ══ HUD Karten & Panels ══ -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#0B1320" />
      <Setter Property="BorderBrush" Value="#1A3047" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style Selector="Border.card TextBlock.label">
      <Setter Property="Foreground" Value="#6F8AA3" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="Border.card TextBlock.value">
      <Setter Property="Foreground" Value="#F0F6FC" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ══ DataGrid (Cyberpunk / Star Citizen Flight Logger Theme) ══ -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#060B12" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#172B40" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#101D2B" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#0A1422" />
      <Setter Property="Foreground" Value="#6F8AA3" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderBrush" Value="#172B40" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#112236" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Application.Styles>
</Application>
